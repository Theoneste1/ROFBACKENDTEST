# ─────────────────────────────────────────────────────────────────────────────
# Free-tier server configuration. Copy to .env ON THE SERVER and fill in every
# <…>. Never commit .env (it is git- and docker-ignored).
# Generate secrets on the server:
#   openssl rand -hex 24          → POSTGRES_PASSWORD (hex: safe inside a URL)
#   openssl rand -base64 48       → JWT_SECRET
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────
API_DOMAIN=api.lms.<your-domain>           # DNS A record → the server's public IP
ACME_EMAIL=<your-email>                     # Let's Encrypt expiry notices
POSTGRES_PASSWORD=<generate>                # DATABASE_URL is built from it

# ── Application ──────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
DATABASE_POOL_MAX=10
JWT_SECRET=<generate>
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# The frontend. Must be the same site as API_DOMAIN (e.g. lms.<your-domain>),
# because the refresh cookie is SameSite=Strict.
CORS_ORIGINS=https://lms.<your-domain>
APP_URL=https://lms.<your-domain>
APP_TIMEZONE=Africa/Kigali
TRUST_PROXY=1                               # Caddy. Use 2 if Cloudflare's proxy (orange cloud) is on
MAX_UPLOAD_REQUEST_MB=100
THROTTLE_LIMIT=120
THROTTLE_TTL_SECONDS=60
SWAGGER_ENABLED=false
WORKERS_ENABLED=true

# ── Files: Cloudflare R2 ─────────────────────────────────────────────────────
STORAGE_DRIVER=s3
S3_BUCKET=rof-files
S3_REGION=auto
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=<r2-access-key-id>
S3_SECRET_ACCESS_KEY=<r2-secret-access-key>
S3_FORCE_PATH_STYLE=true

# ── Backups (backup.sh): a second R2 bucket, same API token ──────────────────
BACKUP_BUCKET=rof-backups

# ── E-mail ───────────────────────────────────────────────────────────────────
# Brevo:            smtp-relay.brevo.com, 587, login + SMTP key from Brevo
# Google Workspace: smtp.gmail.com, 587, the sending mailbox + an app password
SMTP_HOST=<smtp-host>
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<smtp-user>
SMTP_PASS=<smtp-password>
EMAIL_FROM="ROF Learning <noreply@<your-domain>>"
EMAIL_BATCH_SIZE=50

# ── First start only: the initial administrator ──────────────────────────────
# Log in, change the password, then delete SEED_ADMIN_PASSWORD from this file
# and run `docker compose up -d` again.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=<admin-email>
SEED_ADMIN_PASSWORD=<strong-initial-password>
SEED_DEMO=false
