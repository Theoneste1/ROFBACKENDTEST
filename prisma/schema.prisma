datasource db {
  provider = "postgresql"
}

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

// ═══════════════════════════════════════════════════════════════════════════════
// Enums
// ═══════════════════════════════════════════════════════════════════════════════

enum Role {
  STUDENT
  MENTOR
  ADMIN
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum ActivationPurpose {
  INVITATION
  EMAIL_VERIFICATION
}

/// The two fixed academic divisions.
///   JUNIOR → S1, S2, S3
///   SENIOR → S4, S5, S6
enum DivisionCode {
  JUNIOR
  SENIOR
}

/// Secondary-school grade level. Determines a student's division.
enum GradeLevel {
  S1
  S2
  S3
  S4
  S5
  S6
}

/// Course visibility. ARCHIVED courses are read-only and hidden from students.
enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// Lifecycle of an academic year. Exactly one year is current at a time.
enum AcademicYearStatus {
  PLANNED
  ACTIVE
  CLOSED
}

/// A student's enrolment in one academic year.
///   ACTIVE    – current placement
///   PROMOTED  – moved on to the next grade in a later year
///   GRADUATED – completed S6
///   WITHDRAWN – left the programme
enum StudentEnrollmentStatus {
  ACTIVE
  PROMOTED
  GRADUATED
  WITHDRAWN
}

/**
 * CourseEnrollmentStatus — the student-facing course activity label.
 * UNROLLED  → "Unrolled"   (student has never opened the course)
 * ROLLED    → "Rolled"     (student has opened the course at least once)
 * COMPLETED → "Completed"  (student explicitly checked the completion box)
 * Transitions are one-way only: UNROLLED → ROLLED → COMPLETED.
 */
enum CourseEnrollmentStatus {
  UNROLLED
  ROLLED
  COMPLETED
}

/**
 * ResourceType — the category of a course learning material.
 * BOOK       – Textbook or reference book
 * EBOOK      – Digital-only book / interactive e-book
 * NOTE       – Lecture notes or study notes
 * PAST_PAPER – Past examination paper
 * ATTACHMENT – General course attachment (slides, templates, etc.)
 */
enum ResourceType {
  BOOK
  EBOOK
  NOTE
  PAST_PAPER
  ATTACHMENT
}

/// Assignment workflow: mentors prepare, admins officially publish.
///   DRAFT → PENDING_APPROVAL → PUBLISHED   (or REJECTED → edited → PENDING_APPROVAL)
///   ARCHIVED: closed after its academic year (read-only; results stay visible).
enum AssignmentStatus {
  DRAFT
  PENDING_APPROVAL
  PUBLISHED
  REJECTED
  ARCHIVED
}

/// How submissions were spread across mentors.
enum DistributionStrategy {
  BALANCED
  ROUND_ROBIN
  MANUAL
}

/// State of one mentor review (one row per review cycle).
///   ASSIGNED    – distributed to the mentor
///   IN_PROGRESS – mentor started reviewing
///   MARKED      – score + feedback saved (draft)
///   RETURNED    – mentor returned the completed review to the admins
///   APPROVED    – admin accepted it, ready to publish
///   SENT_BACK   – admin returned it to the mentor for rework
///   PUBLISHED   – result released to the student
///   SUPERSEDED  – replaced by a later cycle (reassignment or reopen)
///   CANCELLED   – the student replaced their work before review started
enum ReviewStatus {
  ASSIGNED
  IN_PROGRESS
  MARKED
  RETURNED
  APPROVED
  SENT_BACK
  PUBLISHED
  SUPERSEDED
  CANCELLED
}

/// Immutable review history entries.
enum ReviewEventType {
  ASSIGNED
  STARTED
  MARKED
  RETURNED
  APPROVED
  SENT_BACK
  PUBLISHED
  REOPENED
  REASSIGNED
  CANCELLED
}

/// Submission / review workflow.
///   SUBMITTED          – student submitted, waiting for distribution
///   ASSIGNED           – admin distributed it to a mentor
///   IN_REVIEW          – mentor is reviewing
///   MARKED             – mentor saved a score + feedback (draft review)
///   SUBMITTED_TO_ADMIN – mentor returned the completed review
///   APPROVED           – admin accepted the review, ready to publish
///   PUBLISHED          – result visible to the student
///   REJECTED           – admin sent the review back to the mentor for rework
enum SubmissionStatus {
  SUBMITTED
  ASSIGNED
  IN_REVIEW
  MARKED
  SUBMITTED_TO_ADMIN
  APPROVED
  PUBLISHED
  REJECTED
}

enum MentorRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

/**
 * CommentStatus — moderation state of a discussion comment.
 * ACTIVE  – visible to all eligible users
 * HIDDEN  – hidden by admin moderation (admin can still see it)
 * DELETED – removed by the author; shown as "[deleted]" to preserve thread structure
 */
enum CommentStatus {
  ACTIVE
  HIDDEN
  DELETED
}

/// Discussion thread state.
///   OPEN     – anyone in scope can reply
///   LOCKED   – readable, no new replies
///   HIDDEN   – removed by moderation (admins only)
///   ARCHIVED – read-only, kept for history
enum ThreadStatus {
  OPEN
  LOCKED
  HIDDEN
  ARCHIVED
}

enum ReportReason {
  SPAM
  ABUSE
  INAPPROPRIATE
  OFF_TOPIC
  ACADEMIC_DISHONESTY
  OTHER
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum ModerationActionType {
  HIDE_COMMENT
  RESTORE_COMMENT
  DELETE_COMMENT
  HIDE_THREAD
  RESTORE_THREAD
  LOCK_THREAD
  UNLOCK_THREAD
  PIN_THREAD
  UNPIN_THREAD
  ARCHIVE_THREAD
  DISMISS_REPORT
}

/// Learning activity recorded for analytics (not security auditing).
enum ActivityType {
  LOGIN
  COURSE_OPENED
  COURSE_COMPLETED
  RESOURCE_VIEWED
  ASSIGNMENT_VIEWED
  SUBMISSION_CREATED
  SUBMISSION_RESUBMITTED
  RESULT_VIEWED
  THREAD_CREATED
  COMMENT_POSTED
  LIVE_SESSION_OPENED
}

enum ReactionType {
  LIKE
  HELPFUL
  CONFUSED
}

/**
 * GroupRole — a role scoped to a single StudyGroup.
 * It has NO connection to the global Role enum and grants no global privileges.
 */
enum GroupRole {
  STUDENT
  MENTOR
}

enum EmailJobStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  PARTIAL_FAILURE
  FAILED
}

enum EmailDeliveryStatus {
  PENDING
  SENT
  FAILED
}

enum LiveSessionProvider {
  ZOOM
  GOOGLE_MEET
  MICROSOFT_TEAMS
  OTHER
}

enum LiveSessionStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
}

/// What a stored file is used for. Drives size/type limits and access rules.
enum FilePurpose {
  ASSIGNMENT_BRIEF
  SUBMISSION
  FEEDBACK
  RESOURCE
}

/// Notification categories. Users may opt out of e-mail per category
/// (except ACCOUNT, which carries security-relevant messages).
enum NotificationCategory {
  ASSIGNMENTS
  SUBMISSIONS
  REVIEWS
  RESULTS
  LIVE_SESSIONS
  RESOURCES
  ACCOUNT
}

// ═══════════════════════════════════════════════════════════════════════════════
// Identity
// ═══════════════════════════════════════════════════════════════════════════════

model User {
  id           String       @id @default(uuid())
  firstName    String
  lastName     String
  username     String       @unique
  email        String       @unique
  passwordHash String?
  provider     AuthProvider @default(LOCAL)
  providerId   String?
  role         Role         @default(STUDENT)

  /// Mentor accounts and (optionally) self-registered students require approval.
  isApproved  Boolean   @default(true)
  /// Suspended accounts cannot log in and lose access immediately.
  isActive    Boolean   @default(true)
  /// Set when the person activates the account (accepts an invitation or
  /// verifies their e-mail). NULL = invited / unverified: cannot log in.
  activatedAt DateTime?
  lastLoginAt DateTime?

  avatarUrl      String?
  /// Cached leaderboard total — always recomputable from published submissions.
  points         Int     @default(0)
  problemsSolved Int     @default(0)

  // ── Student-only fields (NULL for mentors and admins) ──────────────────────
  // Current placement. The authoritative per-year history is StudentEnrollment;
  // these columns mirror the ACTIVE enrolment of the current academic year so
  // every request can scope a student without a join. Both are updated in the
  // same transaction.
  gradeLevel   GradeLevel?
  divisionId   String?
  division     Division?   @relation(fields: [divisionId], references: [id])
  schoolId     String?
  school       School?     @relation(fields: [schoolId], references: [id])
  homeLocation String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignmentsCreated    Assignment[]             @relation("AssignmentCreator")
  assignmentsApproved   Assignment[]             @relation("AssignmentApprover")
  courseEnrollments     CourseEnrollment[]       @relation("CourseEnrollments")
  resourcesUploaded     CourseResource[]         @relation("ResourceUploader")
  resourceViews         ResourceView[]
  comments              Comment[]                @relation("CommentAuthor")
  commentReactions      CommentReaction[]        @relation("CommentReactions")
  studyGroupsCreated    StudyGroup[]             @relation("StudyGroupCreator")
  studyGroupMemberships StudyGroupMember[]       @relation("StudyGroupMemberships")
  emailJobsCreated      EmailJob[]               @relation("EmailJobCreator")
  submissions           Submission[]             @relation("StudentSubmissions")
  submissionRevisions   SubmissionRevision[]
  assignmentViews       AssignmentView[]         @relation("AssignmentViewer")
  auditLogs             AuditLog[]               @relation("AuditActor")
  mentorAssignments     MentorAssignment[]       @relation("MentorAssignmentMentor")
  mentorAssignmentsMade MentorAssignment[]       @relation("MentorAssignmentAssigner")
  liveSessions          LiveSession[]            @relation("LiveSessionHost")
  notifications         Notification[]
  notificationPrefs     NotificationPreference[]
  refreshTokens         RefreshToken[]
  passwordResetTokens   PasswordResetToken[]
  activationTokens      AccountActivationToken[] @relation("ActivationUser")
  invitationsSent       AccountActivationToken[] @relation("ActivationInviter")
  filesUploaded         FileObject[]
  settingsUpdated       SystemSetting[]
  studentEnrollments    StudentEnrollment[]
  reviews               MentorReview[]           @relation("ReviewMentor")
  reviewsAssigned       MentorReview[]           @relation("ReviewAssigner")
  reviewsDecided        MentorReview[]           @relation("ReviewDecider")
  reviewEvents          ReviewEvent[]
  distributionBatches   DistributionBatch[]
  resultReleases        ResultRelease[]
  threadsCreated        DiscussionThread[]
  reportsFiled          ContentReport[]          @relation("ReportReporter")
  reportsResolved       ContentReport[]          @relation("ReportResolver")
  moderationActions     ModerationAction[]
  activityLogs          ActivityLog[]

  @@index([points])
  @@index([role])
  @@index([schoolId])
  @@index([divisionId])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 of the opaque token. The raw token is never stored.
  tokenHash String    @unique
  /// All tokens produced by rotating one login share a family; reuse of a
  /// rotated token revokes the whole family.
  familyId  String
  expiresAt DateTime
  revokedAt DateTime?
  /// Set when this token was exchanged for a new one.
  rotatedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// Single-use link that activates an account.
///   INVITATION         – an admin invited the person; they choose a password.
///   EMAIL_VERIFICATION – a self-registered student confirms their e-mail.
/// Only the SHA-256 of the token is stored. Issuing a new token for a user
/// invalidates the previous unused ones.
model AccountActivationToken {
  id          String            @id @default(uuid())
  userId      String
  user        User              @relation("ActivationUser", fields: [userId], references: [id], onDelete: Cascade)
  purpose     ActivationPurpose
  tokenHash   String            @unique
  expiresAt   DateTime
  usedAt      DateTime?
  revokedAt   DateTime?
  createdById String?
  createdBy   User?             @relation("ActivationInviter", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime          @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// Access-token revocation list (logout). Rows are purged after expiry.
model TokenBlacklist {
  id        String   @id @default(uuid())
  jti       String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

/// Staging table for mentor applications. Approval creates the User.
model MentorRequest {
  id           String              @id @default(uuid())
  firstName    String
  lastName     String
  username     String              @unique
  email        String              @unique
  /// Cleared once the request is decided.
  passwordHash String?
  status       MentorRequestStatus @default(PENDING)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([status])
}

model School {
  id        String   @id @default(uuid())
  /// Normalised to title-case; unique to prevent duplicates.
  name      String   @unique
  location  String
  createdAt DateTime @default(now())

  students    User[]
  enrollments StudentEnrollment[]
}

// ═══════════════════════════════════════════════════════════════════════════════
// Academic structure
// ═══════════════════════════════════════════════════════════════════════════════

/// Exactly two rows (JUNIOR, SENIOR), created by the seed. Admins may edit
/// name/description/isActive but never create or delete divisions.
model Division {
  id          String       @id @default(uuid())
  code        DivisionCode @unique
  name        String
  description String?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  students           User[]
  studentEnrollments StudentEnrollment[]
  mentorAssignments  MentorAssignment[]
  resources          CourseResource[]
  assignments        Assignment[]
  liveSessions       LiveSession[]
  threads            DiscussionThread[]
}

/// A subject area (e.g. Mathematics). The platform launches with Mathematics
/// only; further disciplines are new rows — no schema change needed.
model Discipline {
  id          String   @id @default(uuid())
  /// Stable identifier, e.g. "MATHEMATICS".
  code        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  courses Course[]
}

/// An academic year (e.g. "2026-2027"). Assignments and live sessions belong
/// to a year; closing a year archives its assignments.
model AcademicYear {
  id        String             @id @default(uuid())
  /// Display name, e.g. "2026-2027".
  name      String             @unique
  startsOn  DateTime           @db.Date
  endsOn    DateTime           @db.Date
  status    AcademicYearStatus @default(PLANNED)
  /// TRUE for the single current year, NULL otherwise. The unique index allows
  /// many NULLs but only one TRUE, so the database guarantees one current year.
  isCurrent Boolean?           @unique
  closedAt  DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  enrollments  StudentEnrollment[]
  assignments  Assignment[]
  liveSessions LiveSession[]

  @@index([status])
}

/// A student's placement for one academic year (grade, division, school).
/// History is kept: a new row per year, older rows become PROMOTED/GRADUATED.
model StudentEnrollment {
  id             String                  @id @default(uuid())
  studentId      String
  student        User                    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear            @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  divisionId     String
  division       Division                @relation(fields: [divisionId], references: [id], onDelete: Restrict)
  gradeLevel     GradeLevel
  schoolId       String?
  school         School?                 @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  status         StudentEnrollmentStatus @default(ACTIVE)
  enrolledAt     DateTime                @default(now())
  endedAt        DateTime?

  @@unique([studentId, academicYearId])
  @@index([academicYearId, divisionId, status])
}

/// A course within a discipline (launch: the four Mathematics courses).
/// Content (resources, assignments, live sessions, discussions) is scoped per
/// (course × division). Courses are archived, never deleted.
model Course {
  id           String       @id @default(uuid())
  disciplineId String
  discipline   Discipline   @relation(fields: [disciplineId], references: [id], onDelete: Restrict)
  /// Stable identifier within the discipline, e.g. "ALGEBRA".
  code         String
  title        String
  description  String
  status       CourseStatus @default(PUBLISHED)
  publishedAt  DateTime?
  archivedAt   DateTime?
  sortOrder    Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  assignments       Assignment[]
  enrollments       CourseEnrollment[]
  resources         CourseResource[]
  threads           DiscussionThread[]
  mentorAssignments MentorAssignment[]
  liveSessions      LiveSession[]
  activityLogs      ActivityLog[]

  @@unique([disciplineId, code])
  @@index([status])
}

/// Admin assigns a mentor to a (course × division). This is the mentor's scope
/// for resources, assignments, live sessions, discussions and analytics.
model MentorAssignment {
  id           String   @id @default(uuid())
  mentorId     String
  mentor       User     @relation("MentorAssignmentMentor", fields: [mentorId], references: [id], onDelete: Cascade)
  courseId     String
  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  divisionId   String
  division     Division @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  assignedById String?
  assignedBy   User?    @relation("MentorAssignmentAssigner", fields: [assignedById], references: [id], onDelete: SetNull)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([mentorId, courseId, divisionId])
  @@index([courseId, divisionId])
}

/// Per-student course progress. Created on first open.
model CourseEnrollment {
  id            String                 @id @default(uuid())
  courseId      String
  course        Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  studentId     String
  student       User                   @relation("CourseEnrollments", fields: [studentId], references: [id], onDelete: Cascade)
  status        CourseEnrollmentStatus @default(UNROLLED)
  firstOpenedAt DateTime               @default(now())
  lastOpenedAt  DateTime               @default(now())
  completedAt   DateTime?

  @@unique([courseId, studentId])
  @@index([studentId])
  @@index([status])
}

// ═══════════════════════════════════════════════════════════════════════════════
// Files
// ═══════════════════════════════════════════════════════════════════════════════

/// Metadata for every stored file. The bytes live in the configured storage
/// driver (local disk or S3-compatible) under `storageKey`.
model FileObject {
  id           String      @id @default(uuid())
  storageKey   String      @unique
  purpose      FilePurpose
  originalName String
  /// Detected from file content (magic bytes), not trusted from the client.
  mimeType     String
  size         Int
  sha256       String
  uploadedById String?
  uploadedBy   User?       @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())

  resourceAttachments   ResourceAttachment[]
  assignmentAttachments AssignmentAttachment[]
  submissionAttachments SubmissionAttachment[]
  reviewAttachments     ReviewAttachment[]

  @@index([purpose])
  @@index([createdAt])
}

// ═══════════════════════════════════════════════════════════════════════════════
// Learning content
// ═══════════════════════════════════════════════════════════════════════════════

model CourseResource {
  id           String       @id @default(uuid())
  courseId     String
  course       Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  divisionId   String
  division     Division     @relation(fields: [divisionId], references: [id])
  type         ResourceType
  title        String
  description  String?
  /// Display order within the course (lower = first).
  sortOrder    Int          @default(0)
  isPublished  Boolean      @default(false)
  publishedAt  DateTime?
  /// Archived resources are hidden from students but kept.
  archivedAt   DateTime?
  uploadedById String
  uploadedBy   User         @relation("ResourceUploader", fields: [uploadedById], references: [id])
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  attachments ResourceAttachment[]
  views       ResourceView[]

  @@index([courseId, divisionId, isPublished])
  @@index([sortOrder])
}

/// Files attached to a learning resource (ordered).
model ResourceAttachment {
  id         String         @id @default(uuid())
  resourceId String
  resource   CourseResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  fileId     String
  file       FileObject     @relation(fields: [fileId], references: [id], onDelete: Restrict)
  sortOrder  Int            @default(0)
  createdAt  DateTime       @default(now())

  @@unique([resourceId, fileId])
  @@index([fileId])
}

model ResourceView {
  id            String         @id @default(uuid())
  resourceId    String
  resource      CourseResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  studentId     String
  student       User           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  firstViewedAt DateTime       @default(now())
  lastViewedAt  DateTime       @default(now())
  viewCount     Int            @default(1)

  @@unique([resourceId, studentId])
  @@index([studentId])
}

model LiveSession {
  id             String              @id @default(uuid())
  courseId       String
  course         Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  divisionId     String
  division       Division            @relation(fields: [divisionId], references: [id])
  academicYearId String
  academicYear   AcademicYear        @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  hostId         String
  host           User                @relation("LiveSessionHost", fields: [hostId], references: [id])
  title          String
  description    String?
  startsAt       DateTime
  endsAt         DateTime
  provider       LiveSessionProvider @default(OTHER)
  /// External meeting link (https only). Never exposed to ineligible users.
  meetingUrl     String
  status         LiveSessionStatus   @default(SCHEDULED)
  cancelReason   String?
  /// Set once the "starting soon" reminder has been sent.
  reminderSentAt DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([courseId, divisionId, startsAt])
  @@index([hostId])
  @@index([status, startsAt])
}

// ═══════════════════════════════════════════════════════════════════════════════
// Assessment
// ═══════════════════════════════════════════════════════════════════════════════

model Assignment {
  id           String   @id @default(uuid())
  title        String
  instructions String
  deadline     DateTime
  /// Leaderboard points available. Awarded proportionally to the score.
  points       Int
  maximumMarks Int

  allowResubmission   Boolean @default(false)
  /// 0 = unlimited resubmissions while the deadline has not passed.
  maxResubmissions    Int     @default(0)
  /// When true, first submissions after the deadline are accepted and flagged late.
  allowLateSubmission Boolean @default(false)

  status             AssignmentStatus @default(DRAFT)
  submittedAt        DateTime?
  publishedAt        DateTime?
  rejectedAt         DateTime?
  rejectionNote      String?
  /// Set when the admin publishes results for the whole assignment.
  resultsPublishedAt DateTime?
  /// Set when archived (status ARCHIVED).
  archivedAt         DateTime?

  approvedById String?
  approvedBy   User?   @relation("AssignmentApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  courseId   String
  course     Course   @relation(fields: [courseId], references: [id])
  divisionId String
  division   Division @relation(fields: [divisionId], references: [id])

  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)

  createdById String
  createdBy   User   @relation("AssignmentCreator", fields: [createdById], references: [id])

  attachments         AssignmentAttachment[]
  submissions         Submission[]
  views               AssignmentView[]
  distributionBatches DistributionBatch[]
  resultReleases      ResultRelease[]
  threads             DiscussionThread[]
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  @@index([courseId, divisionId, status])
  @@index([academicYearId, status])
  @@index([deadline])
  @@index([createdById])
  @@index([status])
}

/// Files attached to an assignment brief (ordered).
model AssignmentAttachment {
  id           String     @id @default(uuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  fileId       String
  file         FileObject @relation(fields: [fileId], references: [id], onDelete: Restrict)
  sortOrder    Int        @default(0)
  createdAt    DateTime   @default(now())

  @@unique([assignmentId, fileId])
  @@index([fileId])
}

/// One row per (student, assignment): drives the "New" vs "Opened" status.
model AssignmentView {
  id            String     @id @default(uuid())
  assignmentId  String
  assignment    Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId     String
  student       User       @relation("AssignmentViewer", fields: [studentId], references: [id], onDelete: Cascade)
  firstViewedAt DateTime   @default(now())
  lastViewedAt  DateTime   @default(now())
  viewCount     Int        @default(1)

  @@unique([assignmentId, studentId])
  @@index([studentId])
}

/// A student's work for one assignment (one row per student × assignment).
/// "status" is the overall workflow state used for filtering and the student
/// display status; the academic review itself lives in MentorReview.
model Submission {
  id     String           @id @default(uuid())
  status SubmissionStatus @default(SUBMITTED)

  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  studentId    String
  student      User       @relation("StudentSubmissions", fields: [studentId], references: [id], onDelete: Restrict)

  /// Number of resubmissions made after the first submission.
  revisionCount Int       @default(0)
  /// True when the latest (re)submission arrived after the deadline.
  isLate        Boolean   @default(false)
  submittedAt   DateTime?

  /// The latest review cycle (any status). NULL until distributed.
  currentReviewId   String?        @unique
  currentReview     MentorReview?  @relation("CurrentReview", fields: [currentReviewId], references: [id], onDelete: SetNull)
  /// The review whose result the student sees. NULL until published.
  publishedReviewId String?        @unique
  publishedReview   MentorReview?  @relation("PublishedReview", fields: [publishedReviewId], references: [id], onDelete: SetNull)
  resultReleaseId   String?
  resultRelease     ResultRelease? @relation(fields: [resultReleaseId], references: [id], onDelete: SetNull)

  /// Leaderboard points granted by the published result (0 until then).
  pointsAwarded Int       @default(0)
  publishedAt   DateTime?

  revisions SubmissionRevision[]
  reviews   MentorReview[]       @relation("SubmissionReviews")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([assignmentId, studentId])
  @@index([studentId])
  @@index([assignmentId, status])
  @@index([resultReleaseId])
}

/// Immutable history of every submission attempt (revision 1 = first submission).
model SubmissionRevision {
  id             String     @id @default(uuid())
  submissionId   String
  submission     Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  revisionNumber Int
  note           String?
  isLate         Boolean    @default(false)
  submittedById  String
  submittedBy    User       @relation(fields: [submittedById], references: [id])
  submittedAt    DateTime   @default(now())

  attachments SubmissionAttachment[]

  @@unique([submissionId, revisionNumber])
}

/// Files of one submission attempt (a student may upload several pages).
model SubmissionAttachment {
  id         String             @id @default(uuid())
  revisionId String
  revision   SubmissionRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  fileId     String
  file       FileObject         @relation(fields: [fileId], references: [id], onDelete: Restrict)
  sortOrder  Int                @default(0)
  createdAt  DateTime           @default(now())

  @@unique([revisionId, fileId])
  @@index([fileId])
}

/// One administrator distribution run for an assignment.
model DistributionBatch {
  id            String               @id @default(uuid())
  assignmentId  String
  assignment    Assignment           @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  strategy      DistributionStrategy
  assignedCount Int                  @default(0)
  createdById   String
  createdBy     User                 @relation(fields: [createdById], references: [id])
  createdAt     DateTime             @default(now())

  reviews MentorReview[]

  @@index([assignmentId])
}

/// A mentor's academic review of a submission. A new row (cycle) is created
/// whenever the submission is (re)assigned or a published result is reopened,
/// so earlier reviews remain as history. Only mentors write score and feedback.
model MentorReview {
  id           String       @id @default(uuid())
  submissionId String
  submission   Submission   @relation("SubmissionReviews", fields: [submissionId], references: [id], onDelete: Cascade)
  /// 1, 2, 3 … per submission.
  cycle        Int
  mentorId     String
  mentor       User         @relation("ReviewMentor", fields: [mentorId], references: [id], onDelete: Restrict)
  status       ReviewStatus @default(ASSIGNED)

  // ── Formal academic review (mentor) ────────────────────────────────────────
  score      Int?
  percentage Float?
  feedback   String?

  // ── Distribution ───────────────────────────────────────────────────────────
  assignedAt          DateTime           @default(now())
  assignedById        String?
  assignedBy          User?              @relation("ReviewAssigner", fields: [assignedById], references: [id], onDelete: SetNull)
  distributionBatchId String?
  distributionBatch   DistributionBatch? @relation(fields: [distributionBatchId], references: [id], onDelete: SetNull)

  // ── Progress ───────────────────────────────────────────────────────────────
  startedAt  DateTime?
  markedAt   DateTime?
  returnedAt DateTime?

  // ── Administrator coordination (never academic feedback) ──────────────────
  decidedAt        DateTime?
  decidedById      String?
  decidedBy        User?     @relation("ReviewDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  /// Why the admin sent the review back (visible to the mentor).
  decisionNote     String?
  /// Internal note; never shown to students or mentors.
  coordinationNote String?
  publishedAt      DateTime?

  attachments  ReviewAttachment[]
  events       ReviewEvent[]
  currentFor   Submission?        @relation("CurrentReview")
  publishedFor Submission?        @relation("PublishedReview")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([submissionId, cycle])
  @@index([mentorId, status])
  @@index([distributionBatchId])
}

/// Feedback files attached by the mentor to a review.
model ReviewAttachment {
  id        String       @id @default(uuid())
  reviewId  String
  review    MentorReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  fileId    String
  file      FileObject   @relation(fields: [fileId], references: [id], onDelete: Restrict)
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now())

  @@unique([reviewId, fileId])
  @@index([fileId])
}

/// Append-only history of a review: who did what, when, with which score.
model ReviewEvent {
  id        String          @id @default(uuid())
  reviewId  String
  review    MentorReview    @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  type      ReviewEventType
  actorId   String?
  actor     User?           @relation(fields: [actorId], references: [id], onDelete: SetNull)
  score     Int?
  note      String?
  createdAt DateTime        @default(now())

  @@index([reviewId, createdAt])
}

/// One administrator release of results for an assignment.
model ResultRelease {
  id            String     @id @default(uuid())
  assignmentId  String
  assignment    Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  publishedById String
  publishedBy   User       @relation(fields: [publishedById], references: [id])
  resultCount   Int
  note          String?
  publishedAt   DateTime   @default(now())

  submissions Submission[]

  @@index([assignmentId])
}

// ═══════════════════════════════════════════════════════════════════════════════
// Discussions
// ═══════════════════════════════════════════════════════════════════════════════

/// A discussion topic. Course threads are per (course × division);
/// assignment threads belong to one assignment (and inherit its division).
/// Exactly one of courseId / assignmentId is set (CHECK constraint).
model DiscussionThread {
  id             String       @id @default(uuid())
  courseId       String?
  course         Course?      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  assignmentId   String?
  assignment     Assignment?  @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  divisionId     String
  division       Division     @relation(fields: [divisionId], references: [id], onDelete: Restrict)
  title          String
  status         ThreadStatus @default(OPEN)
  isPinned       Boolean      @default(false)
  createdById    String
  createdBy      User         @relation(fields: [createdById], references: [id], onDelete: Restrict)
  /// Updated whenever a comment is posted; drives "most recent" ordering.
  lastActivityAt DateTime     @default(now())
  archivedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  comments          Comment[]
  reports           ContentReport[]
  moderationActions ModerationAction[]

  @@index([courseId, divisionId, status, lastActivityAt])
  @@index([assignmentId, status])
  @@index([createdById])
}

/// A message in a thread. Replies set parentId (one level of nesting).
model Comment {
  id       String           @id @default(uuid())
  threadId String
  thread   DiscussionThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  content  String
  status   CommentStatus    @default(ACTIVE)

  /// Null for top-level comments; set for replies.
  parentId String?
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies  Comment[] @relation("CommentReplies")

  authorId String
  author   User      @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  editedAt DateTime?

  reactions         CommentReaction[]
  reports           ContentReport[]
  moderationActions ModerationAction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([threadId, parentId, createdAt])
  @@index([authorId])
  @@index([parentId])
  @@index([status])
}

/// A user's report of a thread or comment for moderation. Exactly one of
/// threadId / commentId is set (CHECK constraint). One report per user per item.
model ContentReport {
  id             String            @id @default(uuid())
  reporterId     String
  reporter       User              @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  threadId       String?
  thread         DiscussionThread? @relation(fields: [threadId], references: [id], onDelete: Cascade)
  commentId      String?
  comment        Comment?          @relation(fields: [commentId], references: [id], onDelete: Cascade)
  reason         ReportReason
  details        String?
  status         ReportStatus      @default(OPEN)
  resolvedAt     DateTime?
  resolvedById   String?
  resolvedBy     User?             @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolutionNote String?
  createdAt      DateTime          @default(now())

  moderationActions ModerationAction[]

  @@unique([reporterId, threadId])
  @@unique([reporterId, commentId])
  @@index([status, createdAt])
  @@index([commentId])
  @@index([threadId])
}

/// Append-only log of every moderation decision (who, what, why).
model ModerationAction {
  id          String               @id @default(uuid())
  moderatorId String
  moderator   User                 @relation(fields: [moderatorId], references: [id], onDelete: Restrict)
  action      ModerationActionType
  threadId    String?
  thread      DiscussionThread?    @relation(fields: [threadId], references: [id], onDelete: SetNull)
  commentId   String?
  comment     Comment?             @relation(fields: [commentId], references: [id], onDelete: SetNull)
  reportId    String?
  report      ContentReport?       @relation(fields: [reportId], references: [id], onDelete: SetNull)
  reason      String?
  createdAt   DateTime             @default(now())

  @@index([commentId])
  @@index([threadId])
  @@index([moderatorId, createdAt])
}

model CommentReaction {
  id        String       @id @default(uuid())
  commentId String
  comment   Comment      @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation("CommentReactions", fields: [userId], references: [id], onDelete: Cascade)
  type      ReactionType
  createdAt DateTime     @default(now())

  @@unique([commentId, userId, type])
  @@index([userId])
}

// ═══════════════════════════════════════════════════════════════════════════════
// Study groups (admin-managed cohorts)
// ═══════════════════════════════════════════════════════════════════════════════

model StudyGroup {
  id          String  @id @default(uuid())
  name        String
  description String
  tags        String?
  isActive    Boolean @default(true)

  createdById String
  createdBy   User   @relation("StudyGroupCreator", fields: [createdById], references: [id])

  members StudyGroupMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([createdById])
}

model StudyGroupMember {
  id          String     @id @default(uuid())
  groupId     String
  group       StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId      String
  user        User       @relation("StudyGroupMemberships", fields: [userId], references: [id], onDelete: Cascade)
  /// Role within this group only — does not affect global authorization.
  groupRole   GroupRole  @default(STUDENT)
  joinedAt    DateTime   @default(now())
  removedAt   DateTime?
  removedById String?

  @@unique([groupId, userId])
  @@index([userId])
}

// ═══════════════════════════════════════════════════════════════════════════════
// Notifications & e-mail
// ═══════════════════════════════════════════════════════════════════════════════

model Notification {
  id        String               @id @default(uuid())
  userId    String
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  NotificationCategory
  /// Machine-readable event type, e.g. "assignment.published".
  type      String
  title     String
  body      String
  /// Ids the frontend needs to deep-link (assignmentId, submissionId, …).
  data      Json?
  readAt    DateTime?
  createdAt DateTime             @default(now())

  @@index([userId, readAt])
  @@index([createdAt])
}

model NotificationPreference {
  id           String               @id @default(uuid())
  userId       String
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  category     NotificationCategory
  emailEnabled Boolean              @default(true)
  updatedAt    DateTime             @updatedAt

  @@unique([userId, category])
}

/// One per admin bulk-send request.
model EmailJob {
  id              String         @id @default(uuid())
  /// Caller-supplied key; re-submitting the same key is a safe no-op.
  idempotencyKey  String         @unique
  subject         String
  /// Stored to allow retry. Never written to audit logs.
  body            String
  status          EmailJobStatus @default(PENDING)
  totalRecipients Int
  sentCount       Int            @default(0)
  failedCount     Int            @default(0)
  createdById     String
  createdBy       User           @relation("EmailJobCreator", fields: [createdById], references: [id])
  completedAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  deliveries EmailDelivery[]

  @@index([createdById])
  @@index([status])
}

/// Outbox for every outgoing e-mail (bulk-job recipients and transactional
/// notifications). A background worker claims PENDING rows with
/// FOR UPDATE SKIP LOCKED, so it is safe with several API instances.
model EmailDelivery {
  id             String              @id @default(uuid())
  /// Set for bulk-job deliveries; null for transactional e-mails.
  jobId          String?
  job            EmailJob?           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  recipientEmail String
  recipientId    String?
  /// Transactional e-mails carry their own subject/body; bulk deliveries use the job's.
  subject        String?
  body           String?
  status         EmailDeliveryStatus @default(PENDING)
  attempts       Int                 @default(0)
  nextAttemptAt  DateTime            @default(now())
  lockedAt       DateTime?
  messageId      String?
  errorMessage   String?
  attemptedAt    DateTime?
  createdAt      DateTime            @default(now())

  @@index([status, nextAttemptAt])
  @@index([jobId, status])
  @@index([recipientEmail])
}

// ═══════════════════════════════════════════════════════════════════════════════
// Administration
// ═══════════════════════════════════════════════════════════════════════════════

/// Key/value system settings. Keys are restricted to an allow-list in code.
model SystemSetting {
  key         String   @id
  value       Json
  updatedById String?
  updatedBy   User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  actorRole String?
  actor     User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([entity, entityId])
  @@index([createdAt])
}

/// Learning activity (what students and mentors do), used for analytics and
/// engagement reports. Security-relevant changes go to AuditLog instead.
/// Retention: rows older than 400 days are purged nightly.
model ActivityLog {
  id         String       @id @default(uuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       ActivityType
  courseId   String?
  course     Course?      @relation(fields: [courseId], references: [id], onDelete: SetNull)
  entityType String?
  entityId   String?
  metadata   Json?
  createdAt  DateTime     @default(now())

  @@index([userId, createdAt])
  @@index([courseId, type, createdAt])
  @@index([type, createdAt])
}
