datasource db {
  provider = "postgresql"
}

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

// ═══════════════════════════════════════════════════════════════════════════════
// Enums
// ═══════════════════════════════════════════════════════════════════════════════

/// Account states (2026-11-16). isActive is kept equal to (accountStatus = ACTIVE) by the database trigger
/// user_account_status_sync, so every existing check on isActive (login, refresh, JWT guard, the M4 last-Super-Admin
/// trigger, the Super Admin boundary) applies to every blocked state. Transitions: docs/operations/account-states.md.
enum AccountStatus {
  ACTIVE
  DEACTIVATED
  SUSPENDED
  ARCHIVED
}

/// A bulk operation's state (2026-11-17). PENDING → RUNNING → COMPLETED / COMPLETED_WITH_FAILURES / FAILED; a cancel
/// makes it CANCELLING while claimed items finish, then CANCELLED.
enum BulkOperationStatus {
  PENDING
  RUNNING
  CANCELLING
  COMPLETED
  COMPLETED_WITH_FAILURES
  FAILED
  CANCELLED
}

/// One user's result in a bulk operation. PROCESSING = claimed by a worker (claimToken); it always ends truthfully.
enum BulkItemOutcome {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  SKIPPED
}

enum Role {
  STUDENT
  MENTOR
  ADMIN
  // Phase 1 (M1). Not assignable until enabled: TEACHER / HEAD_COACH behind
  // TEACHERS_ENABLED / HEAD_COACHES_ENABLED; SUPER_ADMIN only by the approved
  // bootstrap, never through the user API.
  TEACHER
  HEAD_COACH
  SUPER_ADMIN
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum ActivationPurpose {
  INVITATION
  EMAIL_VERIFICATION
}

/// The two fixed academic divisions.
///   JUNIOR → S1, S2, S3
///   SENIOR → S4, S5, S6
enum DivisionCode {
  JUNIOR
  SENIOR
}

/// Secondary-school grade level. Determines a student's division.
enum GradeLevel {
  S1
  S2
  S3
  S4
  S5
  S6
}

/// Course visibility. ARCHIVED courses are read-only and hidden from students.
enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// Lifecycle of an academic year. Exactly one year is current at a time.
enum AcademicYearStatus {
  PLANNED
  ACTIVE
  CLOSED
}

/// A student's enrolment in one academic year.
///   ACTIVE    – current placement
///   PROMOTED  – moved on to the next grade in a later year
///   GRADUATED – completed S6
///   WITHDRAWN – left the programme
enum StudentEnrollmentStatus {
  ACTIVE
  PROMOTED
  GRADUATED
  WITHDRAWN
}

/**
 * CourseEnrollmentStatus — the student-facing course activity label.
 * UNROLLED  → "Unrolled"   (student has never opened the course)
 * ROLLED    → "Rolled"     (student has opened the course at least once)
 * COMPLETED → "Completed"  (student explicitly checked the completion box)
 * Transitions are one-way only: UNROLLED → ROLLED → COMPLETED.
 */
enum CourseEnrollmentStatus {
  UNROLLED
  ROLLED
  COMPLETED
}

/**
 * ResourceType — the category of a course learning material.
 * BOOK       – Textbook or reference book
 * EBOOK      – Digital-only book / interactive e-book
 * NOTE       – Lecture notes or study notes
 * PAST_PAPER – Past examination paper
 * ATTACHMENT – General course attachment (slides, templates, etc.)
 */
enum ResourceType {
  BOOK
  EBOOK
  NOTE
  PAST_PAPER
  ATTACHMENT
}

/// Assignment workflow: mentors prepare, admins officially publish.
///   DRAFT → PENDING_APPROVAL → PUBLISHED   (or REJECTED → edited → PENDING_APPROVAL)
///   PUBLISHED → CLOSED (deadline passed, or admin closes; admin may reopen)
///   ARCHIVED: retired, e.g. when its academic year closes (read-only; results stay visible).
enum AssignmentStatus {
  DRAFT
  PENDING_APPROVAL
  PUBLISHED
  REJECTED
  ARCHIVED
  /// Published but no longer accepting submissions (deadline passed or closed
  /// by an admin). Students still see it, their work and their results.
  CLOSED
}

/// What happened to an assignment (its history).
enum AssignmentEventType {
  CREATED
  UPDATED
  ATTACHMENT_ADDED
  ATTACHMENT_REMOVED
  SUBMITTED_FOR_REVIEW
  RECALLED
  PUBLISHED
  REJECTED
  UNPUBLISHED
  CLOSED
  REOPENED
  ARCHIVED
}

/// How submissions were spread across mentors.
enum DistributionStrategy {
  BALANCED
  ROUND_ROBIN
  MANUAL
}

/// State of one mentor review (one row per review cycle).
///   ASSIGNED    – distributed to the mentor
///   IN_PROGRESS – mentor started reviewing
///   MARKED      – score + feedback saved (draft)
///   RETURNED    – mentor returned the completed review to the admins
///   APPROVED    – admin accepted it, ready to publish
///   SENT_BACK   – admin returned it to the mentor for rework
///   PUBLISHED   – result released to the student
///   SUPERSEDED  – replaced by a later cycle (reassignment or reopen)
///   CANCELLED   – the student replaced their work before review started
enum ReviewStatus {
  ASSIGNED
  IN_PROGRESS
  MARKED
  RETURNED
  APPROVED
  SENT_BACK
  PUBLISHED
  SUPERSEDED
  CANCELLED
  /// The mentor asked the student to redo the work; the cycle ends here and
  /// the resubmission starts a new one.
  RESUBMISSION_REQUESTED
}

/// Immutable review history entries.
enum ReviewEventType {
  ASSIGNED
  STARTED
  MARKED
  RETURNED
  APPROVED
  SENT_BACK
  PUBLISHED
  REOPENED
  REASSIGNED
  CANCELLED
  RESUBMISSION_REQUESTED
  RESUBMISSION_REQUEST_WITHDRAWN
}

/// Submission / review workflow.
///   SUBMITTED          – student submitted, waiting for distribution
///   ASSIGNED           – admin distributed it to a mentor
///   IN_REVIEW          – mentor is reviewing
///   MARKED             – mentor saved a score + feedback (draft review)
///   SUBMITTED_TO_ADMIN – mentor returned the completed review
///   APPROVED           – admin accepted the review, ready to publish
///   PUBLISHED          – result visible to the student
///   REJECTED           – admin sent the review back to the mentor for rework
///   RESUBMISSION_REQUESTED – mentor asked the student for a new attempt
enum SubmissionStatus {
  SUBMITTED
  ASSIGNED
  IN_REVIEW
  MARKED
  SUBMITTED_TO_ADMIN
  APPROVED
  PUBLISHED
  REJECTED
  /// The mentor asked for a new attempt; the student may resubmit until
  /// Submission.resubmissionDueAt (even after the assignment deadline).
  RESUBMISSION_REQUESTED
}

enum MentorRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Teacher self-registration: an application reviewed by an Administrator.
enum TeacherApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

/// The olympiads a Teacher applicant or a student is interested in (an interest only: no Discipline row).
enum OlympiadSubject {
  MATHEMATICS
  COMPUTING
  PHYSICS
}

/// Highest education level a coach applicant reports (capability coachApplicationDetails).
/// Gender asked at every sign-up (owner, 2026-11-20). NULL on accounts created before it.
enum Gender {
  FEMALE
  MALE
}

enum CoachEducationLevel {
  SECONDARY
  DIPLOMA
  BACHELOR
  MASTER
  DOCTORATE
  OTHER
}

/**
 * CommentStatus — moderation state of a discussion comment.
 * ACTIVE  – visible to all eligible users
 * HIDDEN  – hidden by admin moderation (admin can still see it)
 * DELETED – removed by the author; shown as "[deleted]" to preserve thread structure
 */
enum CommentStatus {
  ACTIVE
  HIDDEN
  DELETED
}

/// Discussion thread state.
///   OPEN     – anyone in scope can reply
///   LOCKED   – readable, no new replies
///   HIDDEN   – removed by moderation (admins only)
///   ARCHIVED – read-only, kept for history
enum ThreadStatus {
  OPEN
  LOCKED
  HIDDEN
  ARCHIVED
  /// Removed by its author or an administrator; kept for the moderation record.
  DELETED
}

enum ReportReason {
  SPAM
  ABUSE
  INAPPROPRIATE
  OFF_TOPIC
  ACADEMIC_DISHONESTY
  OTHER
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum ModerationActionType {
  HIDE_COMMENT
  RESTORE_COMMENT
  DELETE_COMMENT
  HIDE_THREAD
  RESTORE_THREAD
  LOCK_THREAD
  UNLOCK_THREAD
  PIN_THREAD
  UNPIN_THREAD
  ARCHIVE_THREAD
  DISMISS_REPORT
  DELETE_THREAD
}

/// Learning activity recorded for analytics (not security auditing).
enum ActivityType {
  LOGIN
  COURSE_OPENED
  COURSE_COMPLETED
  RESOURCE_VIEWED
  ASSIGNMENT_VIEWED
  SUBMISSION_CREATED
  SUBMISSION_RESUBMITTED
  RESULT_VIEWED
  THREAD_CREATED
  COMMENT_POSTED
}

enum ReactionType {
  LIKE
  HELPFUL
  CONFUSED
}

/**
 * GroupRole — a role scoped to a single StudyGroup.
 * It has NO connection to the global Role enum and grants no global privileges.
 */
enum GroupRole {
  STUDENT
  MENTOR
}

enum EmailJobStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  PARTIAL_FAILURE
  FAILED
}

/// Delivery state of a decision notification (NotificationOutbox).
enum NotificationOutboxStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

enum EmailDeliveryStatus {
  PENDING
  SENT
  FAILED
}

/// What a stored file is used for. Drives size/type limits and access rules.
enum FilePurpose {
  ASSIGNMENT_BRIEF
  SUBMISSION
  FEEDBACK
  RESOURCE
  /// A user's profile picture (JPEG, PNG or WebP, at most 2 MB).
  AVATAR
  /// Test Management (WS3): a test's question paper (PDF or images, at most 20 MB; private).
  TEST_PAPER
  /// Test Management (WS3, used from Phase 2): a student's answer pages (PDF or images incl. phone photos, at most 20 MB; private).
  TEST_ANSWER
  /// Test Management (WS3): a test's marking guide / answer key (PDF or images, at most 20 MB; private: only
  /// Administrators, the subject's Head Coaches and, from Phase 3, its authorised markers).
  MARKING_GUIDE
}

/// Notification categories. Users may opt out of e-mail per category
/// (except ACCOUNT, which carries security-relevant messages).
enum NotificationCategory {
  ASSIGNMENTS
  SUBMISSIONS
  REVIEWS
  RESULTS
  RESOURCES
  ACCOUNT
  DISCUSSIONS
}

// ═══════════════════════════════════════════════════════════════════════════════
// Identity
// ═══════════════════════════════════════════════════════════════════════════════

model User {
  resubmissionsAuthorized TestResubmissionAuthorization[] @relation("ResubmissionAuthorizedBy")
  resubmissionsCancelled  TestResubmissionAuthorization[] @relation("ResubmissionCancelledBy")
  id                      String                          @id @default(uuid())
  firstName               String
  lastName                String
  username                String                          @unique
  email                   String                          @unique
  passwordHash            String?
  provider                AuthProvider                    @default(LOCAL)
  providerId              String?
  role                    Role                            @default(STUDENT)

  /// Mentor accounts and (optionally) self-registered students require approval.
  isApproved       Boolean       @default(true)
  /// Suspended accounts cannot log in and lose access immediately.
  isActive         Boolean       @default(true)
  accountStatus    AccountStatus @default(ACTIVE)
  /// Set when the person activates the account (accepts an invitation or
  /// verifies their e-mail). NULL = invited / unverified: cannot log in.
  activatedAt      DateTime?
  lastLoginAt      DateTime?
  /// Consecutive failed logins; reset on success. Five in a row lock the
  /// account for 15 minutes (lockedUntil), whatever IP they come from.
  failedLoginCount Int           @default(0)
  lockedUntil      DateTime?
  /// Access tokens issued before this moment are rejected (set on password
  /// change/reset, sign-out everywhere, suspension and role change).
  tokensValidAfter DateTime?

  avatarUrl      String?
  /// The stored profile picture (FilePurpose AVATAR); avatarUrl points to GET /api/v1/users/{id}/avatar?v={this id}.
  avatarFileId   String?     @unique
  avatarFile     FileObject? @relation("UserAvatar", fields: [avatarFileId], references: [id], onDelete: SetNull)
  /// Cached leaderboard total — always recomputable from published submissions.
  points         Int         @default(0)
  problemsSolved Int         @default(0)

  // ── Student-only fields (NULL for mentors and admins) ──────────────────────
  // Current placement. The authoritative per-year history is StudentEnrollment;
  // these columns mirror the ACTIVE enrolment of the current academic year so
  // every request can scope a student without a join. Both are updated in the
  // same transaction.
  gradeLevel            GradeLevel?
  divisionId            String?
  division              Division?             @relation(fields: [divisionId], references: [id])
  /// Students: the Olympiad level (owner 2026-11-21) — kept in step with gradeLevel by the trigger
  /// `olympiad_level_from_grade` while olympiadLevelManual is false; never touched by it once set by hand.
  olympiadLevel         OlympiadLevel?
  olympiadLevelManual   Boolean               @default(false)
  olympiadLevelChanges  OlympiadLevelChange[] @relation("OlympiadLevelChangeStudent")
  olympiadLevelsChanged OlympiadLevelChange[] @relation("OlympiadLevelChangeActor")
  schoolId              String?
  school                School?               @relation(fields: [schoolId], references: [id])
  homeLocation          String?

  /// Contact phone (E.164) and country (ISO 3166-1 alpha-2) — set when a Teacher application is
  /// approved (teacher self-registration); NULL for every other account.
  phone   String?
  country String?

  /// Olympiad subjects the student is interested in (owner decision 8): any of MATHEMATICS, COMPUTING and
  /// PHYSICS, chosen at registration and editable on the profile. Information only: never grants
  /// programme membership or permissions. Empty for accounts that never chose (older clients, staff).
  olympiadInterests     OlympiadSubject[] @default([])
  /// Another Olympiad named in words ("Other"; owner 2026-11-21), 2–100 characters (CHECK). Never a subject.
  olympiadInterestOther String?

  /// Student registration details (capability studentRegistrationDetails); NULL for older accounts and
  /// for staff. `country` above is the student's own country; the school's country is on the claim.
  /// Date of birth (date only), a close-family phone (E.164) and the official home place (Rwanda only;
  /// homeLocation keeps "Sector, District" for existing displays). Never written to audit metadata.
  dateOfBirth   DateTime? @db.Date
  /// Asked at every sign-up (student, teacher, coach) since 2026-11-20; NULL for older accounts and staff.
  gender        Gender?
  guardianPhone String?
  homeProvince  String?
  homeDistrict  String?
  homeSector    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignmentsCreated                Assignment[]                    @relation("AssignmentCreator")
  assignmentsApproved               Assignment[]                    @relation("AssignmentApprover")
  assignmentEvents                  AssignmentEvent[]
  courseEnrollments                 CourseEnrollment[]              @relation("CourseEnrollments")
  resourcesUploaded                 CourseResource[]                @relation("ResourceUploader")
  resourceViews                     ResourceView[]
  comments                          Comment[]                       @relation("CommentAuthor")
  commentReactions                  CommentReaction[]               @relation("CommentReactions")
  studyGroupsCreated                StudyGroup[]                    @relation("StudyGroupCreator")
  studyGroupMemberships             StudyGroupMember[]              @relation("StudyGroupMemberships")
  emailJobsCreated                  EmailJob[]                      @relation("EmailJobCreator")
  submissions                       Submission[]                    @relation("StudentSubmissions")
  submissionRevisions               SubmissionRevision[]
  assignmentViews                   AssignmentView[]                @relation("AssignmentViewer")
  auditLogs                         AuditLog[]                      @relation("AuditActor")
  mentorAssignments                 MentorAssignment[]              @relation("MentorAssignmentMentor")
  mentorAssignmentsMade             MentorAssignment[]              @relation("MentorAssignmentAssigner")
  programmeMemberships              ProgrammeMembership[]           @relation("ProgrammeMember")
  programmeMembershipsAdded         ProgrammeMembership[]           @relation("ProgrammeMemberAddedBy")
  programmeMembershipsEnded         ProgrammeMembership[]           @relation("ProgrammeMemberEndedBy")
  permissionOverrides               UserPermissionOverride[]        @relation("OverrideTarget")
  permissionOverridesCreated        UserPermissionOverride[]        @relation("OverrideCreatedBy")
  permissionOverridesRevoked        UserPermissionOverride[]        @relation("OverrideRevokedBy")
  teacherSchools                    TeacherSchoolAssignment[]       @relation("TeacherSchool")
  teacherStudentsAsTeacher          TeacherStudentAssignment[]      @relation("TeacherStudentTeacher")
  teacherStudentsAsStudent          TeacherStudentAssignment[]      @relation("TeacherStudentStudent")
  teacherStudentsAssigned           TeacherStudentAssignment[]      @relation("TeacherStudentAssignedBy")
  teacherStudentsEnded              TeacherStudentAssignment[]      @relation("TeacherStudentEndedBy")
  delegationSelections              UserPermissionOverrideStudent[] @relation("OverrideSelectedStudent")
  delegationSelectionsAdded         UserPermissionOverrideStudent[] @relation("OverrideStudentAddedBy")
  delegationSelectionsRemoved       UserPermissionOverrideStudent[] @relation("OverrideStudentRemovedBy")
  teacherSchoolsAssigned            TeacherSchoolAssignment[]       @relation("TeacherSchoolAssignedBy")
  teacherSchoolsEnded               TeacherSchoolAssignment[]       @relation("TeacherSchoolEndedBy")
  schoolAffiliations                StudentSchoolAffiliation[]      @relation("AffiliationStudent")
  affiliationsCreated               StudentSchoolAffiliation[]      @relation("AffiliationCreatedBy")
  affiliationsDecided               StudentSchoolAffiliation[]      @relation("AffiliationDecidedBy")
  affiliationsRevoked               StudentSchoolAffiliation[]      @relation("AffiliationRevokedBy")
  affiliationsSuperseded            StudentSchoolAffiliation[]      @relation("AffiliationSupersededBy")
  schoolsCreated                    School[]                        @relation("SchoolCreatedBy")
  schoolsVerified                   School[]                        @relation("SchoolVerifiedBy")
  schoolContactsVerified            SchoolContact[]                 @relation("SchoolContactVerifiedBy")
  schoolContactsRemoved             SchoolContact[]                 @relation("SchoolContactRemovedBy")
  schoolSyncRunsCreated             SchoolSyncRun[]                 @relation("SchoolSyncRunCreatedBy")
  schoolSyncRunsApplied             SchoolSyncRun[]                 @relation("SchoolSyncRunAppliedBy")
  schoolSyncRunsApproved            SchoolSyncRun[]                 @relation("SchoolSyncRunApprovedBy")
  schoolSyncProposals               SchoolSyncItem[]                @relation("SchoolSyncItemProposedBy")
  schoolSyncResolutions             SchoolSyncItem[]                @relation("SchoolSyncItemResolvedBy")
  schoolSyncDecisions               SchoolSyncChange[]              @relation("SchoolSyncChangeDecidedBy")
  notifications                     Notification[]
  notificationPrefs                 NotificationPreference[]
  notificationSettings              NotificationSetting[]
  refreshTokens                     RefreshToken[]
  passwordResetTokens               PasswordResetToken[]
  activationTokens                  AccountActivationToken[]        @relation("ActivationUser")
  invitationsSent                   AccountActivationToken[]        @relation("ActivationInviter")
  filesUploaded                     FileObject[]                    @relation("FileUploader")
  settingsUpdated                   SystemSetting[]
  formAvailabilityUpdated           FormAvailability[]
  studentEnrollments                StudentEnrollment[]
  reviews                           MentorReview[]                  @relation("ReviewMentor")
  reviewsAssigned                   MentorReview[]                  @relation("ReviewAssigner")
  reviewsDecided                    MentorReview[]                  @relation("ReviewDecider")
  reviewEvents                      ReviewEvent[]
  distributionBatches               DistributionBatch[]
  resultReleases                    ResultRelease[]
  threadsCreated                    DiscussionThread[]
  reportsFiled                      ContentReport[]                 @relation("ReportReporter")
  reportsResolved                   ContentReport[]                 @relation("ReportResolver")
  moderationActions                 ModerationAction[]
  activityLogs                      ActivityLog[]
  teacherApplicationsDecided        TeacherApplication[]            @relation("TeacherApplicationDecidedBy")
  teacherApplication                TeacherApplication?             @relation("TeacherApplicationUser")
  teacherApplicationSchoolsVerified TeacherApplication[]            @relation("TeacherApplicationSchoolVerifiedBy")
  applicationInfoRequests           ApplicationInfoRequest[]        @relation("ApplicationInfoRequestedBy")
  notificationOutbox                NotificationOutbox[]
  statusChanges                     UserStatusChange[]              @relation("StatusChangeUser")
  statusChangesMade                 UserStatusChange[]              @relation("StatusChangeActor")
  bulkOperations                    BulkOperation[]                 @relation("BulkOperationActor")
  testsCreated                      Test[]                          @relation("TestCreatedBy")
  markerAuthorizations              MarkerAuthorization[]           @relation("MarkerCoach")
  markerAuthorizationsGranted       MarkerAuthorization[]           @relation("MarkerGrantedBy")
  markerAuthorizationsRevoked       MarkerAuthorization[]           @relation("MarkerRevokedBy")
  testExtensionsAsStudent           TestExtension[]                 @relation("TestExtensionStudent")
  testExtensionsAsTeacher           TestExtension[]                 @relation("TestExtensionTeacher")
  testExtensionsGranted             TestExtension[]                 @relation("TestExtensionGrantedBy")
  testExtensionsEdited              TestExtension[]                 @relation("TestExtensionEditedBy")
  testExtensionsCancelled           TestExtension[]                 @relation("TestExtensionCancelledBy")
  testSubmissions                   TestSubmission[]                @relation("TestSubmissionStudent")
  testVersionsSubmitted             TestSubmissionVersion[]         @relation("TestVersionSubmitter")
  testVersionsAsTeacher             TestSubmissionVersion[]         @relation("TestVersionTeacher")
  testAnswerPagesAsStudent          TestAnswerPage[]                @relation("TestAnswerPageStudent")
  testAnswerPagesUploaded           TestAnswerPage[]                @relation("TestAnswerPageUploader")
  testSubmissionStatusChanges       TestSubmissionStatusChange[]    @relation("TestSubmissionStatusActor")
  testMarkerAssignments             TestMarkerAssignment[]          @relation("TestMarkerAssignmentCoach")
  testMarkerAssignmentsMade         TestMarkerAssignment[]          @relation("TestMarkerAssignmentAssignedBy")
  testMarkerAssignmentsEnded        TestMarkerAssignment[]          @relation("TestMarkerAssignmentEndedBy")
  testMarkings                      TestMarking[]                   @relation("TestMarkingMarker")
  testMarkChanges                   TestMarkChange[]                @relation("TestMarkChangeActor")
  testReviews                       TestReview[]                    @relation("TestReviewActor")
  testPublications                  TestPublication[]               @relation("TestPublicationActor")
  testResultWithdrawals             TestResultWithdrawal[]          @relation("TestResultWithdrawalActor")

  @@index([points])
  @@index([role])
  @@index([schoolId])
  @@index([divisionId])
  /// Reports and dashboard: users by role and account state.
  @@index([role, isActive])
  @@index([accountStatus])
  @@index([role, accountStatus])
  @@index([createdAt])
  @@index([gradeLevel])
  @@index([role, olympiadLevel])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 of the opaque token. The raw token is never stored.
  tokenHash String    @unique
  /// All tokens produced by rotating one login share a family; reuse of a
  /// rotated token revokes the whole family.
  familyId  String
  expiresAt DateTime
  revokedAt DateTime?
  /// Set when this token was exchanged for a new one.
  rotatedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// Single-use link that activates an account.
///   INVITATION         – an admin invited the person; they choose a password.
///   EMAIL_VERIFICATION – a self-registered student confirms their e-mail.
/// Only the SHA-256 of the token is stored. Issuing a new token for a user
/// invalidates the previous unused ones.
model AccountActivationToken {
  id          String            @id @default(uuid())
  userId      String
  user        User              @relation("ActivationUser", fields: [userId], references: [id], onDelete: Cascade)
  purpose     ActivationPurpose
  tokenHash   String            @unique
  expiresAt   DateTime
  usedAt      DateTime?
  revokedAt   DateTime?
  createdById String?
  createdBy   User?             @relation("ActivationInviter", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime          @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@index([createdById])
}

// ─── School directory (M12, S1) ─────────────────────────────────────────────────

/// A source of directory data (NESA first). New sources are new rows, not new code paths.
model SchoolDataSource {
  id          String   @id @default(uuid())
  /// Stable key, e.g. NESA.
  key         String   @unique
  name        String
  url         String?
  description String?
  createdAt   DateTime @default(now())

  externalIds   SchoolExternalId[]
  sourceRecords SchoolSourceRecord[]
  contacts      SchoolContact[]
  levels        SchoolEducationLevel[]
  programmes    SchoolProgramme[]
  syncRuns      SchoolSyncRun[]
}

/// A school's identity in a data source: its code there, or (no usable code) a fingerprint of its
/// published name and place. A matching aid, not an immutable identity: a school keeps every key it
/// was ever matched by (supersededAt marks an older one), so a renamed or moved school is still
/// found and never created twice. One key → one school per source.
model SchoolExternalId {
  id           String               @id @default(uuid())
  dataSourceId String
  dataSource   SchoolDataSource     @relation(fields: [dataSourceId], references: [id], onDelete: Restrict)
  externalKey  String
  kind         SchoolExternalIdKind
  schoolId     String
  school       School               @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  firstSeenAt  DateTime             @default(now())
  lastSeenAt   DateTime             @default(now())
  /// A newer key replaced this one; it still identifies the school.
  supersededAt DateTime?

  @@unique([dataSourceId, externalKey])
  @@index([schoolId])
}

/// One source row exactly as published (every column, verbatim) — never edited or deleted
/// (trigger school_source_record_immutable); only its link to a school may be set or corrected.
model SchoolSourceRecord {
  id            String           @id @default(uuid())
  dataSourceId  String
  dataSource    SchoolDataSource @relation(fields: [dataSourceId], references: [id], onDelete: Restrict)
  /// e.g. "NESA accredited schools, generated 2026-11-11".
  datasetLabel  String
  /// SHA-256 of the source file.
  datasetSha256 String
  /// Where in the file: sheet / tab and row.
  sourceRef     String
  /// Every source column with its original header and value.
  raw           Json
  /// SHA-256 of the raw row.
  rowHash       String
  schoolId      String?
  school        School?          @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  /// How the row was matched to the school (CODE, EXTERNAL_ID, FINGERPRINT, REVIEW…); NULL: not matched.
  matchedBy     String?
  /// Data problems found in the row (missing or conflicting code, unreadable phone…).
  issues        Json             @default("[]")
  issueCount    Int              @default(0)
  createdAt     DateTime         @default(now())
  /// The directory sync run (S2) that recorded this row; NULL for rows recorded otherwise.
  syncRunId     String?
  syncRun       SchoolSyncRun?   @relation(fields: [syncRunId], references: [id], onDelete: Restrict)
  syncItem      SchoolSyncItem?

  @@unique([dataSourceId, datasetSha256, sourceRef])
  @@index([syncRunId])
  @@index([schoolId])
  @@index([dataSourceId, rowHash])
}

/// A school's e-mail address or phone number. ADMIN_ONLY by default; REPRESENTATIVES only once an
/// Administrator has verified it (database check). Never in public search, registration, exports or
/// audit entries (which record a masked value). Never deleted: removing or replacing a contact sets
/// removedAt, so every value it had stays readable by Administrators only. At most one active
/// contact per school, type and value (enforced under the school's row lock).
model SchoolContact {
  id           String                  @id @default(uuid())
  schoolId     String
  school       School                  @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  type         SchoolContactType
  /// Normalised (e-mail lower-case; phone E.164 where recognisable).
  value        String
  /// As entered or published.
  rawValue     String?
  label        String?
  isPrimary    Boolean                 @default(false)
  visibility   SchoolContactVisibility @default(ADMIN_ONLY)
  verifiedAt   DateTime?
  verifiedById String?
  verifiedBy   User?                   @relation("SchoolContactVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  /// NULL: entered by an Administrator.
  dataSourceId String?
  dataSource   SchoolDataSource?       @relation(fields: [dataSourceId], references: [id], onDelete: SetNull)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @default(now()) @updatedAt
  /// Removed (or replaced by a new value): kept, no longer active.
  removedAt    DateTime?
  removedById  String?
  removedBy    User?                   @relation("SchoolContactRemovedBy", fields: [removedById], references: [id], onDelete: SetNull)

  @@index([schoolId, type, value])
  @@index([verifiedById])
  @@index([removedById])
  @@index([dataSourceId])
}

/// Education levels (reference data; Rwanda: PPR, PR, OL, AL, PE).
model EducationLevel {
  code      String                 @id
  name      String
  sortOrder Int
  schools   SchoolEducationLevel[]
}

model SchoolEducationLevel {
  schoolId     String
  school       School            @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  levelCode    String
  level        EducationLevel    @relation(fields: [levelCode], references: [code], onDelete: Restrict)
  /// A published variant of the level (e.g. "L"), kept as published.
  qualifier    String?
  /// The exact source text this offering came from.
  sourceToken  String?
  dataSourceId String?
  dataSource   SchoolDataSource? @relation(fields: [dataSourceId], references: [id], onDelete: SetNull)
  createdAt    DateTime          @default(now())

  @@id([schoolId, levelCode])
  @@index([levelCode])
  @@index([dataSourceId])
}

/// A-Level combinations, TVET trades and other programmes (reference data). needsReview: created
/// from a source and not yet reviewed — never shown as a verified offering.
model Programme {
  id          String            @id @default(uuid())
  code        String?           @unique
  name        String
  category    ProgrammeCategory
  tvetLevel   Int?
  needsReview Boolean           @default(true)
  createdAt   DateTime          @default(now())
  schools     SchoolProgramme[]

  @@unique([category, name])
}

// ─── School directory sync (M13, S2) ─────────────────────────────────────────────

/// One upload of a source export, compared with the directory (a dry run). Staging only until an
/// approved apply (S2b). datasetKey and normaliserVersion come from the server's dataset
/// configuration (src/schools/sync/sync-datasets.ts), never from the file. Never deleted; once
/// APPLIED or SUPERSEDED only stagedPurgedAt may change (trigger school_sync_run_guard).
model SchoolSyncRun {
  id                 String              @id @default(uuid())
  datasetKey         String
  normaliserVersion  String
  dataSourceId       String
  dataSource         SchoolDataSource    @relation(fields: [dataSourceId], references: [id], onDelete: Restrict)
  datasetLabel       String
  /// Cleaned file name (src/schools/import/file-name.ts) and the SHA-256 of the file.
  fileName           String
  fileSha256         String
  format             String
  rowCount           Int
  /// The source's own totals (e.g. NESA's Summary tab), as read.
  sourceSummary      Json?
  /// The source totals compared with the rows read.
  reconciliation     Json
  /// Counts per outcome and per change kind.
  counts             Json
  reportDigest       String
  decisionsDigest    String
  /// Incremented by every recompare and decision change (S2b); review tokens are bound to it.
  reviewGeneration   Int                 @default(0)
  status             SchoolSyncRunStatus @default(PREVIEW)
  comparedAt         DateTime
  createdAt          DateTime            @default(now())
  createdById        String?
  createdBy          User?               @relation("SchoolSyncRunCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  expiresAt          DateTime
  appliedAt          DateTime?
  appliedById        String?
  appliedBy          User?               @relation("SchoolSyncRunAppliedBy", fields: [appliedById], references: [id], onDelete: SetNull)
  /// M14 (S2b): the Super Admin who approved the run for apply, when, and the review generation
  /// approved. approvalTokenId identifies the one valid apply token (never the token itself);
  /// any decision, recompare or new approval replaces or clears it.
  approvedAt         DateTime?
  approvedById       String?
  approvedBy         User?               @relation("SchoolSyncRunApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedGeneration Int?
  approvalTokenId    String?
  supersededAt       DateTime?
  supersededByRunId  String?
  supersededBy       SchoolSyncRun?      @relation("SchoolSyncRunSupersededBy", fields: [supersededByRunId], references: [id], onDelete: Restrict)
  supersedes         SchoolSyncRun[]     @relation("SchoolSyncRunSupersededBy")
  /// When the staged raw and normalised values were purged (7 days after the run ended).
  stagedPurgedAt     DateTime?
  /// Apply measurements (S2b): duration, lock wait, memory peak, rows written.
  metrics            Json?

  items         SchoolSyncItem[]
  changes       SchoolSyncChange[]
  sourceRecords SchoolSourceRecord[]

  @@index([datasetKey, status])
  @@index([status, expiresAt])
  @@index([dataSourceId])
  @@index([createdById])
  @@index([appliedById])
  @@index([approvedById])
  @@index([supersededByRunId])
}

/// One source row of a run (or a directory school missing from the source). raw and normalized
/// are staged copies, purged 7 days after the run ended; the permanent copy of an applied row is
/// its SchoolSourceRecord (sourceRecordId). Never deleted.
model SchoolSyncItem {
  id             String                   @id @default(uuid())
  runId          String
  run            SchoolSyncRun            @relation(fields: [runId], references: [id], onDelete: Restrict)
  /// NULL for MISSING_FROM_SOURCE (a directory school, not a source row).
  rowNumber      Int?
  sourceRef      String?
  raw            Json?
  normalized     Json?
  outcome        SchoolSyncItemOutcome
  schoolId       String?
  school         School?                  @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  matchedBy      String?
  conflictGroup  String?
  /// Candidates, conflict reasons and the like — never contact values.
  details        Json?
  issues         Json                     @default("[]")
  issueCount     Int                      @default(0)
  conflictState  SchoolSyncConflictState?
  proposal       Json?
  proposedById   String?
  proposedBy     User?                    @relation("SchoolSyncItemProposedBy", fields: [proposedById], references: [id], onDelete: SetNull)
  proposedAt     DateTime?
  resolution     Json?
  resolvedById   String?
  resolvedBy     User?                    @relation("SchoolSyncItemResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt     DateTime?
  sourceRecordId String?                  @unique
  sourceRecord   SchoolSourceRecord?      @relation(fields: [sourceRecordId], references: [id], onDelete: Restrict)
  auditLogId     String?
  createdAt      DateTime                 @default(now())
  changes        SchoolSyncChange[]

  @@index([runId, outcome])
  @@index([runId, rowNumber])
  @@index([conflictState])
  @@index([schoolId])
  @@index([proposedById])
  @@index([resolvedById])
}

/// One proposed change — one field, one addition, one new place or one new school. Decided one by
/// one or (allowed kinds) by category in S2b. currentValue / publishedValue are staged copies,
/// purged with the run's staging data. Never deleted.
model SchoolSyncChange {
  id                     String               @id @default(uuid())
  runId                  String
  run                    SchoolSyncRun        @relation(fields: [runId], references: [id], onDelete: Restrict)
  /// NULL for a run-level change (NEW_PLACE).
  itemId                 String?
  item                   SchoolSyncItem?      @relation(fields: [itemId], references: [id], onDelete: Restrict)
  schoolId               String?
  school                 School?              @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  kind                   SchoolSyncChangeKind
  field                  String?
  currentValue           Json?
  publishedValue         Json?
  decision               SchoolSyncDecision   @default(PENDING)
  decidedById            String?
  decidedBy              User?                @relation("SchoolSyncChangeDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt              DateTime?
  decisionNote           String?
  categoryApprovalDigest String?
  appliedAt              DateTime?
  auditLogId             String?
  createdAt              DateTime             @default(now())
  /// M14 (S2b): a recompare found this change no longer part of the comparison. Kept (with its
  /// decision) as history; never applied.
  retiredAt              DateTime?

  @@index([runId, kind, decision])
  @@index([runId, retiredAt])
  @@index([itemId])
  @@index([schoolId])
  @@index([decidedById])
}

model SchoolProgramme {
  schoolId     String
  school       School            @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  programmeId  String
  programme    Programme         @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  sourceToken  String?
  dataSourceId String?
  dataSource   SchoolDataSource? @relation(fields: [dataSourceId], references: [id], onDelete: SetNull)
  createdAt    DateTime          @default(now())

  @@id([schoolId, programmeId])
  @@index([programmeId])
  @@index([dataSourceId])
}

/// Access-token revocation list (logout). Rows are purged after expiry.
model TokenBlacklist {
  id        String   @id @default(uuid())
  jti       String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

/// Staging table for mentor applications. Approval creates the User.
/// One row per application attempt: a reapplication after a rejection is a new row (its own questions, answers and
/// decision). At most one application that is not REJECTED per username and per e-mail: partial unique indexes
/// (MentorRequest_active_username_key / _active_email_key, WHERE status <> 'REJECTED').
model MentorRequest {
  id                    String                   @id @default(uuid())
  firstName             String
  lastName              String
  username              String
  email                 String
  /// Cleared once the request is decided.
  passwordHash          String?
  status                MentorRequestStatus      @default(PENDING)
  /// Application details (capability coachApplicationDetails); NULL / empty for older applications.
  /// country and olympiadInterests are copied to the Coach account on approval.
  country               String?
  occupation            String?
  educationLevel        CoachEducationLevel?
  olympiadInterests     OlympiadSubject[]        @default([])
  /// Another Olympiad named in words ("Other"; owner 2026-11-21), 2–100 characters (CHECK). Never a subject.
  olympiadInterestOther String?
  /// Required on new applications (2026-11-20); copied to the Coach account on approval. NULL for older ones.
  gender                Gender?
  /// Home location (homeLocationRules, 2026-11-20): `country` is the home country (required on new applications);
  /// province, district and sector only for Rwanda. Copied to the Coach account on approval. NULL for older ones.
  homeProvince          String?
  homeDistrict          String?
  homeSector            String?
  /// Coach application details (2026-11-17, REG-06): phone (E.164), institution or affiliation, areas of
  /// expertise, relevant experience (free text) and years of experience (0–60). All optional for older clients.
  phone                 String?
  affiliation           String?
  expertise             String?
  relevantExperience    String?
  yearsOfExperience     Int?
  /// Why an Administrator rejected the application (e-mailed to the applicant).
  rejectionReason       String?
  infoRequests          ApplicationInfoRequest[]
  /// Optional profile picture sent with the application (REG-02); becomes the account's picture on approval.
  avatarFileId          String?                  @unique
  avatarFile            FileObject?              @relation("MentorRequestAvatar", fields: [avatarFileId], references: [id], onDelete: SetNull)
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  @@index([status])
  @@index([username])
  @@index([email])
}

/// "Request more information" on a Teacher or Coach application (ADR-009, REG-10). The application stays PENDING;
/// the applicant answers through a one-time link (only the SHA-256 of its token is stored) valid 14 days. At most
/// one open request per application (partial unique indexes, created in the migration). A decision on the
/// application cancels an open request. Exactly one of teacherApplicationId / mentorRequestId is set (CHECK).
model ApplicationInfoRequest {
  id                   String              @id @default(uuid())
  teacherApplicationId String?
  teacherApplication   TeacherApplication? @relation(fields: [teacherApplicationId], references: [id], onDelete: Cascade)
  mentorRequestId      String?
  mentorRequest        MentorRequest?      @relation(fields: [mentorRequestId], references: [id], onDelete: Cascade)
  /// The Administrator's question, shown to the applicant.
  question             String
  requestedById        String?
  requestedBy          User?               @relation("ApplicationInfoRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  requestedAt          DateTime            @default(now())
  tokenHash            String              @unique
  expiresAt            DateTime
  answer               String?
  answeredAt           DateTime?
  /// Set when the application was decided (or a new request replaced this one) before an answer.
  cancelledAt          DateTime?

  @@index([teacherApplicationId, requestedAt])
  @@index([mentorRequestId, requestedAt])
  @@index([requestedById])
}

/// Teacher self-registration (owner-approved): a public application, reviewed by an Administrator.
/// No User, school assignment or student access exists until approval; approval creates the TEACHER
/// account and its TeacherSchoolAssignment. No school is ever created from an application.
/// At most one PENDING application per username and per e-mail: partial unique indexes
/// (TeacherApplication_pending_username_key / _pending_email_key, WHERE status = 'PENDING').
model TeacherApplication {
  id                    String                   @id @default(uuid())
  firstName             String
  lastName              String
  username              String
  email                 String
  /// Cleared once the application is decided.
  passwordHash          String?
  /// E.164.
  phone                 String
  /// ISO 3166-1 alpha-2.
  country               String
  olympiadInterests     OlympiadSubject[]
  /// Another Olympiad named in words ("Other"; owner 2026-11-21), 2–100 characters (CHECK). Never a subject.
  olympiadInterestOther String?
  /// Required on new applications (2026-11-20); copied to the Teacher account on approval. NULL for older ones.
  gender                Gender?
  status                TeacherApplicationStatus @default(PENDING)
  /// A listed school (official directory) — or NULL with proposedSchoolName ("my school is missing").
  schoolId              String?
  school                School?                  @relation("TeacherApplicationSchool", fields: [schoolId], references: [id], onDelete: Restrict)
  proposedSchoolName    String?
  /// The place the applicant entered (for a listed school: checked against the school's own place).
  schoolProvince        String
  schoolDistrict        String
  schoolSector          String?
  /// Home location (homeLocationRules, 2026-11-20): `country` is the home country; province, district and sector
  /// only for Rwanda (NULL otherwise; older applications have district and sector without a province).
  homeProvince          String?
  homeDistrict          String?
  homeSector            String?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  decidedAt             DateTime?
  decidedById           String?
  decidedBy             User?                    @relation("TeacherApplicationDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  rejectionReason       String?
  decisionNote          String?
  /// The TEACHER account created on approval.
  userId                String?                  @unique
  user                  User?                    @relation("TeacherApplicationUser", fields: [userId], references: [id], onDelete: SetNull)
  /// The school the approval assigned (TeacherSchoolAssignment).
  assignedSchoolId      String?
  assignedSchool        School?                  @relation("TeacherApplicationAssignedSchool", fields: [assignedSchoolId], references: [id], onDelete: Restrict)
  /// A missing-school application: when and by whom an Administrator linked it to an official school
  /// (POST /admin/teacher-applications/:id/school; schoolId is then that school). Required before approval.
  schoolVerifiedAt      DateTime?
  schoolVerifiedById    String?
  schoolVerifiedBy      User?                    @relation("TeacherApplicationSchoolVerifiedBy", fields: [schoolVerifiedById], references: [id], onDelete: SetNull)
  /// Position or teaching role at the school (e.g. "Mathematics teacher", "Head of sciences"), as entered.
  position              String?
  /// Years of teaching experience (0–60), where the applicant gives it.
  yearsOfExperience     Int?
  infoRequests          ApplicationInfoRequest[]
  /// Optional profile picture sent with the application (REG-02); becomes the account's picture on approval.
  avatarFileId          String?                  @unique
  avatarFile            FileObject?              @relation("TeacherApplicationAvatar", fields: [avatarFileId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([schoolId])
  @@index([assignedSchoolId])
  @@index([decidedById])
  @@index([schoolVerifiedById])
}

model School {
  id               String               @id @default(uuid())
  /// Exactly as published (M12: not unique — several schools share a name; identified by code,
  /// external source ids and place, never by name).
  name             String
  location         String
  createdAt        DateTime             @default(now())
  /// Official school code (6 digits; P1-11 official list, M8). NULL for a school entered before the list.
  code             String?              @unique
  /// Rwanda province (official list; the first digit of the code).
  province         String?
  district         String?
  sector           String?
  /// PUBLIC, GOVERNMENT_AIDED or PRIVATE (official list).
  ownership        String?
  /// Normalised official name (src/schools/school-key.ts): resolves a registration that sends a name.
  nameKey          String?
  /// ISO 3166-1 alpha-2 (school administration PR B, M11). Codes and the official directory are Rwanda only.
  countryCode      String               @default("RW")
  /// Countries (owner decision 2026-11-19): the foreign key to Country (every ISO 3166-1 alpha-2 code is seeded).
  country          Country              @relation(fields: [countryCode], references: [code], onDelete: Restrict)
  /// Inactive: kept with all its history, but accepts no new claim, registration or Teacher assignment.
  isActive         Boolean              @default(true)
  /// OFFICIAL_LIST (M8 directory), ADMIN (created by an Administrator) or LEGACY (entered before the list).
  source           SchoolSource         @default(LEGACY)
  createdById      String?
  createdBy        User?                @relation("SchoolCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedAt        DateTime             @default(now()) @updatedAt
  /// M12 (school directory S1): the official directory's cell and village (free text, trimmed).
  cell             String?
  village          String?
  accommodation    SchoolAccommodation?
  /// When a directory sync (S2) last compared this school with a source.
  lastSourceSyncAt DateTime?
  /// When an Administrator last confirmed the record (S2 / S3).
  lastVerifiedAt   DateTime?
  lastVerifiedById String?
  lastVerifiedBy   User?                @relation("SchoolVerifiedBy", fields: [lastVerifiedById], references: [id], onDelete: SetNull)

  students                    User[]
  enrollments                 StudentEnrollment[]
  teachers                    TeacherSchoolAssignment[]
  affiliations                StudentSchoolAffiliation[]
  contacts                    SchoolContact[]
  levels                      SchoolEducationLevel[]
  programmes                  SchoolProgramme[]
  externalIds                 SchoolExternalId[]
  sourceRecords               SchoolSourceRecord[]
  syncItems                   SchoolSyncItem[]
  syncChanges                 SchoolSyncChange[]
  teacherApplications         TeacherApplication[]       @relation("TeacherApplicationSchool")
  teacherApplicationsAssigned TeacherApplication[]       @relation("TeacherApplicationAssignedSchool")

  @@index([name])
  @@index([nameKey])
  @@index([province, district, sector])
  @@index([countryCode, isActive])
  @@index([createdById])
  @@index([lastVerifiedById])
}

/// Where a school record comes from (M11).
enum SchoolSource {
  OFFICIAL_LIST
  ADMIN
  LEGACY
}

enum SchoolAccommodation {
  DAY
  BOARDING
  MIXED
}

enum SchoolContactType {
  EMAIL
  PHONE
  OTHER
}

enum SchoolContactVisibility {
  ADMIN_ONLY
  REPRESENTATIVES
}

enum ProgrammeCategory {
  A_LEVEL_COMBINATION
  TVET_TRADE
  OTHER
}

enum SchoolSyncRunStatus {
  PREVIEW
  APPLIED
  EXPIRED
  SUPERSEDED
}

enum SchoolSyncItemOutcome {
  MATCHED
  NEW
  DUPLICATE_ROW
  CONFLICT
  POSSIBLE_DUPLICATE
  INVALID
  MISSING_FROM_SOURCE
}

enum SchoolSyncChangeKind {
  CREATE_SCHOOL
  FILL_EMPTY
  CHANGE
  NAME_RESTORE
  NEW_PLACE
  ADD_CONTACT
  ADD_LEVEL
  ADD_PROGRAMME
  RESOLVE_CONFLICT
}

enum SchoolSyncDecision {
  PENDING
  APPROVED
  REJECTED
}

enum SchoolSyncConflictState {
  OPEN
  PROPOSED
  RESOLVED
}

enum SchoolExternalIdKind {
  CODE
  FINGERPRINT
  OTHER
}

// ═══════════════════════════════════════════════════════════════════════════════
// Academic structure
// ═══════════════════════════════════════════════════════════════════════════════

/// Exactly two rows (JUNIOR, SENIOR), created by the seed. Admins may edit
/// name/description/isActive but never create or delete divisions.
model Division {
  id          String       @id @default(uuid())
  code        DivisionCode @unique
  name        String
  description String?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  students            User[]
  studentEnrollments  StudentEnrollment[]
  mentorAssignments   MentorAssignment[]
  resources           CourseResource[]
  assignments         Assignment[]
  threads             DiscussionThread[]
  permissionOverrides UserPermissionOverride[]
}

/// A subject area (e.g. Mathematics). The platform launches with Mathematics
/// only; further disciplines are new rows — no schema change needed.
model Discipline {
  id          String   @id @default(uuid())
  /// Stable identifier, e.g. "MATHEMATICS".
  code        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  courses              Course[]
  memberships          ProgrammeMembership[]
  /// Test Management (WS3): the subject's tests and authorised markers.
  tests                Test[]
  markerAuthorizations MarkerAuthorization[]
}

/// An academic year (e.g. "2026-2027"). Assignments belong to a year;
/// closing a year archives its assignments.
model AcademicYear {
  id        String             @id @default(uuid())
  /// Display name, e.g. "2026-2027".
  name      String             @unique
  startsOn  DateTime           @db.Date
  endsOn    DateTime           @db.Date
  status    AcademicYearStatus @default(PLANNED)
  /// TRUE for the single current year, NULL otherwise. The unique index allows
  /// many NULLs but only one TRUE, so the database guarantees one current year.
  isCurrent Boolean?           @unique
  closedAt  DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  enrollments StudentEnrollment[]
  assignments Assignment[]

  @@index([status])
}

/// A student's placement for one academic year (grade, division, school).
/// History is kept: a new row per year, older rows become PROMOTED/GRADUATED.
model StudentEnrollment {
  id             String                  @id @default(uuid())
  studentId      String
  student        User                    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear            @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  divisionId     String
  division       Division                @relation(fields: [divisionId], references: [id], onDelete: Restrict)
  gradeLevel     GradeLevel
  schoolId       String?
  school         School?                 @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  status         StudentEnrollmentStatus @default(ACTIVE)
  enrolledAt     DateTime                @default(now())
  endedAt        DateTime?

  @@unique([studentId, academicYearId])
  @@index([academicYearId, divisionId, status])
  @@index([divisionId])
  @@index([schoolId])
}

/// A course within a discipline (launch: the four Mathematics courses).
/// Content (resources, assignments, discussions) is scoped per
/// (course × division). Courses are archived, never deleted.
model Course {
  id                 String       @id @default(uuid())
  disciplineId       String
  discipline         Discipline   @relation(fields: [disciplineId], references: [id], onDelete: Restrict)
  /// Stable identifier within the discipline, e.g. "ALGEBRA".
  code               String
  title              String
  description        String
  status             CourseStatus @default(PUBLISHED)
  publishedAt        DateTime?
  archivedAt         DateTime?
  sortOrder          Int          @default(0)
  /// When false, existing threads stay readable but nobody can start a thread
  /// or post in this course (course and assignment discussions).
  discussionsEnabled Boolean      @default(true)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  assignments         Assignment[]
  enrollments         CourseEnrollment[]
  resources           CourseResource[]
  threads             DiscussionThread[]
  mentorAssignments   MentorAssignment[]
  activityLogs        ActivityLog[]
  permissionOverrides UserPermissionOverride[]

  @@unique([disciplineId, code])
  @@index([status])
}

/// Admin assigns a mentor to a (course × division). This is the mentor's scope
/// for resources, assignments, discussions and analytics.
model MentorAssignment {
  id           String   @id @default(uuid())
  mentorId     String
  mentor       User     @relation("MentorAssignmentMentor", fields: [mentorId], references: [id], onDelete: Cascade)
  courseId     String
  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  divisionId   String
  division     Division @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  assignedById String?
  assignedBy   User?    @relation("MentorAssignmentAssigner", fields: [assignedById], references: [id], onDelete: SetNull)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([mentorId, courseId, divisionId])
  @@index([courseId, divisionId])
  @@index([divisionId])
  @@index([assignedById])
}

/// Per-student course progress. Created on first open.
model CourseEnrollment {
  id            String                 @id @default(uuid())
  courseId      String
  course        Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  studentId     String
  student       User                   @relation("CourseEnrollments", fields: [studentId], references: [id], onDelete: Cascade)
  status        CourseEnrollmentStatus @default(UNROLLED)
  firstOpenedAt DateTime               @default(now())
  lastOpenedAt  DateTime               @default(now())
  completedAt   DateTime?

  @@unique([courseId, studentId])
  @@index([studentId])
  @@index([status])
}

// ═══════════════════════════════════════════════════════════════════════════════
// Files
// ═══════════════════════════════════════════════════════════════════════════════

/// Metadata for every stored file. The bytes live in the configured storage
/// driver (local disk or S3-compatible) under `storageKey`.
model FileObject {
  id           String      @id @default(uuid())
  storageKey   String      @unique
  purpose      FilePurpose
  originalName String
  /// Detected from file content (magic bytes), not trusted from the client.
  mimeType     String
  size         Int
  sha256       String
  uploadedById String?
  uploadedBy   User?       @relation("FileUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())

  resourceAttachments        ResourceAttachment[]
  assignmentAttachments      AssignmentAttachment[]
  submissionAttachments      SubmissionAttachment[]
  reviewAttachments          ReviewAttachment[]
  /// The account whose current profile picture this is (FilePurpose AVATAR); keeps it from orphan cleanup.
  avatarOf                   User?                  @relation("UserAvatar")
  /// An optional profile picture sent with a Teacher / Coach application (REG-02), moved to the account on approval.
  teacherApplicationAvatarOf TeacherApplication?    @relation("TeacherApplicationAvatar")
  mentorRequestAvatarOf      MentorRequest?         @relation("MentorRequestAvatar")
  /// A test's paper or marking guide (Test Management); keeps the file from orphan cleanup.
  testFiles                  TestFile[]
  /// A page of a student's test answer (Test Management Phase 2); keeps the file from orphan cleanup.
  testAnswerPage             TestAnswerPage?

  @@index([purpose])
  @@index([createdAt])
  @@index([uploadedById])
}

// ═══════════════════════════════════════════════════════════════════════════════
// Learning content
// ═══════════════════════════════════════════════════════════════════════════════

model CourseResource {
  id           String       @id @default(uuid())
  courseId     String
  course       Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  divisionId   String
  division     Division     @relation(fields: [divisionId], references: [id])
  type         ResourceType
  title        String
  description  String?
  /// Author(s) of a book, or who prepared the material.
  author       String?
  /// Publisher, or the competition/exam a past paper comes from.
  source       String?
  /// Publication year, or the year of the exam.
  year         Int?
  /// Free-form labels (lower-case), e.g. "inequalities", "imo".
  tags         String[]     @default([])
  /// Display order within the course (lower = first).
  sortOrder    Int          @default(0)
  isPublished  Boolean      @default(false)
  publishedAt  DateTime?
  /// Archived resources are hidden from students but kept.
  archivedAt   DateTime?
  uploadedById String
  uploadedBy   User         @relation("ResourceUploader", fields: [uploadedById], references: [id])
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  attachments ResourceAttachment[]
  views       ResourceView[]

  @@index([courseId, divisionId, isPublished])
  @@index([sortOrder])
  @@index([tags], type: Gin)
  @@index([divisionId])
  @@index([uploadedById])
}

/// Files attached to a learning resource (ordered).
model ResourceAttachment {
  id         String         @id @default(uuid())
  resourceId String
  resource   CourseResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  fileId     String
  file       FileObject     @relation(fields: [fileId], references: [id], onDelete: Restrict)
  sortOrder  Int            @default(0)
  createdAt  DateTime       @default(now())

  @@unique([resourceId, fileId])
  @@index([fileId])
}

model ResourceView {
  id            String         @id @default(uuid())
  resourceId    String
  resource      CourseResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  studentId     String
  student       User           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  firstViewedAt DateTime       @default(now())
  lastViewedAt  DateTime       @default(now())
  viewCount     Int            @default(1)

  @@unique([resourceId, studentId])
  @@index([studentId])
}

// ═══════════════════════════════════════════════════════════════════════════════
// Assessment
// ═══════════════════════════════════════════════════════════════════════════════

model Assignment {
  id           String   @id @default(uuid())
  title        String
  /// Short summary shown in lists; the full brief is in instructions.
  description  String?
  instructions String
  deadline     DateTime
  /// Leaderboard points available. Awarded proportionally to the score.
  points       Int
  maximumMarks Int

  allowResubmission   Boolean @default(false)
  /// 0 = unlimited resubmissions while the deadline has not passed.
  maxResubmissions    Int     @default(0)
  /// When true, first submissions after the deadline are accepted and flagged late.
  allowLateSubmission Boolean @default(false)

  status             AssignmentStatus @default(DRAFT)
  submittedAt        DateTime?
  publishedAt        DateTime?
  rejectedAt         DateTime?
  rejectionNote      String?
  /// When results of this assignment were last released to students (any release).
  resultsPublishedAt DateTime?
  /// Set when archived (status ARCHIVED).
  archivedAt         DateTime?
  /// Set when it stopped accepting submissions (status CLOSED).
  closedAt           DateTime?

  approvedById String?
  approvedBy   User?   @relation("AssignmentApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  courseId   String
  course     Course   @relation(fields: [courseId], references: [id])
  divisionId String
  division   Division @relation(fields: [divisionId], references: [id])

  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)

  createdById String
  createdBy   User   @relation("AssignmentCreator", fields: [createdById], references: [id])

  attachments         AssignmentAttachment[]
  submissions         Submission[]
  views               AssignmentView[]
  distributionBatches DistributionBatch[]
  resultReleases      ResultRelease[]
  threads             DiscussionThread[]
  events              AssignmentEvent[]
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  @@index([courseId, divisionId, status])
  @@index([academicYearId, status])
  @@index([deadline])
  @@index([createdById])
  @@index([status])
  @@index([approvedById])
  @@index([divisionId])
}

/// Files attached to an assignment brief (ordered).
/// Assignment history: one row per creation, edit, file change and status
/// change. Append-only.
model AssignmentEvent {
  id           String              @id @default(uuid())
  assignmentId String
  assignment   Assignment          @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  type         AssignmentEventType
  fromStatus   AssignmentStatus?
  toStatus     AssignmentStatus?
  /// Null for automatic events (deadline closing, academic-year rollover).
  actorId      String?
  actor        User?               @relation(fields: [actorId], references: [id], onDelete: SetNull)
  note         String?
  /// For UPDATED: { field: { from, to } }. For attachments: { attachmentIds }.
  changes      Json?
  createdAt    DateTime            @default(now())

  @@index([assignmentId, createdAt])
  @@index([actorId])
}

model AssignmentAttachment {
  id           String     @id @default(uuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  fileId       String
  file         FileObject @relation(fields: [fileId], references: [id], onDelete: Restrict)
  sortOrder    Int        @default(0)
  createdAt    DateTime   @default(now())

  @@unique([assignmentId, fileId])
  @@index([fileId])
}

/// One row per (student, assignment): drives the "New" vs "Opened" status.
model AssignmentView {
  id            String     @id @default(uuid())
  assignmentId  String
  assignment    Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId     String
  student       User       @relation("AssignmentViewer", fields: [studentId], references: [id], onDelete: Cascade)
  firstViewedAt DateTime   @default(now())
  lastViewedAt  DateTime   @default(now())
  viewCount     Int        @default(1)

  @@unique([assignmentId, studentId])
  @@index([studentId])
}

/// A student's work for one assignment (one row per student × assignment).
/// "status" is the overall workflow state used for filtering and the student
/// display status; the academic review itself lives in MentorReview.
model Submission {
  id     String           @id @default(uuid())
  status SubmissionStatus @default(SUBMITTED)

  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  studentId    String
  student      User       @relation("StudentSubmissions", fields: [studentId], references: [id], onDelete: Restrict)

  /// Number of resubmissions made after the first submission.
  revisionCount Int       @default(0)
  /// True when the latest (re)submission arrived after the deadline.
  isLate        Boolean   @default(false)
  submittedAt   DateTime?

  /// Open resubmission request (status RESUBMISSION_REQUESTED); cleared when
  /// the student resubmits. Past requests are kept as ReviewEvents.
  resubmissionRequestedAt DateTime?
  resubmissionDueAt       DateTime?
  resubmissionNote        String?

  /// The latest review cycle (any status). NULL until distributed.
  currentReviewId   String?        @unique
  currentReview     MentorReview?  @relation("CurrentReview", fields: [currentReviewId], references: [id], onDelete: SetNull)
  /// The review whose result the student sees. NULL until published.
  publishedReviewId String?        @unique
  publishedReview   MentorReview?  @relation("PublishedReview", fields: [publishedReviewId], references: [id], onDelete: SetNull)
  resultReleaseId   String?
  resultRelease     ResultRelease? @relation(fields: [resultReleaseId], references: [id], onDelete: SetNull)

  /// Leaderboard points granted by the published result (0 until then).
  pointsAwarded Int       @default(0)
  publishedAt   DateTime?

  revisions SubmissionRevision[]
  reviews   MentorReview[]       @relation("SubmissionReviews")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([assignmentId, studentId])
  @@index([studentId])
  @@index([assignmentId, status])
  @@index([resultReleaseId])
  /// Reports: submissions and published results in a date range.
  @@index([submittedAt])
  @@index([publishedAt])
}

/// Immutable history of every submission attempt (revision 1 = first submission).
model SubmissionRevision {
  id             String     @id @default(uuid())
  submissionId   String
  submission     Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  revisionNumber Int
  note           String?
  /// Typed answer for this attempt (files are in attachments).
  answerText     String?
  isLate         Boolean    @default(false)
  submittedById  String
  submittedBy    User       @relation(fields: [submittedById], references: [id])
  submittedAt    DateTime   @default(now())

  attachments SubmissionAttachment[]

  @@unique([submissionId, revisionNumber])
  @@index([submittedById])
}

/// Files of one submission attempt (a student may upload several pages).
model SubmissionAttachment {
  id         String             @id @default(uuid())
  revisionId String
  revision   SubmissionRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  fileId     String
  file       FileObject         @relation(fields: [fileId], references: [id], onDelete: Restrict)
  sortOrder  Int                @default(0)
  createdAt  DateTime           @default(now())

  @@unique([revisionId, fileId])
  @@index([fileId])
}

/// One administrator distribution run for an assignment.
model DistributionBatch {
  id            String               @id @default(uuid())
  assignmentId  String
  assignment    Assignment           @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  strategy      DistributionStrategy
  assignedCount Int                  @default(0)
  createdById   String
  createdBy     User                 @relation(fields: [createdById], references: [id])
  createdAt     DateTime             @default(now())

  reviews MentorReview[]

  @@index([assignmentId])
  @@index([createdById])
}

/// A mentor's academic review of a submission. A new row (cycle) is created
/// whenever the submission is (re)assigned or a published result is reopened,
/// so earlier reviews remain as history. Only mentors write score and feedback.
model MentorReview {
  id           String       @id @default(uuid())
  submissionId String
  submission   Submission   @relation("SubmissionReviews", fields: [submissionId], references: [id], onDelete: Cascade)
  /// 1, 2, 3 … per submission.
  cycle        Int
  mentorId     String
  mentor       User         @relation("ReviewMentor", fields: [mentorId], references: [id], onDelete: Restrict)
  status       ReviewStatus @default(ASSIGNED)

  // ── Formal academic review (mentor) ────────────────────────────────────────
  score      Int?
  percentage Float?
  feedback   String?

  // ── Distribution ───────────────────────────────────────────────────────────
  assignedAt          DateTime           @default(now())
  assignedById        String?
  assignedBy          User?              @relation("ReviewAssigner", fields: [assignedById], references: [id], onDelete: SetNull)
  distributionBatchId String?
  distributionBatch   DistributionBatch? @relation(fields: [distributionBatchId], references: [id], onDelete: SetNull)

  // ── Progress ───────────────────────────────────────────────────────────────
  startedAt  DateTime?
  markedAt   DateTime?
  returnedAt DateTime?

  // ── Administrator coordination (never academic feedback) ──────────────────
  decidedAt        DateTime?
  decidedById      String?
  decidedBy        User?     @relation("ReviewDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  /// Why the admin sent the review back (visible to the mentor).
  decisionNote     String?
  /// Internal note; never shown to students or mentors.
  coordinationNote String?
  publishedAt      DateTime?

  attachments  ReviewAttachment[]
  events       ReviewEvent[]
  currentFor   Submission?        @relation("CurrentReview")
  publishedFor Submission?        @relation("PublishedReview")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([submissionId, cycle])
  @@index([mentorId, status])
  @@index([distributionBatchId])
  /// Reports: completed reviews in a date range.
  @@index([returnedAt])
  @@index([assignedById])
  @@index([decidedById])
}

/// Feedback files attached by the mentor to a review.
model ReviewAttachment {
  id        String       @id @default(uuid())
  reviewId  String
  review    MentorReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  fileId    String
  file      FileObject   @relation(fields: [fileId], references: [id], onDelete: Restrict)
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now())

  @@unique([reviewId, fileId])
  @@index([fileId])
}

/// Append-only history of a review: who did what, when, with which score.
model ReviewEvent {
  id        String          @id @default(uuid())
  reviewId  String
  review    MentorReview    @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  type      ReviewEventType
  actorId   String?
  actor     User?           @relation(fields: [actorId], references: [id], onDelete: SetNull)
  score     Int?
  note      String?
  createdAt DateTime        @default(now())

  @@index([reviewId, createdAt])
  @@index([actorId])
}

/// One administrator release of results for an assignment.
model ResultRelease {
  id            String     @id @default(uuid())
  assignmentId  String
  assignment    Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  publishedById String
  publishedBy   User       @relation(fields: [publishedById], references: [id])
  resultCount   Int
  note          String?
  publishedAt   DateTime   @default(now())

  submissions Submission[]

  @@index([assignmentId])
  @@index([publishedAt])
  @@index([publishedById])
}

// ═══════════════════════════════════════════════════════════════════════════════
// Discussions
// ═══════════════════════════════════════════════════════════════════════════════

/// A discussion topic. Course threads are per (course × division);
/// assignment threads belong to one assignment (and inherit its division).
/// Exactly one of courseId / assignmentId is set (CHECK constraint).
model DiscussionThread {
  id             String       @id @default(uuid())
  courseId       String?
  course         Course?      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  assignmentId   String?
  assignment     Assignment?  @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  divisionId     String
  division       Division     @relation(fields: [divisionId], references: [id], onDelete: Restrict)
  title          String
  status         ThreadStatus @default(OPEN)
  isPinned       Boolean      @default(false)
  createdById    String
  createdBy      User         @relation(fields: [createdById], references: [id], onDelete: Restrict)
  /// Updated whenever a comment is posted; drives "most recent" ordering.
  lastActivityAt DateTime     @default(now())
  archivedAt     DateTime?
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  comments          Comment[]
  reports           ContentReport[]
  moderationActions ModerationAction[]

  @@index([courseId, divisionId, status, lastActivityAt])
  @@index([assignmentId, status])
  @@index([createdById])
  @@index([divisionId])
}

/// A message in a thread. Replies set parentId (one level of nesting).
model Comment {
  id       String           @id @default(uuid())
  threadId String
  thread   DiscussionThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  content  String
  status   CommentStatus    @default(ACTIVE)

  /// Null for top-level comments; set for replies.
  parentId String?
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies  Comment[] @relation("CommentReplies")

  authorId  String
  author    User      @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  editedAt  DateTime?
  deletedAt DateTime?

  reactions         CommentReaction[]
  reports           ContentReport[]
  moderationActions ModerationAction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([threadId, parentId, createdAt])
  @@index([authorId])
  @@index([parentId])
  @@index([status])
}

/// A user's report of a thread or comment for moderation. Exactly one of
/// threadId / commentId is set (CHECK constraint). One report per user per item.
model ContentReport {
  id              String            @id @default(uuid())
  reporterId      String
  reporter        User              @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  threadId        String?
  thread          DiscussionThread? @relation(fields: [threadId], references: [id], onDelete: Cascade)
  commentId       String?
  comment         Comment?          @relation(fields: [commentId], references: [id], onDelete: Cascade)
  reason          ReportReason
  details         String?
  /// The reported text as it was when reported (title for threads), so later
  /// edits cannot hide what was reported.
  contentSnapshot String?
  status          ReportStatus      @default(OPEN)
  resolvedAt      DateTime?
  resolvedById    String?
  resolvedBy      User?             @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolutionNote  String?
  createdAt       DateTime          @default(now())

  moderationActions ModerationAction[]

  @@unique([reporterId, threadId])
  @@unique([reporterId, commentId])
  @@index([status, createdAt])
  @@index([commentId])
  @@index([threadId])
  @@index([resolvedById])
}

/// Append-only log of every moderation decision (who, what, why).
model ModerationAction {
  id          String               @id @default(uuid())
  moderatorId String
  moderator   User                 @relation(fields: [moderatorId], references: [id], onDelete: Restrict)
  action      ModerationActionType
  threadId    String?
  thread      DiscussionThread?    @relation(fields: [threadId], references: [id], onDelete: SetNull)
  commentId   String?
  comment     Comment?             @relation(fields: [commentId], references: [id], onDelete: SetNull)
  reportId    String?
  report      ContentReport?       @relation(fields: [reportId], references: [id], onDelete: SetNull)
  reason      String?
  createdAt   DateTime             @default(now())

  @@index([commentId])
  @@index([threadId])
  @@index([moderatorId, createdAt])
  @@index([reportId])
}

model CommentReaction {
  id        String       @id @default(uuid())
  commentId String
  comment   Comment      @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation("CommentReactions", fields: [userId], references: [id], onDelete: Cascade)
  type      ReactionType
  createdAt DateTime     @default(now())

  @@unique([commentId, userId, type])
  @@index([userId])
}

// ═══════════════════════════════════════════════════════════════════════════════
// Study groups (admin-managed cohorts)
// ═══════════════════════════════════════════════════════════════════════════════

model StudyGroup {
  id          String  @id @default(uuid())
  name        String
  description String
  tags        String?
  isActive    Boolean @default(true)

  createdById String
  createdBy   User   @relation("StudyGroupCreator", fields: [createdById], references: [id])

  members StudyGroupMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([createdById])
}

model StudyGroupMember {
  id          String     @id @default(uuid())
  groupId     String
  group       StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId      String
  user        User       @relation("StudyGroupMemberships", fields: [userId], references: [id], onDelete: Cascade)
  /// Role within this group only — does not affect global authorization.
  groupRole   GroupRole  @default(STUDENT)
  joinedAt    DateTime   @default(now())
  removedAt   DateTime?
  removedById String?

  @@unique([groupId, userId])
  @@index([userId])
}

// ═══════════════════════════════════════════════════════════════════════════════
// Notifications & e-mail
// ═══════════════════════════════════════════════════════════════════════════════

model Notification {
  id        String               @id @default(uuid())
  userId    String
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  NotificationCategory
  /// Machine-readable event type, e.g. "assignment.published".
  type      String
  title     String
  body      String
  /// Ids the frontend needs to deep-link (assignmentId, submissionId, …).
  data      Json?
  /// Frontend path to open, e.g. "/assignments/123".
  link      String?
  readAt    DateTime?
  createdAt DateTime             @default(now())

  @@index([userId, readAt])
  /// The inbox: a user's notifications, newest first.
  @@index([userId, createdAt])
  @@index([createdAt])
}

model NotificationPreference {
  id           String               @id @default(uuid())
  userId       String
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  category     NotificationCategory
  emailEnabled Boolean              @default(true)
  updatedAt    DateTime             @updatedAt

  @@unique([userId, category])
}

/// Per-notification-type switches that admins and mentors set in their
/// profile settings (in-app and e-mail separately). No row means the default:
/// both on. The configurable types are listed in notification-types.ts.
model NotificationSetting {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Notification type, e.g. "submissions.assigned".
  type         String
  inAppEnabled Boolean  @default(true)
  emailEnabled Boolean  @default(true)
  updatedAt    DateTime @updatedAt

  @@unique([userId, type])
  /// Sending looks up the recipients who turned a type off.
  @@index([type, userId])
}

/// Decision notifications (owner-approved): one row per event and recipient, written in the SAME
/// transaction as the Administrator's action, so it exists if and only if that action committed.
/// The e-mail is sent after commit (src/decision-notifications); a failure only marks the row FAILED
/// with a backoff (nextAttemptAt) — it never undoes the action. dedupeKey makes a repeated action or
/// delivery a no-op. While SENDING, nextAttemptAt is the end of the claim's lease: a row still SENDING
/// after it (a crashed sender) is recovered by the retry sweep. payload holds only what the message needs.
model NotificationOutbox {
  id                  String                   @id @default(uuid())
  /// Event type, e.g. "teacher.application.approved".
  type                String
  dedupeKey           String                   @unique
  recipientUserId     String?
  recipientUser       User?                    @relation(fields: [recipientUserId], references: [id], onDelete: SetNull)
  recipientEmail      String
  firstName           String
  entityType          String
  entityId            String
  payload             Json
  status              NotificationOutboxStatus @default(PENDING)
  attempts            Int                      @default(0)
  /// Sanitised (no addresses, keys or tokens), at most 500 characters.
  lastError           String?
  /// When the next automatic attempt is due (NULL: none — sent, or retries exhausted).
  nextAttemptAt       DateTime?                @default(now())
  createdAt           DateTime                 @default(now())
  sentAt              DateTime?
  /// The in-app Notification written with this row (recipients with an account).
  inAppNotificationId String?

  /// The retry sweep: due rows by status.
  @@index([status, nextAttemptAt])
  @@index([recipientUserId])
  @@index([type, createdAt])
  @@index([createdAt])
}

/// One per admin bulk-send request.
model EmailJob {
  id              String         @id @default(uuid())
  /// Caller-supplied key; re-submitting the same key is a safe no-op.
  idempotencyKey  String         @unique
  subject         String
  /// Stored to allow retry. Never written to audit logs.
  body            String
  status          EmailJobStatus @default(PENDING)
  totalRecipients Int
  sentCount       Int            @default(0)
  failedCount     Int            @default(0)
  createdById     String
  createdBy       User           @relation("EmailJobCreator", fields: [createdById], references: [id])
  completedAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  deliveries EmailDelivery[]

  @@index([createdById])
  @@index([status])
}

/// Outbox for every outgoing e-mail (bulk-job recipients and transactional
/// notifications). A background worker claims PENDING rows with
/// FOR UPDATE SKIP LOCKED, so it is safe with several API instances.
model EmailDelivery {
  id             String              @id @default(uuid())
  /// Set for bulk-job deliveries; null for transactional e-mails.
  jobId          String?
  job            EmailJob?           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  recipientEmail String
  recipientId    String?
  /// Transactional e-mails carry their own subject/body; bulk deliveries use the job's.
  subject        String?
  /// Plain-text version. Cleared once a transactional e-mail is delivered (it may carry a one-time link).
  body           String?
  /// Branded HTML version (transactional e-mails); cleared together with body.
  html           String?
  status         EmailDeliveryStatus @default(PENDING)
  attempts       Int                 @default(0)
  nextAttemptAt  DateTime            @default(now())
  lockedAt       DateTime?
  messageId      String?
  errorMessage   String?
  attemptedAt    DateTime?
  createdAt      DateTime            @default(now())

  @@index([status, nextAttemptAt])
  @@index([jobId, status])
  @@index([recipientEmail])
}

// ═══════════════════════════════════════════════════════════════════════════════
// Administration
// ═══════════════════════════════════════════════════════════════════════════════

/// Key/value system settings. Keys are restricted to an allow-list in code.
model SystemSetting {
  key         String   @id
  value       Json
  updatedById String?
  updatedBy   User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt   DateTime @updatedAt

  @@index([updatedById])
}

/// The public and registration forms whose availability administrators control (docs/operations/forms.md).
enum FormKey {
  STUDENT_REGISTRATION
  TEACHER_REGISTRATION
  COACH_APPLICATION
  CONTACT
}

/// How a form's availability is decided: always open (until closesAt), always closed, or by its schedule.
enum FormMode {
  OPEN
  CLOSED
  SCHEDULED
}

/// Availability, schedule and closed-form message of one form: the single source of truth (it replaces the
/// registration.studentSelfSignup and registration.teacherSelfSignup switches, which now read and write it).
/// Times are UTC instants; they are shown in Africa/Kigali. A null message, instructions or contact means the
/// built-in default (FORM_DEFAULTS).
model FormAvailability {
  key           FormKey   @id
  mode          FormMode
  opensAt       DateTime?
  closesAt      DateTime?
  closedMessage String?
  instructions  String?
  contactEmail  String?
  supportUrl    String?
  updatedById   String?
  updatedBy     User?     @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([updatedById])
}

/// How a programme membership was created.
enum MembershipSource {
  /// Phase 1 backfill of existing students and coaches (migration M3).
  BACKFILL
  /// Added afterwards (account creation while one programme exists, or by an administrator).
  MANUAL
}

/// A user's membership of a programme (programme = Discipline; plan §7.1).
/// Read only by Head Coach and Teacher scope (P1-10/P1-11): student access
/// stays division-based and coach access MentorAssignment-based. One row per
/// user × programme, ended and re-activated by update (like MentorAssignment).
model ProgrammeMembership {
  id           String           @id @default(uuid())
  userId       String
  user         User             @relation("ProgrammeMember", fields: [userId], references: [id], onDelete: Cascade)
  disciplineId String
  discipline   Discipline       @relation(fields: [disciplineId], references: [id], onDelete: Restrict)
  source       MembershipSource
  isActive     Boolean          @default(true)
  addedById    String?
  addedBy      User?            @relation("ProgrammeMemberAddedBy", fields: [addedById], references: [id], onDelete: SetNull)
  createdAt    DateTime         @default(now())
  endedAt      DateTime?
  endedById    String?
  endedBy      User?            @relation("ProgrammeMemberEndedBy", fields: [endedById], references: [id], onDelete: SetNull)

  @@unique([userId, disciplineId])
  @@index([disciplineId, isActive])
  @@index([addedById])
  @@index([endedById])
}

/// Whether an individual override adds or removes a permission.
enum OverrideEffect {
  GRANT
  DENY
}

/// An individual permission override (P1-09, plan §6.3/§6.4): set by a Super
/// Admin only, validated against the approved list in code, applied on every
/// authorization decision while `revokedAt` is null and `expiresAt` is in the
/// future (or null). A GRANT applies only inside the target's existing scope
/// (courseId × divisionId for a teacher's assignments.prepare). Never deleted:
/// revocation is soft and the history is kept.
model UserPermissionOverride {
  id               String                          @id @default(uuid())
  userId           String
  user             User                            @relation("OverrideTarget", fields: [userId], references: [id], onDelete: Cascade)
  permission       String
  effect           OverrideEffect
  /// GRANT scope (course × division); null for DENY.
  courseId         String?
  course           Course?                         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  divisionId       String?
  division         Division?                       @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  reason           String
  expiresAt        DateTime?
  createdById      String?
  createdBy        User?                           @relation("OverrideCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt        DateTime                        @default(now())
  revokedAt        DateTime?
  revokedById      String?
  revokedBy        User?                           @relation("OverrideRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)
  revokeReason     String?
  /// When the expiry was recorded in the audit log (record only; the override stopped applying at expiresAt).
  expiryRecordedAt DateTime?
  /// Teacher delegations only: which students it covers (existing delegations: SCHOOL). Null on other overrides.
  studentScope     DelegationStudentScope?
  /// SELECTED scope: the listed students (history kept).
  students         UserPermissionOverrideStudent[]
  /// Set when a listed student left the teacher's scope (TS-5): an Administrator should review the delegation.
  reviewNeededAt   DateTime?
  reviewReason     String?

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@index([createdById])
  @@index([revokedById])
  @@index([courseId])
  @@index([divisionId])
}

/// Append-only: a database trigger rejects UPDATE and DELETE (the only
/// permitted change is the foreign key clearing actorId when an account is
/// deleted). There are no API routes that modify audit records.
model AuditLog {
  id            String   @id @default(uuid())
  actorId       String?
  actorRole     String?
  actor         User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  /// The actor's username at the time, filled in by the database on insert, so
  /// the record still says who acted if the account is later deleted.
  actorUsername String?
  action        String
  entity        String
  entityId      String?
  metadata      Json?
  createdAt     DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([entity, entityId])
  @@index([createdAt])
}

/// Learning activity (what students and mentors do), used for analytics and
/// engagement reports. Security-relevant changes go to AuditLog instead.
/// Retention: rows older than 400 days are purged nightly.
model ActivityLog {
  id         String       @id @default(uuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       ActivityType
  courseId   String?
  course     Course?      @relation(fields: [courseId], references: [id], onDelete: SetNull)
  entityType String?
  entityId   String?
  metadata   Json?
  createdAt  DateTime     @default(now())

  @@index([userId, createdAt])
  @@index([courseId, type, createdAt])
  @@index([type, createdAt])
}

// ─── Public contact form ─────────────────────────────────────────────────────

enum ContactMessageStatus {
  NEW
  HANDLED
}

/// A message sent from the public homepage's contact form (POST /public/contact).
/// Only administrators can read it (GET /admin/contact-messages).
model ContactMessage {
  id           String               @id @default(uuid())
  fullName     String
  email        String
  subject      String
  message      String
  status       ContactMessageStatus @default(NEW)
  /// "QUEUED" when an e-mail notice was queued to platform.supportEmail, "NOT_CONFIGURED" when no support e-mail is set.
  notification String
  /// Keyed SHA-256 of the sender's IP address: only used for abuse limits, never shown.
  ipHash       String?
  handledAt    DateTime?
  /// The administrator who marked it handled (no foreign key: kept if that account is deleted).
  handledById  String?
  createdAt    DateTime             @default(now())

  @@index([status, createdAt])
  @@index([email, createdAt])
  @@index([ipHash, createdAt])
}

/// A teacher's role at a school (owner decision 2026-11-19). PRIMARY: the school's designated main
/// contact (at most one active per school). Never a permission: primary and secondary teachers have
/// exactly the same rights.
enum TeacherSchoolRole {
  PRIMARY
  SECONDARY
}

/// A Teacher's school (P1-11): the teacher sees only students whose school is one of
/// their ACTIVE assignments. Set by Administrators (users.manageTeachers); one row per
/// (teacher, school), ended / re-activated by update (same pattern as ProgrammeMembership).
/// `role` (owner decision 2026-11-19): PRIMARY marks the school's designated main contact — the same
/// rights as every other teacher of the school. At most one ACTIVE PRIMARY per school: partial unique
/// index TeacherSchoolAssignment_one_primary_per_school (schoolId) WHERE isActive AND role = 'PRIMARY'
/// (migration 20261212000000). An ended link, or one whose account leaves ACTIVE, is SECONDARY.
model TeacherSchoolAssignment {
  id           String            @id @default(uuid())
  teacherId    String
  teacher      User              @relation("TeacherSchool", fields: [teacherId], references: [id], onDelete: Cascade)
  schoolId     String
  school       School            @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  isActive     Boolean           @default(true)
  role         TeacherSchoolRole @default(SECONDARY)
  assignedById String?
  assignedBy   User?             @relation("TeacherSchoolAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)
  createdAt    DateTime          @default(now())
  endedAt      DateTime?
  endedById    String?
  endedBy      User?             @relation("TeacherSchoolEndedBy", fields: [endedById], references: [id], onDelete: SetNull)

  @@unique([teacherId, schoolId])
  @@index([schoolId, isActive])
  @@index([assignedById])
  @@index([endedById])
}

/// Student–school affiliation (P1-11 follow-up, PR A): whether an Administrator has
/// verified that a student genuinely belongs to a school. Choosing a school at sign-up,
/// account approval or e-mail verification are NOT proof of membership.
enum SchoolAffiliationStatus {
  PENDING
  VERIFIED
  REJECTED
  REVOKED
}

/// How a claim was created.
enum SchoolAffiliationSource {
  REGISTRATION
  ADMIN
  MIGRATION
  STUDENT_REQUEST
}

/// One row per claim (history and current state). The CURRENT claim of a student is the one
/// with supersededAt NULL — at most one, written only by SchoolAffiliationService under a
/// per-student lock. Teacher access requires a current VERIFIED claim for the student's school.
model StudentSchoolAffiliation {
  id              String                  @id @default(uuid())
  studentId       String
  student         User                    @relation("AffiliationStudent", fields: [studentId], references: [id], onDelete: Cascade)
  /// The canonical school; NULL while the school is not yet resolved (international, unmatched or not listed).
  schoolId        String?
  school          School?                 @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  claimedName     String?
  claimedCountry  String?
  claimedProvince String?
  claimedDistrict String?
  claimedSector   String?
  status          SchoolAffiliationStatus @default(PENDING)
  source          SchoolAffiliationSource
  createdById     String?
  createdBy       User?                   @relation("AffiliationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime                @default(now())
  decidedById     String?
  decidedBy       User?                   @relation("AffiliationDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt       DateTime?
  /// Verification note or rejection reason (a rejection reason is shown to the student).
  decisionReason  String?
  revokedById     String?
  revokedBy       User?                   @relation("AffiliationRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)
  revokedAt       DateTime?
  revokeReason    String?
  supersededAt    DateTime?
  supersededById  String?
  supersededBy    User?                   @relation("AffiliationSupersededBy", fields: [supersededById], references: [id], onDelete: SetNull)
  /// SCHOOL_CHANGE, ROLE_CHANGE or NEW_CLAIM.
  supersedeReason String?

  @@index([studentId, supersededAt])
  @@index([schoolId, status])
  @@index([status])
  @@index([createdById])
  @@index([decidedById])
  @@index([revokedById])
  @@index([supersededById])
}

/// One change of a user's account state (2026-11-16), with its reason and who made it. Never deleted with the
/// account's normal administration; the matching AuditLog row (USER_STATUS_CHANGED) is written in the same transaction.
model UserStatusChange {
  id          String        @id @default(uuid())
  userId      String
  user        User          @relation("StatusChangeUser", fields: [userId], references: [id], onDelete: Restrict)
  fromStatus  AccountStatus
  toStatus    AccountStatus
  reason      String?
  actorId     String?
  actor       User?         @relation("StatusChangeActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorRole   String
  /// The bulk operation that made this change, if any.
  operationId String?
  requestId   String?
  createdAt   DateTime      @default(now())

  @@index([userId, createdAt])
  @@index([operationId])
}

/// A bulk action on many accounts (2026-11-17; docs/operations/bulk-user-operations.md). The selection is resolved on
/// the server when the operation is created and snapshotted into its items; a worker processes the items in batches.
model BulkOperation {
  id             String              @id @default(uuid())
  actorId        String?
  actor          User?               @relation("BulkOperationActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorRole      String
  /// The record type (src/bulk: USER, …). Every operation before 2026-11-19 is USER.
  entityType     String              @default("USER")
  /// One of the record type's actions (USER: activate | deactivate | suspend | archive | restore | assignRole | …)
  action         String
  /// The action's parameters (role, gradeLevel, subject…) — never a password or other secret.
  params         Json
  /// { mode: 'ids', ids } or { mode: 'filter', filter } as confirmed by the administrator.
  selection      Json
  /// The confirmation the administrator executed with (v2: signed, bound to them, the action, its parameters, the
  /// selection and the exact matching record ids; v1 before 2026-11-19: an unsigned digest of the same minus the actor).
  /// A v2 confirmation creates at most one operation: partial unique index BulkOperation_selectionToken_v2_key
  /// (selectionToken) WHERE selectionToken LIKE 'v2.%' (migration 20261222000000; not expressible in this schema).
  selectionToken String
  reason         String?
  status         BulkOperationStatus @default(PENDING)
  total          Int
  succeeded      Int                 @default(0)
  failed         Int                 @default(0)
  skipped        Int                 @default(0)
  idempotencyKey String
  /// The bulk e-mail job of a 'message' operation (one delivery per user, created with that user's item).
  emailJobId     String?             @unique
  requestId      String?
  createdAt      DateTime            @default(now())
  startedAt      DateTime?
  finishedAt     DateTime?
  cancelledAt    DateTime?

  items BulkOperationItem[]

  @@unique([actorId, idempotencyKey])
  @@index([status, createdAt])
  @@index([actorId, createdAt])
}

/// One record in a bulk operation: unique per (operation, record), so a record is processed — and notified — at most once.
model BulkOperationItem {
  id             String          @id @default(uuid())
  operationId    String
  operation      BulkOperation   @relation(fields: [operationId], references: [id], onDelete: Cascade)
  /// The record (its id in the operation's entityType table). An INSERT without it takes userId (trigger
  /// bulk_item_entity_from_user: the previous release's code during a rolling deploy).
  entityId       String
  /// USER items: the account (= entityId). Null for every other record type.
  userId         String?
  outcome        BulkItemOutcome @default(PENDING)
  code           String?
  message        String?
  /// After a restore or reactivation: conditions that still block sign-in (NOT_ACTIVATED, PENDING_APPROVAL…).
  stillBlockedBy String[]        @default([])
  /// Set when a worker claims the item (PENDING → PROCESSING); only that claim may record the result.
  claimToken     String?
  lockedAt       DateTime?
  processedAt    DateTime?

  @@unique([operationId, userId])
  @@unique([operationId, entityId])
  @@index([operationId, outcome])
}

/// How a teacher–student assignment was made (TS approvals 2026-11-18).
enum TeacherStudentSource {
  ADMIN
  BULK
}

/// Which students a teacher delegation (students.viewProfile, students.viewProgress, submissions.submitOnBehalf)
/// covers: every student the teacher sees through their schools, only students assigned to the teacher, or only the
/// listed students (UserPermissionOverrideStudent). Null on every other override.
enum DelegationStudentScope {
  SCHOOL
  ASSIGNED
  SELECTED
}

/// An Administrator's explicit link between a Teacher and a Student (TS-2: several teachers per student; TS-3: a
/// student outside the teacher's schools only with a reason). One row per pair: re-assigning re-activates it, so
/// duplicates are impossible and history is kept (ended rows stay). Automatic school visibility is NOT stored here.
model TeacherStudentAssignment {
  id           String               @id @default(uuid())
  teacherId    String
  teacher      User                 @relation("TeacherStudentTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  studentId    String
  student      User                 @relation("TeacherStudentStudent", fields: [studentId], references: [id], onDelete: Cascade)
  source       TeacherStudentSource @default(ADMIN)
  /// True when, at assignment time, the student was not a verified student of any of the teacher's active schools.
  crossSchool  Boolean              @default(false)
  reason       String?
  isActive     Boolean              @default(true)
  assignedById String?
  assignedBy   User?                @relation("TeacherStudentAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  endedAt      DateTime?
  endedById    String?
  endedBy      User?                @relation("TeacherStudentEndedBy", fields: [endedById], references: [id], onDelete: SetNull)
  endReason    String?

  @@unique([teacherId, studentId])
  @@index([studentId, isActive])
  @@index([teacherId, isActive])
  @@index([assignedById])
  @@index([endedById])
}

/// The students a SELECTED-scope delegation covers. One row per (override, student): removing keeps the row
/// (removedAt), adding again re-activates it.
model UserPermissionOverrideStudent {
  id           String                 @id @default(uuid())
  overrideId   String
  override     UserPermissionOverride @relation(fields: [overrideId], references: [id], onDelete: Cascade)
  studentId    String
  student      User                   @relation("OverrideSelectedStudent", fields: [studentId], references: [id], onDelete: Cascade)
  addedById    String?
  addedBy      User?                  @relation("OverrideStudentAddedBy", fields: [addedById], references: [id], onDelete: SetNull)
  createdAt    DateTime               @default(now())
  removedAt    DateTime?
  removedById  String?
  removedBy    User?                  @relation("OverrideStudentRemovedBy", fields: [removedById], references: [id], onDelete: SetNull)
  /// ADMIN (removed by an Administrator); ASSIGNMENT_ENDED, SCHOOL_ASSIGNMENT_ENDED or SCHOOL_CLAIM_CHANGED (TS-5: the
  /// teacher no longer sees the student).
  removeReason String?

  @@unique([overrideId, studentId])
  @@index([studentId])
  @@index([addedById])
  @@index([removedById])
}

// ═══════════════════════════════════════════════════════════════════════════════
// Countries (design area 1 as simplified by the owner, 2026-11-19)
// ═══════════════════════════════════════════════════════════════════════════════

/// Every ISO 3166-1 alpha-2 country: where a student, teacher, coach or school is. ROF is a global Olympiad platform with
/// one common structure (S1–S6; S1–S3 Junior, S4–S6 Senior): a country never determines a level or division, and no
/// country is ever blocked from registration. Administrators correct a name or calling code (reference.manage).
model Country {
  /// ISO 3166-1 alpha-2, e.g. "RW".
  code        String   @id
  name        String
  /// International calling code, e.g. "+250" (NULL for territories without one).
  phonePrefix String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  schools School[]
}

// ═══════════════════════════════════════════════════════════════════════════════
// Test Management (WS3; owner spec and plan approved 2026-11-19). NEW tables — the
// course-assignment pipeline (Assignment, Submission, MentorReview …) is untouched.
// Migration 20261220000100_tests_core.
// ═══════════════════════════════════════════════════════════════════════════════

/// Who a test is for: Junior (S1–S3), Senior (S4–S6) or All. Mandatory; default ALL.
enum TestDivision {
  JUNIOR
  SENIOR
  ALL
  /// Olympiad levels (owner 2026-11-21): a test for the students whose Olympiad level is MIDDLE.
  MIDDLE
}

/// A student's Olympiad level (owner 2026-11-21) — separate from the school grade. Suggested from the grade
/// (S1–S2 Junior, S3–S4 Middle, S5–S6 Senior) by the database trigger `olympiad_level_from_grade`, unless a Coach or a
/// User Manager set it by hand. Test eligibility, the teacher's lists and the rankings use it.
enum OlympiadLevel {
  JUNIOR
  MIDDLE
  SENIOR
}

/// Why a student's Olympiad level changed.
enum OlympiadLevelChangeSource {
  /// Followed the school grade (sign-up, a grade change, a new academic year): written by the database trigger.
  GRADE
  /// Set by hand by a Coach or a User Manager, with a reason.
  MANUAL
  /// Back to following the grade (the suggested level), by a Coach or a User Manager.
  AUTOMATIC
  /// The level every student had when Olympiad levels were introduced (their former test division).
  BACKFILL
}

/// How students answer (enforced from Phase 2): uploaded pages only, typed answers only, or both.
enum TestAnswerFormat {
  UPLOAD_ONLY
  TYPED_ONLY
  BOTH
}

/// DRAFT: being prepared (may be deleted). PUBLISHED: released to students (they see it from Phase 2).
enum TestStatus {
  DRAFT
  PUBLISHED
}

enum TestFileKind {
  PAPER
  MARKING_GUIDE
}

/// A test of one subject (Discipline). Whole-number marks (G7). CHECK constraints: maxMarks > 0, opensAt < closesAt.
/// originalClosesAt: the deadline when the test was first published (it follows closesAt while the test is a draft that
/// was never published) — kept unchanged when the deadline later moves.
model Test {
  id                     String           @id @default(uuid())
  title                  String
  disciplineId           String
  discipline             Discipline       @relation(fields: [disciplineId], references: [id], onDelete: Restrict)
  division               TestDivision     @default(ALL)
  answerFormat           TestAnswerFormat
  opensAt                DateTime
  closesAt               DateTime
  originalClosesAt       DateTime
  maxMarks               Int
  status                 TestStatus       @default(DRAFT)
  /// First publication (never cleared); from then on originalClosesAt is frozen.
  publishedAt            DateTime?
  /// Phase 4 (DESIGN ONLY, owner spec 10.3): a future option to show the internal rankings to students. Always false —
  /// the CHECK Test_student_rankings_design_only refuses true, and no route reads or changes it; enabling it later is a
  /// migration that drops the CHECK plus a reviewed change of the student results view (STUDENT_RANKINGS_ENABLED).
  studentRankingsVisible Boolean          @default(false)
  createdById            String?
  createdBy              User?            @relation("TestCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  questions    TestQuestion[]
  files        TestFile[]
  extensions   TestExtension[]
  submissions  TestSubmission[]
  answerPages  TestAnswerPage[]
  publications TestPublication[]

  @@index([disciplineId, status])
  @@index([createdById])
  @@index([opensAt])
}

/// An optional question of a test. When a test has questions, their maxMarks add up exactly to Test.maxMarks before it can
/// be published (enforced by the service; a draft may be incomplete but never exceed). CHECK: maxMarks > 0, order >= 1.
model TestQuestion {
  id        String   @id @default(uuid())
  testId    String
  test      Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  order     Int
  prompt    String
  maxMarks  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  markingScores TestMarkingScore[]
  markChanges   TestMarkChange[]

  @@unique([testId, order])
}

/// A test's question paper or marking guide: at most one of each kind per test (replaced, not versioned).
model TestFile {
  id        String       @id @default(uuid())
  testId    String
  test      Test         @relation(fields: [testId], references: [id], onDelete: Cascade)
  fileId    String
  file      FileObject   @relation(fields: [fileId], references: [id], onDelete: Restrict)
  kind      TestFileKind
  createdAt DateTime     @default(now())

  @@unique([testId, kind])
  @@index([fileId])
}

/// A coach (MENTOR) authorised to mark a subject's tests, granted by an Administrator or one of the subject's Head Coaches.
/// Separate from the coach's olympiadInterests: an interest NEVER grants marking. Revoked (with a reason), never deleted.
/// At most one ACTIVE (revokedAt IS NULL) per coach and subject: partial unique index
/// MarkerAuthorization_one_active_per_coach_subject. CHECK: revokedAt and revokeReason are set together.
model MarkerAuthorization {
  id           String     @id @default(uuid())
  coachId      String
  coach        User       @relation("MarkerCoach", fields: [coachId], references: [id], onDelete: Cascade)
  disciplineId String
  discipline   Discipline @relation(fields: [disciplineId], references: [id], onDelete: Restrict)
  grantedById  String?
  grantedBy    User?      @relation("MarkerGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)
  grantedAt    DateTime   @default(now())
  grantReason  String?
  revokedAt    DateTime?
  revokedById  String?
  revokedBy    User?      @relation("MarkerRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)
  revokeReason String?

  @@index([disciplineId, revokedAt])
  @@index([coachId, revokedAt])
  @@index([grantedById])
  @@index([revokedById])
}

// ═══════════════════════════════════════════════════════════════════════════════
// Test Management, Phase 2 (WS3): deadlines, extensions, submissions and their versions.
// Migration 20261220000200_tests_submissions. Deadlines are computed by ONE service
// (TestDeadlineService) from database time only.
// ═══════════════════════════════════════════════════════════════════════════════

/// TEST: every student of the test; STUDENT: one student (whoever submits for them); TEACHER: one teacher's own
/// submissions for the students of their schools.
enum TestExtensionKind {
  TEST
  STUDENT
  TEACHER
}

/// The approved status flow (owner spec): SUBMITTED → ASSIGNED → MARKING_IN_PROGRESS → MARKED (awaiting approval) →
/// APPROVED → PUBLISHED, plus RETURNED (for correction) and AWAITING_SECOND_MARKING. Phase 2 writes SUBMITTED only; the
/// allowed transitions arrive with marking (Phase 3). Every change is kept in TestSubmissionStatusChange.
enum TestSubmissionStatus {
  SUBMITTED
  ASSIGNED
  MARKING_IN_PROGRESS
  MARKED
  APPROVED
  PUBLISHED
  RETURNED
  AWAITING_SECOND_MARKING
}

/// Who submitted a version: the student, or a teacher of the student's school (G2).
enum TestSubmitterRole {
  STUDENT
  TEACHER
}

/// A deadline extension (Administrator or the subject's Head Coach). The test's own closesAt / originalClosesAt never
/// change. At most one ACTIVE (cancelledAt IS NULL) extension per target: partial unique indexes
/// TestExtension_one_active_test / _student / _teacher. CHECK: the target matches the kind; a cancellation has its time
/// and its reason. Edited or cancelled only before it expires (newDeadline, database time).
model TestExtension {
  id            String            @id @default(uuid())
  testId        String
  test          Test              @relation(fields: [testId], references: [id], onDelete: Cascade)
  kind          TestExtensionKind
  studentId     String?
  student       User?             @relation("TestExtensionStudent", fields: [studentId], references: [id], onDelete: Cascade)
  teacherId     String?
  teacher       User?             @relation("TestExtensionTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  newDeadline   DateTime
  /// Mandatory; the latest reason (an edit gives a new one; the audit log keeps every one).
  reason        String
  grantedById   String?
  grantedBy     User?             @relation("TestExtensionGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)
  grantedAt     DateTime          @default(now())
  editedAt      DateTime?
  editedById    String?
  editedBy      User?             @relation("TestExtensionEditedBy", fields: [editedById], references: [id], onDelete: SetNull)
  cancelledAt   DateTime?
  cancelledById String?
  cancelledBy   User?             @relation("TestExtensionCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  cancelReason  String?

  @@index([testId, cancelledAt])
  @@index([studentId])
  @@index([teacherId])
  @@index([grantedById])
  @@index([editedById])
  @@index([cancelledById])
}

/// One per student per test. publicCode: opaque (random, no identity), the only identifier markers will see (Phase 3).
/// currentVersionId: the version markers work on. Never deleted (a test with submissions cannot be deleted or
/// unpublished; the foreign keys RESTRICT).
model TestSubmission {
  id               String                 @id @default(uuid())
  testId           String
  test             Test                   @relation(fields: [testId], references: [id], onDelete: Restrict)
  studentId        String
  student          User                   @relation("TestSubmissionStudent", fields: [studentId], references: [id], onDelete: Restrict)
  publicCode       String                 @unique
  status           TestSubmissionStatus   @default(SUBMITTED)
  currentVersionId String?                @unique
  currentVersion   TestSubmissionVersion? @relation("TestSubmissionCurrentVersion", fields: [currentVersionId], references: [id], onDelete: Restrict)
  versionCount     Int                    @default(0)
  firstSubmittedAt DateTime?
  lastSubmittedAt  DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  /// The student's Olympiad level when the submission was first made (owner 2026-11-21): the ranking group, so a later
  /// change of level never moves a result. Null for submissions made before levels existed (then: the current level).
  level            OlympiadLevel?

  /// Phase 3: the marking whose marks count (set by approval of a single marking, or by the Head Coach's choice of
  /// first / second / adjusted marks; cleared when a marking is returned or a second marking is requested).
  finalMarkingId String?      @unique
  finalMarking   TestMarking? @relation("TestSubmissionFinalMarking", fields: [finalMarkingId], references: [id], onDelete: Restrict)

  /// Phase 4: the publication that made this result visible to the student and their school's teachers — set exactly
  /// while the status is PUBLISHED (CHECK); cleared when an unlock withdraws it (G6, TestResultWithdrawal).
  publicationId String?
  publication   TestPublication? @relation("TestSubmissionPublication", fields: [publicationId], references: [id], onDelete: Restrict)
  publishedAt   DateTime?

  versions                   TestSubmissionVersion[]         @relation("TestSubmissionVersions")
  statusChanges              TestSubmissionStatusChange[]
  markerAssignments          TestMarkerAssignment[]
  markings                   TestMarking[]                   @relation("TestSubmissionMarkings")
  reviews                    TestReview[]
  withdrawals                TestResultWithdrawal[]
  /// Owner 2026-11-21: a submitted answer is locked; an Administrator may authorize one replacement at a time.
  resubmissionAuthorizations TestResubmissionAuthorization[]

  @@unique([testId, studentId])
  @@index([studentId])
  @@index([testId, status])
  @@index([publicationId])
}

/// EVERY version of a submission, kept for ever (append-only: trigger test_submission_version_append_only). submittedAt
/// is database time; applicableDeadline is the deadline that applied at that moment (TestDeadlineService);
/// underExtension: accepted after the test's own closesAt thanks to an extension (extensionId). clientKey makes a repeated
/// request idempotent (one version per key). CHECK: a TEACHER version names the teacher (the submitter); a version has a
/// typed answer or pages.
model TestSubmissionVersion {
  id                 String            @id @default(uuid())
  submissionId       String
  submission         TestSubmission    @relation("TestSubmissionVersions", fields: [submissionId], references: [id], onDelete: Restrict)
  number             Int
  clientKey          String
  submittedById      String
  submittedBy        User              @relation("TestVersionSubmitter", fields: [submittedById], references: [id], onDelete: Restrict)
  submitterRole      TestSubmitterRole
  teacherId          String?
  teacher            User?             @relation("TestVersionTeacher", fields: [teacherId], references: [id], onDelete: Restrict)
  submittedAt        DateTime
  applicableDeadline DateTime
  underExtension     Boolean
  /// The extension that gave the applicable deadline (historical reference; no foreign key).
  extensionId        String?
  typedAnswer        String?
  pageCount          Int               @default(0)

  currentOf                 TestSubmission?                @relation("TestSubmissionCurrentVersion")
  pages                     TestAnswerPage[]
  /// The Administrator's resubmission authorization this replacement used (owner 2026-11-21), if any.
  resubmissionAuthorization TestResubmissionAuthorization? @relation("ResubmissionUsedVersion")
  markings                  TestMarking[]

  @@unique([submissionId, number])
  @@unique([submissionId, clientKey])
  @@index([submittedById])
  @@index([teacherId])
}

/// One uploaded answer page (FilePurpose TEST_ANSWER: PDF or image, 20 MB). Pages are uploaded one at a time under the
/// client's uploadKey and belong to that PENDING upload (versionId NULL) until a submission commits them: then versionId
/// is set and the page never changes again (trigger test_answer_page_committed_guard). Re-uploading a pending page number
/// replaces it (a weak connection retries one page).
model TestAnswerPage {
  id           String                 @id @default(uuid())
  testId       String
  test         Test                   @relation(fields: [testId], references: [id], onDelete: Cascade)
  studentId    String
  student      User                   @relation("TestAnswerPageStudent", fields: [studentId], references: [id], onDelete: Cascade)
  uploadKey    String
  pageNumber   Int
  fileId       String                 @unique
  file         FileObject             @relation(fields: [fileId], references: [id], onDelete: Restrict)
  uploadedById String
  uploadedBy   User                   @relation("TestAnswerPageUploader", fields: [uploadedById], references: [id], onDelete: Cascade)
  uploaderRole TestSubmitterRole
  versionId    String?
  version      TestSubmissionVersion? @relation(fields: [versionId], references: [id], onDelete: Restrict)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@unique([testId, studentId, uploadKey, pageNumber])
  @@index([versionId, pageNumber])
  @@index([studentId])
  @@index([uploadedById])
}

/// Append-only status history of a submission (trigger test_submission_status_append_only; the only permitted change is
/// actorId becoming NULL when the account is deleted).
model TestSubmissionStatusChange {
  id           String                @id @default(uuid())
  submissionId String
  submission   TestSubmission        @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  fromStatus   TestSubmissionStatus?
  toStatus     TestSubmissionStatus
  actorId      String?
  actor        User?                 @relation("TestSubmissionStatusActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorRole    String
  reason       String?
  createdAt    DateTime              @default(now())

  @@index([submissionId, createdAt])
  @@index([actorId])
}

// ═══════════════════════════════════════════════════════════════════════════════
// Test Management, Phase 3 (WS3): distribution to markers, blind marking, second marking, review, approval, locking,
// the mark-change log. Migration 20261220000300_tests_marking. Publication belongs to Phase 4.
// ═══════════════════════════════════════════════════════════════════════════════

/// FIRST: the normal marking (one marker); SECOND: an independent, blind second marking requested by a reviewer;
/// ADJUSTMENT: marks entered by the subject's Head Coach when choosing an adjusted mark (G4: never an Administrator).
enum TestMarkingKind {
  FIRST
  SECOND
  ADJUSTMENT
}

/// DRAFT (being marked) → SUBMITTED (for approval) → APPROVED (locked); RETURNED (for correction, editable again by its
/// marker). The marks of a SUBMITTED or APPROVED marking never change (trigger test_marking_locked_guard).
enum TestMarkingStatus {
  DRAFT
  SUBMITTED
  RETURNED
  APPROVED
}

/// What a reviewer (Administrator or the subject's Head Coach) decided. RETURNED, MARK_CHOSEN and UNLOCKED carry a
/// mandatory comment / reason (CHECK). MARK_CHOSEN: subject Head Coach only (G4).
enum TestReviewAction {
  APPROVED
  RETURNED
  SECOND_MARKING_REQUESTED
  MARK_CHOSEN
  UNLOCKED
}

/// A submission given to a coach to mark (FIRST or SECOND). The current one has endedAt NULL (at most one per submission
/// and kind: partial unique index TestMarkerAssignment_one_current); a reassignment ends it (who, when, why) and starts a
/// new one, so the history is complete. Rows are never deleted; once ended, never changed (trigger).
model TestMarkerAssignment {
  id           String          @id @default(uuid())
  submissionId String
  submission   TestSubmission  @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  kind         TestMarkingKind
  coachId      String
  coach        User            @relation("TestMarkerAssignmentCoach", fields: [coachId], references: [id], onDelete: Restrict)
  assignedById String?
  assignedBy   User?           @relation("TestMarkerAssignmentAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)
  assignedAt   DateTime
  /// MANUAL, DISTRIBUTION, REASSIGNMENT or SECOND_MARKING, and the reason when one was given.
  method       String
  reason       String?
  endedAt      DateTime?
  endedById    String?
  endedBy      User?           @relation("TestMarkerAssignmentEndedBy", fields: [endedById], references: [id], onDelete: SetNull)
  endReason    String?

  marking TestMarking?

  @@index([submissionId, kind])
  @@index([coachId, endedAt])
  @@index([assignedById])
  @@index([endedById])
}

/// One marking of one submission (the version it was made on): per-question scores (TestMarkingScore) when the test has
/// questions, otherwise one total. Whole marks (G7), never above the maxima (CHECK and triggers). version increases on
/// every save (optimistic concurrency).
model TestMarking {
  id           String                @id @default(uuid())
  submissionId String
  submission   TestSubmission        @relation("TestSubmissionMarkings", fields: [submissionId], references: [id], onDelete: Restrict)
  kind         TestMarkingKind
  /// FIRST / SECOND: the assignment it belongs to (one marking per assignment); ADJUSTMENT: none.
  assignmentId String?               @unique
  assignment   TestMarkerAssignment? @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  markerId     String
  marker       User                  @relation("TestMarkingMarker", fields: [markerId], references: [id], onDelete: Restrict)
  versionId    String
  version      TestSubmissionVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  status       TestMarkingStatus     @default(DRAFT)
  totalMarks   Int?
  comment      String?
  revision     Int                   @default(1)
  submittedAt  DateTime?
  approvedAt   DateTime?
  createdAt    DateTime
  updatedAt    DateTime

  scores  TestMarkingScore[]
  changes TestMarkChange[]
  reviews TestReview[]
  finalOf TestSubmission?    @relation("TestSubmissionFinalMarking")

  @@index([submissionId, kind])
  @@index([markerId, status])
  @@index([versionId])
}

/// A question's marks (and comment) in one marking.
model TestMarkingScore {
  id         String       @id @default(uuid())
  markingId  String
  marking    TestMarking  @relation(fields: [markingId], references: [id], onDelete: Restrict)
  questionId String
  question   TestQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict)
  /// NULL: not marked yet (a draft may hold a comment first); a submitted marking has marks for every question.
  marks      Int?
  comment    String?
  updatedAt  DateTime

  @@unique([markingId, questionId])
  @@index([questionId])
}

/// Append-only log of every mark change (trigger test_mark_change_append_only): which marking and question (NULL: the
/// total), old and new marks, who, when, why. The only permitted change is changedById becoming NULL (account deleted).
model TestMarkChange {
  id            String        @id @default(uuid())
  markingId     String
  marking       TestMarking   @relation(fields: [markingId], references: [id], onDelete: Restrict)
  questionId    String?
  question      TestQuestion? @relation(fields: [questionId], references: [id], onDelete: Restrict)
  oldMarks      Int?
  newMarks      Int?
  changedById   String?
  changedBy     User?         @relation("TestMarkChangeActor", fields: [changedById], references: [id], onDelete: SetNull)
  changedByRole String
  reason        String?
  createdAt     DateTime

  @@index([markingId, createdAt])
  @@index([questionId])
  @@index([changedById])
}

/// Append-only review decisions (trigger test_review_append_only): approve, return (comment), request second marking,
/// choose first / second / adjusted marks (reason), unlock (reason). clientKey makes a repeated request idempotent.
model TestReview {
  id           String               @id @default(uuid())
  submissionId String
  submission   TestSubmission       @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  action       TestReviewAction
  markingId    String?
  marking      TestMarking?         @relation(fields: [markingId], references: [id], onDelete: Restrict)
  chosenKind   TestMarkingKind?
  comment      String?
  fromStatus   TestSubmissionStatus
  toStatus     TestSubmissionStatus
  actorId      String?
  actor        User?                @relation("TestReviewActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorRole    String
  clientKey    String?
  createdAt    DateTime

  /// Phase 4 (G6): the withdrawal of a published result this unlock caused.
  withdrawal TestResultWithdrawal?

  @@unique([submissionId, clientKey])
  @@index([submissionId, createdAt])
  @@index([markingId])
  @@index([actorId])
}

// ═══════════════════════════════════════════════════════════════════════════════
// Test Management, Phase 4 (WS3): results publication (Admin override with a reason), withdrawal of a published result
// on unlock (G6). Migration 20261220000400_tests_publishing.
// ═══════════════════════════════════════════════════════════════════════════════

/// One publication of a test's results (append-only: trigger test_publication_append_only): who (Administrator or the
/// subject's Head Coach), when, how many approved results it published, the counts seen at that moment (submissions by
/// status, unapproved, active extensions) and — Administrators only — the override of unapproved results with its
/// mandatory reason (CHECK). Only APPROVED results are published; the others stay hidden. clientKey: a retried request
/// returns the same publication. number: 1, 2, 3 … per test (a later publication adds results approved since).
model TestPublication {
  id             String   @id @default(uuid())
  testId         String
  test           Test     @relation(fields: [testId], references: [id], onDelete: Restrict)
  number         Int
  publishedById  String?
  publishedBy    User?    @relation("TestPublicationActor", fields: [publishedById], references: [id], onDelete: SetNull)
  actorRole      String
  override       Boolean  @default(false)
  overrideReason String?
  publishedCount Int
  counts         Json
  clientKey      String?
  createdAt      DateTime

  submissions TestSubmission[]       @relation("TestSubmissionPublication")
  withdrawals TestResultWithdrawal[]

  @@unique([testId, number])
  @@unique([testId, clientKey])
  @@index([publishedById])
}

/// G6: an unlock of a PUBLISHED result withdraws it from the student's and the teachers' views until it is approved and
/// published again. Append-only (trigger test_result_withdrawal_append_only): which publication it was withdrawn from,
/// the unlock decision (TestReview, one withdrawal per decision), who, when, why (mandatory, CHECK).
model TestResultWithdrawal {
  id            String          @id @default(uuid())
  submissionId  String
  submission    TestSubmission  @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  publicationId String
  publication   TestPublication @relation(fields: [publicationId], references: [id], onDelete: Restrict)
  reviewId      String          @unique
  review        TestReview      @relation(fields: [reviewId], references: [id], onDelete: Restrict)
  withdrawnById String?
  withdrawnBy   User?           @relation("TestResultWithdrawalActor", fields: [withdrawnById], references: [id], onDelete: SetNull)
  actorRole     String
  reason        String
  createdAt     DateTime

  @@index([submissionId, createdAt])
  @@index([publicationId])
  @@index([withdrawnById])
}

/// An Administrator's authorization to replace a LOCKED test submission (owner, 2026-11-21). A submitted answer is locked
/// for the student and their teachers; one open authorization (at most — partial unique index) lets the next version
/// through, which uses it (usedAt, usedVersionId) and is locked again. Never deleted: with the versions it is the history
/// (who authorized, why, when, which replacement). An unused one may be cancelled.
model TestResubmissionAuthorization {
  id             String                 @id @default(uuid())
  submissionId   String
  submission     TestSubmission         @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  authorizedById String?
  authorizedBy   User?                  @relation("ResubmissionAuthorizedBy", fields: [authorizedById], references: [id], onDelete: SetNull)
  /// Why (3–500 characters, CHECK): shown to the student and their teachers with the unlocked submission.
  reason         String
  createdAt      DateTime               @default(now())
  usedAt         DateTime?
  usedVersionId  String?                @unique
  usedVersion    TestSubmissionVersion? @relation("ResubmissionUsedVersion", fields: [usedVersionId], references: [id], onDelete: Restrict)
  cancelledAt    DateTime?
  cancelledById  String?
  cancelledBy    User?                  @relation("ResubmissionCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)

  @@index([submissionId])
  @@index([authorizedById])
  @@index([cancelledById])
}

/// Every change of a student's Olympiad level (owner 2026-11-21): append-only history — who, when, why, from what.
model OlympiadLevelChange {
  id          String                    @id @default(uuid())
  studentId   String
  student     User                      @relation("OlympiadLevelChangeStudent", fields: [studentId], references: [id], onDelete: Cascade)
  fromLevel   OlympiadLevel?
  toLevel     OlympiadLevel?
  /// The school grade at the time (the reason for a GRADE change).
  gradeLevel  GradeLevel?
  source      OlympiadLevelChangeSource
  /// MANUAL / AUTOMATIC: the reason given (3–500 characters).
  reason      String?
  /// MANUAL / AUTOMATIC: who changed it; GRADE / BACKFILL: null (the system).
  changedById String?
  changedBy   User?                     @relation("OlympiadLevelChangeActor", fields: [changedById], references: [id], onDelete: SetNull)
  createdAt   DateTime                  @default(now())

  @@index([studentId, createdAt])
  @@index([changedById])
}
