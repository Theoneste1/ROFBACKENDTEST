datasource db {
  provider = "postgresql"
}

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

// ═══════════════════════════════════════════════════════════════════════════════
// Enums
// ═══════════════════════════════════════════════════════════════════════════════

enum Role {
  STUDENT
  MENTOR
  ADMIN
  // Phase 1 (M1). Not assignable until enabled: TEACHER / HEAD_COACH behind
  // TEACHERS_ENABLED / HEAD_COACHES_ENABLED; SUPER_ADMIN only by the approved
  // bootstrap, never through the user API.
  TEACHER
  HEAD_COACH
  SUPER_ADMIN
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum ActivationPurpose {
  INVITATION
  EMAIL_VERIFICATION
}

/// The two fixed academic divisions.
///   JUNIOR → S1, S2, S3
///   SENIOR → S4, S5, S6
enum DivisionCode {
  JUNIOR
  SENIOR
}

/// Secondary-school grade level. Determines a student's division.
enum GradeLevel {
  S1
  S2
  S3
  S4
  S5
  S6
}

/// Course visibility. ARCHIVED courses are read-only and hidden from students.
enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// Lifecycle of an academic year. Exactly one year is current at a time.
enum AcademicYearStatus {
  PLANNED
  ACTIVE
  CLOSED
}

/// A student's enrolment in one academic year.
///   ACTIVE    – current placement
///   PROMOTED  – moved on to the next grade in a later year
///   GRADUATED – completed S6
///   WITHDRAWN – left the programme
enum StudentEnrollmentStatus {
  ACTIVE
  PROMOTED
  GRADUATED
  WITHDRAWN
}

/**
 * CourseEnrollmentStatus — the student-facing course activity label.
 * UNROLLED  → "Unrolled"   (student has never opened the course)
 * ROLLED    → "Rolled"     (student has opened the course at least once)
 * COMPLETED → "Completed"  (student explicitly checked the completion box)
 * Transitions are one-way only: UNROLLED → ROLLED → COMPLETED.
 */
enum CourseEnrollmentStatus {
  UNROLLED
  ROLLED
  COMPLETED
}

/**
 * ResourceType — the category of a course learning material.
 * BOOK       – Textbook or reference book
 * EBOOK      – Digital-only book / interactive e-book
 * NOTE       – Lecture notes or study notes
 * PAST_PAPER – Past examination paper
 * ATTACHMENT – General course attachment (slides, templates, etc.)
 */
enum ResourceType {
  BOOK
  EBOOK
  NOTE
  PAST_PAPER
  ATTACHMENT
}

/// Assignment workflow: mentors prepare, admins officially publish.
///   DRAFT → PENDING_APPROVAL → PUBLISHED   (or REJECTED → edited → PENDING_APPROVAL)
///   PUBLISHED → CLOSED (deadline passed, or admin closes; admin may reopen)
///   ARCHIVED: retired, e.g. when its academic year closes (read-only; results stay visible).
enum AssignmentStatus {
  DRAFT
  PENDING_APPROVAL
  PUBLISHED
  REJECTED
  ARCHIVED
  /// Published but no longer accepting submissions (deadline passed or closed
  /// by an admin). Students still see it, their work and their results.
  CLOSED
}

/// What happened to an assignment (its history).
enum AssignmentEventType {
  CREATED
  UPDATED
  ATTACHMENT_ADDED
  ATTACHMENT_REMOVED
  SUBMITTED_FOR_REVIEW
  RECALLED
  PUBLISHED
  REJECTED
  UNPUBLISHED
  CLOSED
  REOPENED
  ARCHIVED
}

/// How submissions were spread across mentors.
enum DistributionStrategy {
  BALANCED
  ROUND_ROBIN
  MANUAL
}

/// State of one mentor review (one row per review cycle).
///   ASSIGNED    – distributed to the mentor
///   IN_PROGRESS – mentor started reviewing
///   MARKED      – score + feedback saved (draft)
///   RETURNED    – mentor returned the completed review to the admins
///   APPROVED    – admin accepted it, ready to publish
///   SENT_BACK   – admin returned it to the mentor for rework
///   PUBLISHED   – result released to the student
///   SUPERSEDED  – replaced by a later cycle (reassignment or reopen)
///   CANCELLED   – the student replaced their work before review started
enum ReviewStatus {
  ASSIGNED
  IN_PROGRESS
  MARKED
  RETURNED
  APPROVED
  SENT_BACK
  PUBLISHED
  SUPERSEDED
  CANCELLED
  /// The mentor asked the student to redo the work; the cycle ends here and
  /// the resubmission starts a new one.
  RESUBMISSION_REQUESTED
}

/// Immutable review history entries.
enum ReviewEventType {
  ASSIGNED
  STARTED
  MARKED
  RETURNED
  APPROVED
  SENT_BACK
  PUBLISHED
  REOPENED
  REASSIGNED
  CANCELLED
  RESUBMISSION_REQUESTED
  RESUBMISSION_REQUEST_WITHDRAWN
}

/// Submission / review workflow.
///   SUBMITTED          – student submitted, waiting for distribution
///   ASSIGNED           – admin distributed it to a mentor
///   IN_REVIEW          – mentor is reviewing
///   MARKED             – mentor saved a score + feedback (draft review)
///   SUBMITTED_TO_ADMIN – mentor returned the completed review
///   APPROVED           – admin accepted the review, ready to publish
///   PUBLISHED          – result visible to the student
///   REJECTED           – admin sent the review back to the mentor for rework
///   RESUBMISSION_REQUESTED – mentor asked the student for a new attempt
enum SubmissionStatus {
  SUBMITTED
  ASSIGNED
  IN_REVIEW
  MARKED
  SUBMITTED_TO_ADMIN
  APPROVED
  PUBLISHED
  REJECTED
  /// The mentor asked for a new attempt; the student may resubmit until
  /// Submission.resubmissionDueAt (even after the assignment deadline).
  RESUBMISSION_REQUESTED
}

enum MentorRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

/**
 * CommentStatus — moderation state of a discussion comment.
 * ACTIVE  – visible to all eligible users
 * HIDDEN  – hidden by admin moderation (admin can still see it)
 * DELETED – removed by the author; shown as "[deleted]" to preserve thread structure
 */
enum CommentStatus {
  ACTIVE
  HIDDEN
  DELETED
}

/// Discussion thread state.
///   OPEN     – anyone in scope can reply
///   LOCKED   – readable, no new replies
///   HIDDEN   – removed by moderation (admins only)
///   ARCHIVED – read-only, kept for history
enum ThreadStatus {
  OPEN
  LOCKED
  HIDDEN
  ARCHIVED
  /// Removed by its author or an administrator; kept for the moderation record.
  DELETED
}

enum ReportReason {
  SPAM
  ABUSE
  INAPPROPRIATE
  OFF_TOPIC
  ACADEMIC_DISHONESTY
  OTHER
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum ModerationActionType {
  HIDE_COMMENT
  RESTORE_COMMENT
  DELETE_COMMENT
  HIDE_THREAD
  RESTORE_THREAD
  LOCK_THREAD
  UNLOCK_THREAD
  PIN_THREAD
  UNPIN_THREAD
  ARCHIVE_THREAD
  DISMISS_REPORT
  DELETE_THREAD
}

/// Learning activity recorded for analytics (not security auditing).
enum ActivityType {
  LOGIN
  COURSE_OPENED
  COURSE_COMPLETED
  RESOURCE_VIEWED
  ASSIGNMENT_VIEWED
  SUBMISSION_CREATED
  SUBMISSION_RESUBMITTED
  RESULT_VIEWED
  THREAD_CREATED
  COMMENT_POSTED
}

enum ReactionType {
  LIKE
  HELPFUL
  CONFUSED
}

/**
 * GroupRole — a role scoped to a single StudyGroup.
 * It has NO connection to the global Role enum and grants no global privileges.
 */
enum GroupRole {
  STUDENT
  MENTOR
}

enum EmailJobStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  PARTIAL_FAILURE
  FAILED
}

enum EmailDeliveryStatus {
  PENDING
  SENT
  FAILED
}

/// What a stored file is used for. Drives size/type limits and access rules.
enum FilePurpose {
  ASSIGNMENT_BRIEF
  SUBMISSION
  FEEDBACK
  RESOURCE
}

/// Notification categories. Users may opt out of e-mail per category
/// (except ACCOUNT, which carries security-relevant messages).
enum NotificationCategory {
  ASSIGNMENTS
  SUBMISSIONS
  REVIEWS
  RESULTS
  RESOURCES
  ACCOUNT
  DISCUSSIONS
}

// ═══════════════════════════════════════════════════════════════════════════════
// Identity
// ═══════════════════════════════════════════════════════════════════════════════

model User {
  id           String       @id @default(uuid())
  firstName    String
  lastName     String
  username     String       @unique
  email        String       @unique
  passwordHash String?
  provider     AuthProvider @default(LOCAL)
  providerId   String?
  role         Role         @default(STUDENT)

  /// Mentor accounts and (optionally) self-registered students require approval.
  isApproved       Boolean   @default(true)
  /// Suspended accounts cannot log in and lose access immediately.
  isActive         Boolean   @default(true)
  /// Set when the person activates the account (accepts an invitation or
  /// verifies their e-mail). NULL = invited / unverified: cannot log in.
  activatedAt      DateTime?
  lastLoginAt      DateTime?
  /// Consecutive failed logins; reset on success. Five in a row lock the
  /// account for 15 minutes (lockedUntil), whatever IP they come from.
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  /// Access tokens issued before this moment are rejected (set on password
  /// change/reset, sign-out everywhere, suspension and role change).
  tokensValidAfter DateTime?

  avatarUrl      String?
  /// Cached leaderboard total — always recomputable from published submissions.
  points         Int     @default(0)
  problemsSolved Int     @default(0)

  // ── Student-only fields (NULL for mentors and admins) ──────────────────────
  // Current placement. The authoritative per-year history is StudentEnrollment;
  // these columns mirror the ACTIVE enrolment of the current academic year so
  // every request can scope a student without a join. Both are updated in the
  // same transaction.
  gradeLevel   GradeLevel?
  divisionId   String?
  division     Division?   @relation(fields: [divisionId], references: [id])
  schoolId     String?
  school       School?     @relation(fields: [schoolId], references: [id])
  homeLocation String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignmentsCreated         Assignment[]               @relation("AssignmentCreator")
  assignmentsApproved        Assignment[]               @relation("AssignmentApprover")
  assignmentEvents           AssignmentEvent[]
  courseEnrollments          CourseEnrollment[]         @relation("CourseEnrollments")
  resourcesUploaded          CourseResource[]           @relation("ResourceUploader")
  resourceViews              ResourceView[]
  comments                   Comment[]                  @relation("CommentAuthor")
  commentReactions           CommentReaction[]          @relation("CommentReactions")
  studyGroupsCreated         StudyGroup[]               @relation("StudyGroupCreator")
  studyGroupMemberships      StudyGroupMember[]         @relation("StudyGroupMemberships")
  emailJobsCreated           EmailJob[]                 @relation("EmailJobCreator")
  submissions                Submission[]               @relation("StudentSubmissions")
  submissionRevisions        SubmissionRevision[]
  assignmentViews            AssignmentView[]           @relation("AssignmentViewer")
  auditLogs                  AuditLog[]                 @relation("AuditActor")
  mentorAssignments          MentorAssignment[]         @relation("MentorAssignmentMentor")
  mentorAssignmentsMade      MentorAssignment[]         @relation("MentorAssignmentAssigner")
  programmeMemberships       ProgrammeMembership[]      @relation("ProgrammeMember")
  programmeMembershipsAdded  ProgrammeMembership[]      @relation("ProgrammeMemberAddedBy")
  programmeMembershipsEnded  ProgrammeMembership[]      @relation("ProgrammeMemberEndedBy")
  permissionOverrides        UserPermissionOverride[]   @relation("OverrideTarget")
  permissionOverridesCreated UserPermissionOverride[]   @relation("OverrideCreatedBy")
  permissionOverridesRevoked UserPermissionOverride[]   @relation("OverrideRevokedBy")
  teacherSchools             TeacherSchoolAssignment[]  @relation("TeacherSchool")
  teacherSchoolsAssigned     TeacherSchoolAssignment[]  @relation("TeacherSchoolAssignedBy")
  teacherSchoolsEnded        TeacherSchoolAssignment[]  @relation("TeacherSchoolEndedBy")
  schoolAffiliations         StudentSchoolAffiliation[] @relation("AffiliationStudent")
  affiliationsCreated        StudentSchoolAffiliation[] @relation("AffiliationCreatedBy")
  affiliationsDecided        StudentSchoolAffiliation[] @relation("AffiliationDecidedBy")
  affiliationsRevoked        StudentSchoolAffiliation[] @relation("AffiliationRevokedBy")
  affiliationsSuperseded     StudentSchoolAffiliation[] @relation("AffiliationSupersededBy")
  schoolsCreated             School[]                   @relation("SchoolCreatedBy")
  schoolsVerified            School[]                   @relation("SchoolVerifiedBy")
  schoolContactsVerified     SchoolContact[]            @relation("SchoolContactVerifiedBy")
  schoolContactsRemoved      SchoolContact[]            @relation("SchoolContactRemovedBy")
  notifications              Notification[]
  notificationPrefs          NotificationPreference[]
  notificationSettings       NotificationSetting[]
  refreshTokens              RefreshToken[]
  passwordResetTokens        PasswordResetToken[]
  activationTokens           AccountActivationToken[]   @relation("ActivationUser")
  invitationsSent            AccountActivationToken[]   @relation("ActivationInviter")
  filesUploaded              FileObject[]
  settingsUpdated            SystemSetting[]
  studentEnrollments         StudentEnrollment[]
  reviews                    MentorReview[]             @relation("ReviewMentor")
  reviewsAssigned            MentorReview[]             @relation("ReviewAssigner")
  reviewsDecided             MentorReview[]             @relation("ReviewDecider")
  reviewEvents               ReviewEvent[]
  distributionBatches        DistributionBatch[]
  resultReleases             ResultRelease[]
  threadsCreated             DiscussionThread[]
  reportsFiled               ContentReport[]            @relation("ReportReporter")
  reportsResolved            ContentReport[]            @relation("ReportResolver")
  moderationActions          ModerationAction[]
  activityLogs               ActivityLog[]

  @@index([points])
  @@index([role])
  @@index([schoolId])
  @@index([divisionId])
  /// Reports and dashboard: users by role and account state.
  @@index([role, isActive])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 of the opaque token. The raw token is never stored.
  tokenHash String    @unique
  /// All tokens produced by rotating one login share a family; reuse of a
  /// rotated token revokes the whole family.
  familyId  String
  expiresAt DateTime
  revokedAt DateTime?
  /// Set when this token was exchanged for a new one.
  rotatedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// Single-use link that activates an account.
///   INVITATION         – an admin invited the person; they choose a password.
///   EMAIL_VERIFICATION – a self-registered student confirms their e-mail.
/// Only the SHA-256 of the token is stored. Issuing a new token for a user
/// invalidates the previous unused ones.
model AccountActivationToken {
  id          String            @id @default(uuid())
  userId      String
  user        User              @relation("ActivationUser", fields: [userId], references: [id], onDelete: Cascade)
  purpose     ActivationPurpose
  tokenHash   String            @unique
  expiresAt   DateTime
  usedAt      DateTime?
  revokedAt   DateTime?
  createdById String?
  createdBy   User?             @relation("ActivationInviter", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime          @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@index([createdById])
}

// ─── School directory (M12, S1) ─────────────────────────────────────────────────

/// A source of directory data (NESA first). New sources are new rows, not new code paths.
model SchoolDataSource {
  id          String   @id @default(uuid())
  /// Stable key, e.g. NESA.
  key         String   @unique
  name        String
  url         String?
  description String?
  createdAt   DateTime @default(now())

  externalIds   SchoolExternalId[]
  sourceRecords SchoolSourceRecord[]
  contacts      SchoolContact[]
  levels        SchoolEducationLevel[]
  programmes    SchoolProgramme[]
}

/// A school's identity in a data source: its code there, or (no usable code) a fingerprint of its
/// published name and place. A matching aid, not an immutable identity: a school keeps every key it
/// was ever matched by (supersededAt marks an older one), so a renamed or moved school is still
/// found and never created twice. One key → one school per source.
model SchoolExternalId {
  id           String               @id @default(uuid())
  dataSourceId String
  dataSource   SchoolDataSource     @relation(fields: [dataSourceId], references: [id], onDelete: Restrict)
  externalKey  String
  kind         SchoolExternalIdKind
  schoolId     String
  school       School               @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  firstSeenAt  DateTime             @default(now())
  lastSeenAt   DateTime             @default(now())
  /// A newer key replaced this one; it still identifies the school.
  supersededAt DateTime?

  @@unique([dataSourceId, externalKey])
  @@index([schoolId])
}

/// One source row exactly as published (every column, verbatim) — never edited or deleted
/// (trigger school_source_record_immutable); only its link to a school may be set or corrected.
model SchoolSourceRecord {
  id            String           @id @default(uuid())
  dataSourceId  String
  dataSource    SchoolDataSource @relation(fields: [dataSourceId], references: [id], onDelete: Restrict)
  /// e.g. "NESA accredited schools, generated 2026-11-11".
  datasetLabel  String
  /// SHA-256 of the source file.
  datasetSha256 String
  /// Where in the file: sheet / tab and row.
  sourceRef     String
  /// Every source column with its original header and value.
  raw           Json
  /// SHA-256 of the raw row.
  rowHash       String
  schoolId      String?
  school        School?          @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  /// How the row was matched to the school (CODE, EXTERNAL_ID, FINGERPRINT, REVIEW…); NULL: not matched.
  matchedBy     String?
  /// Data problems found in the row (missing or conflicting code, unreadable phone…).
  issues        Json             @default("[]")
  issueCount    Int              @default(0)
  createdAt     DateTime         @default(now())

  @@unique([dataSourceId, datasetSha256, sourceRef])
  @@index([schoolId])
  @@index([dataSourceId, rowHash])
}

/// A school's e-mail address or phone number. ADMIN_ONLY by default; REPRESENTATIVES only once an
/// Administrator has verified it (database check). Never in public search, registration, exports or
/// audit entries (which record a masked value). Never deleted: removing or replacing a contact sets
/// removedAt, so every value it had stays readable by Administrators only. At most one active
/// contact per school, type and value (enforced under the school's row lock).
model SchoolContact {
  id           String                  @id @default(uuid())
  schoolId     String
  school       School                  @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  type         SchoolContactType
  /// Normalised (e-mail lower-case; phone E.164 where recognisable).
  value        String
  /// As entered or published.
  rawValue     String?
  label        String?
  isPrimary    Boolean                 @default(false)
  visibility   SchoolContactVisibility @default(ADMIN_ONLY)
  verifiedAt   DateTime?
  verifiedById String?
  verifiedBy   User?                   @relation("SchoolContactVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  /// NULL: entered by an Administrator.
  dataSourceId String?
  dataSource   SchoolDataSource?       @relation(fields: [dataSourceId], references: [id], onDelete: SetNull)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @default(now()) @updatedAt
  /// Removed (or replaced by a new value): kept, no longer active.
  removedAt    DateTime?
  removedById  String?
  removedBy    User?                   @relation("SchoolContactRemovedBy", fields: [removedById], references: [id], onDelete: SetNull)

  @@index([schoolId, type, value])
  @@index([verifiedById])
  @@index([removedById])
  @@index([dataSourceId])
}

/// Education levels (reference data; Rwanda: PPR, PR, OL, AL, PE).
model EducationLevel {
  code      String                 @id
  name      String
  sortOrder Int
  schools   SchoolEducationLevel[]
}

model SchoolEducationLevel {
  schoolId     String
  school       School            @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  levelCode    String
  level        EducationLevel    @relation(fields: [levelCode], references: [code], onDelete: Restrict)
  /// A published variant of the level (e.g. "L"), kept as published.
  qualifier    String?
  /// The exact source text this offering came from.
  sourceToken  String?
  dataSourceId String?
  dataSource   SchoolDataSource? @relation(fields: [dataSourceId], references: [id], onDelete: SetNull)
  createdAt    DateTime          @default(now())

  @@id([schoolId, levelCode])
  @@index([levelCode])
  @@index([dataSourceId])
}

/// A-Level combinations, TVET trades and other programmes (reference data). needsReview: created
/// from a source and not yet reviewed — never shown as a verified offering.
model Programme {
  id          String            @id @default(uuid())
  code        String?           @unique
  name        String
  category    ProgrammeCategory
  tvetLevel   Int?
  needsReview Boolean           @default(true)
  createdAt   DateTime          @default(now())
  schools     SchoolProgramme[]

  @@unique([category, name])
}

model SchoolProgramme {
  schoolId     String
  school       School            @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  programmeId  String
  programme    Programme         @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  sourceToken  String?
  dataSourceId String?
  dataSource   SchoolDataSource? @relation(fields: [dataSourceId], references: [id], onDelete: SetNull)
  createdAt    DateTime          @default(now())

  @@id([schoolId, programmeId])
  @@index([programmeId])
  @@index([dataSourceId])
}

/// Access-token revocation list (logout). Rows are purged after expiry.
model TokenBlacklist {
  id        String   @id @default(uuid())
  jti       String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

/// Staging table for mentor applications. Approval creates the User.
model MentorRequest {
  id           String              @id @default(uuid())
  firstName    String
  lastName     String
  username     String              @unique
  email        String              @unique
  /// Cleared once the request is decided.
  passwordHash String?
  status       MentorRequestStatus @default(PENDING)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([status])
}

model School {
  id               String               @id @default(uuid())
  /// Exactly as published (M12: not unique — several schools share a name; identified by code,
  /// external source ids and place, never by name).
  name             String
  location         String
  createdAt        DateTime             @default(now())
  /// Official school code (6 digits; P1-11 official list, M8). NULL for a school entered before the list.
  code             String?              @unique
  /// Rwanda province (official list; the first digit of the code).
  province         String?
  district         String?
  sector           String?
  /// PUBLIC, GOVERNMENT_AIDED or PRIVATE (official list).
  ownership        String?
  /// Normalised official name (src/schools/school-key.ts): resolves a registration that sends a name.
  nameKey          String?
  /// ISO 3166-1 alpha-2 (school administration PR B, M11). Codes and the official directory are Rwanda only.
  countryCode      String               @default("RW")
  /// Inactive: kept with all its history, but accepts no new claim, registration or Teacher assignment.
  isActive         Boolean              @default(true)
  /// OFFICIAL_LIST (M8 directory), ADMIN (created by an Administrator) or LEGACY (entered before the list).
  source           SchoolSource         @default(LEGACY)
  createdById      String?
  createdBy        User?                @relation("SchoolCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedAt        DateTime             @default(now()) @updatedAt
  /// M12 (school directory S1): the official directory's cell and village (free text, trimmed).
  cell             String?
  village          String?
  accommodation    SchoolAccommodation?
  /// When a directory sync (S2) last compared this school with a source.
  lastSourceSyncAt DateTime?
  /// When an Administrator last confirmed the record (S2 / S3).
  lastVerifiedAt   DateTime?
  lastVerifiedById String?
  lastVerifiedBy   User?                @relation("SchoolVerifiedBy", fields: [lastVerifiedById], references: [id], onDelete: SetNull)

  students      User[]
  enrollments   StudentEnrollment[]
  teachers      TeacherSchoolAssignment[]
  affiliations  StudentSchoolAffiliation[]
  contacts      SchoolContact[]
  levels        SchoolEducationLevel[]
  programmes    SchoolProgramme[]
  externalIds   SchoolExternalId[]
  sourceRecords SchoolSourceRecord[]

  @@index([name])
  @@index([nameKey])
  @@index([province, district, sector])
  @@index([countryCode, isActive])
  @@index([createdById])
  @@index([lastVerifiedById])
}

/// Where a school record comes from (M11).
enum SchoolSource {
  OFFICIAL_LIST
  ADMIN
  LEGACY
}

enum SchoolAccommodation {
  DAY
  BOARDING
  MIXED
}

enum SchoolContactType {
  EMAIL
  PHONE
  OTHER
}

enum SchoolContactVisibility {
  ADMIN_ONLY
  REPRESENTATIVES
}

enum ProgrammeCategory {
  A_LEVEL_COMBINATION
  TVET_TRADE
  OTHER
}

enum SchoolExternalIdKind {
  CODE
  FINGERPRINT
  OTHER
}

// ═══════════════════════════════════════════════════════════════════════════════
// Academic structure
// ═══════════════════════════════════════════════════════════════════════════════

/// Exactly two rows (JUNIOR, SENIOR), created by the seed. Admins may edit
/// name/description/isActive but never create or delete divisions.
model Division {
  id          String       @id @default(uuid())
  code        DivisionCode @unique
  name        String
  description String?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  students            User[]
  studentEnrollments  StudentEnrollment[]
  mentorAssignments   MentorAssignment[]
  resources           CourseResource[]
  assignments         Assignment[]
  threads             DiscussionThread[]
  permissionOverrides UserPermissionOverride[]
}

/// A subject area (e.g. Mathematics). The platform launches with Mathematics
/// only; further disciplines are new rows — no schema change needed.
model Discipline {
  id          String   @id @default(uuid())
  /// Stable identifier, e.g. "MATHEMATICS".
  code        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  courses     Course[]
  memberships ProgrammeMembership[]
}

/// An academic year (e.g. "2026-2027"). Assignments belong to a year;
/// closing a year archives its assignments.
model AcademicYear {
  id        String             @id @default(uuid())
  /// Display name, e.g. "2026-2027".
  name      String             @unique
  startsOn  DateTime           @db.Date
  endsOn    DateTime           @db.Date
  status    AcademicYearStatus @default(PLANNED)
  /// TRUE for the single current year, NULL otherwise. The unique index allows
  /// many NULLs but only one TRUE, so the database guarantees one current year.
  isCurrent Boolean?           @unique
  closedAt  DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  enrollments StudentEnrollment[]
  assignments Assignment[]

  @@index([status])
}

/// A student's placement for one academic year (grade, division, school).
/// History is kept: a new row per year, older rows become PROMOTED/GRADUATED.
model StudentEnrollment {
  id             String                  @id @default(uuid())
  studentId      String
  student        User                    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear            @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  divisionId     String
  division       Division                @relation(fields: [divisionId], references: [id], onDelete: Restrict)
  gradeLevel     GradeLevel
  schoolId       String?
  school         School?                 @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  status         StudentEnrollmentStatus @default(ACTIVE)
  enrolledAt     DateTime                @default(now())
  endedAt        DateTime?

  @@unique([studentId, academicYearId])
  @@index([academicYearId, divisionId, status])
  @@index([divisionId])
  @@index([schoolId])
}

/// A course within a discipline (launch: the four Mathematics courses).
/// Content (resources, assignments, discussions) is scoped per
/// (course × division). Courses are archived, never deleted.
model Course {
  id                 String       @id @default(uuid())
  disciplineId       String
  discipline         Discipline   @relation(fields: [disciplineId], references: [id], onDelete: Restrict)
  /// Stable identifier within the discipline, e.g. "ALGEBRA".
  code               String
  title              String
  description        String
  status             CourseStatus @default(PUBLISHED)
  publishedAt        DateTime?
  archivedAt         DateTime?
  sortOrder          Int          @default(0)
  /// When false, existing threads stay readable but nobody can start a thread
  /// or post in this course (course and assignment discussions).
  discussionsEnabled Boolean      @default(true)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  assignments         Assignment[]
  enrollments         CourseEnrollment[]
  resources           CourseResource[]
  threads             DiscussionThread[]
  mentorAssignments   MentorAssignment[]
  activityLogs        ActivityLog[]
  permissionOverrides UserPermissionOverride[]

  @@unique([disciplineId, code])
  @@index([status])
}

/// Admin assigns a mentor to a (course × division). This is the mentor's scope
/// for resources, assignments, discussions and analytics.
model MentorAssignment {
  id           String   @id @default(uuid())
  mentorId     String
  mentor       User     @relation("MentorAssignmentMentor", fields: [mentorId], references: [id], onDelete: Cascade)
  courseId     String
  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  divisionId   String
  division     Division @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  assignedById String?
  assignedBy   User?    @relation("MentorAssignmentAssigner", fields: [assignedById], references: [id], onDelete: SetNull)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([mentorId, courseId, divisionId])
  @@index([courseId, divisionId])
  @@index([divisionId])
  @@index([assignedById])
}

/// Per-student course progress. Created on first open.
model CourseEnrollment {
  id            String                 @id @default(uuid())
  courseId      String
  course        Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  studentId     String
  student       User                   @relation("CourseEnrollments", fields: [studentId], references: [id], onDelete: Cascade)
  status        CourseEnrollmentStatus @default(UNROLLED)
  firstOpenedAt DateTime               @default(now())
  lastOpenedAt  DateTime               @default(now())
  completedAt   DateTime?

  @@unique([courseId, studentId])
  @@index([studentId])
  @@index([status])
}

// ═══════════════════════════════════════════════════════════════════════════════
// Files
// ═══════════════════════════════════════════════════════════════════════════════

/// Metadata for every stored file. The bytes live in the configured storage
/// driver (local disk or S3-compatible) under `storageKey`.
model FileObject {
  id           String      @id @default(uuid())
  storageKey   String      @unique
  purpose      FilePurpose
  originalName String
  /// Detected from file content (magic bytes), not trusted from the client.
  mimeType     String
  size         Int
  sha256       String
  uploadedById String?
  uploadedBy   User?       @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())

  resourceAttachments   ResourceAttachment[]
  assignmentAttachments AssignmentAttachment[]
  submissionAttachments SubmissionAttachment[]
  reviewAttachments     ReviewAttachment[]

  @@index([purpose])
  @@index([createdAt])
  @@index([uploadedById])
}

// ═══════════════════════════════════════════════════════════════════════════════
// Learning content
// ═══════════════════════════════════════════════════════════════════════════════

model CourseResource {
  id           String       @id @default(uuid())
  courseId     String
  course       Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  divisionId   String
  division     Division     @relation(fields: [divisionId], references: [id])
  type         ResourceType
  title        String
  description  String?
  /// Author(s) of a book, or who prepared the material.
  author       String?
  /// Publisher, or the competition/exam a past paper comes from.
  source       String?
  /// Publication year, or the year of the exam.
  year         Int?
  /// Free-form labels (lower-case), e.g. "inequalities", "imo".
  tags         String[]     @default([])
  /// Display order within the course (lower = first).
  sortOrder    Int          @default(0)
  isPublished  Boolean      @default(false)
  publishedAt  DateTime?
  /// Archived resources are hidden from students but kept.
  archivedAt   DateTime?
  uploadedById String
  uploadedBy   User         @relation("ResourceUploader", fields: [uploadedById], references: [id])
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  attachments ResourceAttachment[]
  views       ResourceView[]

  @@index([courseId, divisionId, isPublished])
  @@index([sortOrder])
  @@index([tags], type: Gin)
  @@index([divisionId])
  @@index([uploadedById])
}

/// Files attached to a learning resource (ordered).
model ResourceAttachment {
  id         String         @id @default(uuid())
  resourceId String
  resource   CourseResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  fileId     String
  file       FileObject     @relation(fields: [fileId], references: [id], onDelete: Restrict)
  sortOrder  Int            @default(0)
  createdAt  DateTime       @default(now())

  @@unique([resourceId, fileId])
  @@index([fileId])
}

model ResourceView {
  id            String         @id @default(uuid())
  resourceId    String
  resource      CourseResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  studentId     String
  student       User           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  firstViewedAt DateTime       @default(now())
  lastViewedAt  DateTime       @default(now())
  viewCount     Int            @default(1)

  @@unique([resourceId, studentId])
  @@index([studentId])
}

// ═══════════════════════════════════════════════════════════════════════════════
// Assessment
// ═══════════════════════════════════════════════════════════════════════════════

model Assignment {
  id           String   @id @default(uuid())
  title        String
  /// Short summary shown in lists; the full brief is in instructions.
  description  String?
  instructions String
  deadline     DateTime
  /// Leaderboard points available. Awarded proportionally to the score.
  points       Int
  maximumMarks Int

  allowResubmission   Boolean @default(false)
  /// 0 = unlimited resubmissions while the deadline has not passed.
  maxResubmissions    Int     @default(0)
  /// When true, first submissions after the deadline are accepted and flagged late.
  allowLateSubmission Boolean @default(false)

  status             AssignmentStatus @default(DRAFT)
  submittedAt        DateTime?
  publishedAt        DateTime?
  rejectedAt         DateTime?
  rejectionNote      String?
  /// Set when the admin publishes results for the whole assignment.
  resultsPublishedAt DateTime?
  /// Set when archived (status ARCHIVED).
  archivedAt         DateTime?
  /// Set when it stopped accepting submissions (status CLOSED).
  closedAt           DateTime?

  approvedById String?
  approvedBy   User?   @relation("AssignmentApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  courseId   String
  course     Course   @relation(fields: [courseId], references: [id])
  divisionId String
  division   Division @relation(fields: [divisionId], references: [id])

  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)

  createdById String
  createdBy   User   @relation("AssignmentCreator", fields: [createdById], references: [id])

  attachments         AssignmentAttachment[]
  submissions         Submission[]
  views               AssignmentView[]
  distributionBatches DistributionBatch[]
  resultReleases      ResultRelease[]
  threads             DiscussionThread[]
  events              AssignmentEvent[]
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  @@index([courseId, divisionId, status])
  @@index([academicYearId, status])
  @@index([deadline])
  @@index([createdById])
  @@index([status])
  @@index([approvedById])
  @@index([divisionId])
}

/// Files attached to an assignment brief (ordered).
/// Assignment history: one row per creation, edit, file change and status
/// change. Append-only.
model AssignmentEvent {
  id           String              @id @default(uuid())
  assignmentId String
  assignment   Assignment          @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  type         AssignmentEventType
  fromStatus   AssignmentStatus?
  toStatus     AssignmentStatus?
  /// Null for automatic events (deadline closing, academic-year rollover).
  actorId      String?
  actor        User?               @relation(fields: [actorId], references: [id], onDelete: SetNull)
  note         String?
  /// For UPDATED: { field: { from, to } }. For attachments: { attachmentIds }.
  changes      Json?
  createdAt    DateTime            @default(now())

  @@index([assignmentId, createdAt])
  @@index([actorId])
}

model AssignmentAttachment {
  id           String     @id @default(uuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  fileId       String
  file         FileObject @relation(fields: [fileId], references: [id], onDelete: Restrict)
  sortOrder    Int        @default(0)
  createdAt    DateTime   @default(now())

  @@unique([assignmentId, fileId])
  @@index([fileId])
}

/// One row per (student, assignment): drives the "New" vs "Opened" status.
model AssignmentView {
  id            String     @id @default(uuid())
  assignmentId  String
  assignment    Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId     String
  student       User       @relation("AssignmentViewer", fields: [studentId], references: [id], onDelete: Cascade)
  firstViewedAt DateTime   @default(now())
  lastViewedAt  DateTime   @default(now())
  viewCount     Int        @default(1)

  @@unique([assignmentId, studentId])
  @@index([studentId])
}

/// A student's work for one assignment (one row per student × assignment).
/// "status" is the overall workflow state used for filtering and the student
/// display status; the academic review itself lives in MentorReview.
model Submission {
  id     String           @id @default(uuid())
  status SubmissionStatus @default(SUBMITTED)

  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  studentId    String
  student      User       @relation("StudentSubmissions", fields: [studentId], references: [id], onDelete: Restrict)

  /// Number of resubmissions made after the first submission.
  revisionCount Int       @default(0)
  /// True when the latest (re)submission arrived after the deadline.
  isLate        Boolean   @default(false)
  submittedAt   DateTime?

  /// Open resubmission request (status RESUBMISSION_REQUESTED); cleared when
  /// the student resubmits. Past requests are kept as ReviewEvents.
  resubmissionRequestedAt DateTime?
  resubmissionDueAt       DateTime?
  resubmissionNote        String?

  /// The latest review cycle (any status). NULL until distributed.
  currentReviewId   String?        @unique
  currentReview     MentorReview?  @relation("CurrentReview", fields: [currentReviewId], references: [id], onDelete: SetNull)
  /// The review whose result the student sees. NULL until published.
  publishedReviewId String?        @unique
  publishedReview   MentorReview?  @relation("PublishedReview", fields: [publishedReviewId], references: [id], onDelete: SetNull)
  resultReleaseId   String?
  resultRelease     ResultRelease? @relation(fields: [resultReleaseId], references: [id], onDelete: SetNull)

  /// Leaderboard points granted by the published result (0 until then).
  pointsAwarded Int       @default(0)
  publishedAt   DateTime?

  revisions SubmissionRevision[]
  reviews   MentorReview[]       @relation("SubmissionReviews")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([assignmentId, studentId])
  @@index([studentId])
  @@index([assignmentId, status])
  @@index([resultReleaseId])
  /// Reports: submissions and published results in a date range.
  @@index([submittedAt])
  @@index([publishedAt])
}

/// Immutable history of every submission attempt (revision 1 = first submission).
model SubmissionRevision {
  id             String     @id @default(uuid())
  submissionId   String
  submission     Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  revisionNumber Int
  note           String?
  /// Typed answer for this attempt (files are in attachments).
  answerText     String?
  isLate         Boolean    @default(false)
  submittedById  String
  submittedBy    User       @relation(fields: [submittedById], references: [id])
  submittedAt    DateTime   @default(now())

  attachments SubmissionAttachment[]

  @@unique([submissionId, revisionNumber])
  @@index([submittedById])
}

/// Files of one submission attempt (a student may upload several pages).
model SubmissionAttachment {
  id         String             @id @default(uuid())
  revisionId String
  revision   SubmissionRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  fileId     String
  file       FileObject         @relation(fields: [fileId], references: [id], onDelete: Restrict)
  sortOrder  Int                @default(0)
  createdAt  DateTime           @default(now())

  @@unique([revisionId, fileId])
  @@index([fileId])
}

/// One administrator distribution run for an assignment.
model DistributionBatch {
  id            String               @id @default(uuid())
  assignmentId  String
  assignment    Assignment           @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  strategy      DistributionStrategy
  assignedCount Int                  @default(0)
  createdById   String
  createdBy     User                 @relation(fields: [createdById], references: [id])
  createdAt     DateTime             @default(now())

  reviews MentorReview[]

  @@index([assignmentId])
  @@index([createdById])
}

/// A mentor's academic review of a submission. A new row (cycle) is created
/// whenever the submission is (re)assigned or a published result is reopened,
/// so earlier reviews remain as history. Only mentors write score and feedback.
model MentorReview {
  id           String       @id @default(uuid())
  submissionId String
  submission   Submission   @relation("SubmissionReviews", fields: [submissionId], references: [id], onDelete: Cascade)
  /// 1, 2, 3 … per submission.
  cycle        Int
  mentorId     String
  mentor       User         @relation("ReviewMentor", fields: [mentorId], references: [id], onDelete: Restrict)
  status       ReviewStatus @default(ASSIGNED)

  // ── Formal academic review (mentor) ────────────────────────────────────────
  score      Int?
  percentage Float?
  feedback   String?

  // ── Distribution ───────────────────────────────────────────────────────────
  assignedAt          DateTime           @default(now())
  assignedById        String?
  assignedBy          User?              @relation("ReviewAssigner", fields: [assignedById], references: [id], onDelete: SetNull)
  distributionBatchId String?
  distributionBatch   DistributionBatch? @relation(fields: [distributionBatchId], references: [id], onDelete: SetNull)

  // ── Progress ───────────────────────────────────────────────────────────────
  startedAt  DateTime?
  markedAt   DateTime?
  returnedAt DateTime?

  // ── Administrator coordination (never academic feedback) ──────────────────
  decidedAt        DateTime?
  decidedById      String?
  decidedBy        User?     @relation("ReviewDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  /// Why the admin sent the review back (visible to the mentor).
  decisionNote     String?
  /// Internal note; never shown to students or mentors.
  coordinationNote String?
  publishedAt      DateTime?

  attachments  ReviewAttachment[]
  events       ReviewEvent[]
  currentFor   Submission?        @relation("CurrentReview")
  publishedFor Submission?        @relation("PublishedReview")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([submissionId, cycle])
  @@index([mentorId, status])
  @@index([distributionBatchId])
  /// Reports: completed reviews in a date range.
  @@index([returnedAt])
  @@index([assignedById])
  @@index([decidedById])
}

/// Feedback files attached by the mentor to a review.
model ReviewAttachment {
  id        String       @id @default(uuid())
  reviewId  String
  review    MentorReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  fileId    String
  file      FileObject   @relation(fields: [fileId], references: [id], onDelete: Restrict)
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now())

  @@unique([reviewId, fileId])
  @@index([fileId])
}

/// Append-only history of a review: who did what, when, with which score.
model ReviewEvent {
  id        String          @id @default(uuid())
  reviewId  String
  review    MentorReview    @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  type      ReviewEventType
  actorId   String?
  actor     User?           @relation(fields: [actorId], references: [id], onDelete: SetNull)
  score     Int?
  note      String?
  createdAt DateTime        @default(now())

  @@index([reviewId, createdAt])
  @@index([actorId])
}

/// One administrator release of results for an assignment.
model ResultRelease {
  id            String     @id @default(uuid())
  assignmentId  String
  assignment    Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  publishedById String
  publishedBy   User       @relation(fields: [publishedById], references: [id])
  resultCount   Int
  note          String?
  publishedAt   DateTime   @default(now())

  submissions Submission[]

  @@index([assignmentId])
  @@index([publishedAt])
  @@index([publishedById])
}

// ═══════════════════════════════════════════════════════════════════════════════
// Discussions
// ═══════════════════════════════════════════════════════════════════════════════

/// A discussion topic. Course threads are per (course × division);
/// assignment threads belong to one assignment (and inherit its division).
/// Exactly one of courseId / assignmentId is set (CHECK constraint).
model DiscussionThread {
  id             String       @id @default(uuid())
  courseId       String?
  course         Course?      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  assignmentId   String?
  assignment     Assignment?  @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  divisionId     String
  division       Division     @relation(fields: [divisionId], references: [id], onDelete: Restrict)
  title          String
  status         ThreadStatus @default(OPEN)
  isPinned       Boolean      @default(false)
  createdById    String
  createdBy      User         @relation(fields: [createdById], references: [id], onDelete: Restrict)
  /// Updated whenever a comment is posted; drives "most recent" ordering.
  lastActivityAt DateTime     @default(now())
  archivedAt     DateTime?
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  comments          Comment[]
  reports           ContentReport[]
  moderationActions ModerationAction[]

  @@index([courseId, divisionId, status, lastActivityAt])
  @@index([assignmentId, status])
  @@index([createdById])
  @@index([divisionId])
}

/// A message in a thread. Replies set parentId (one level of nesting).
model Comment {
  id       String           @id @default(uuid())
  threadId String
  thread   DiscussionThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  content  String
  status   CommentStatus    @default(ACTIVE)

  /// Null for top-level comments; set for replies.
  parentId String?
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies  Comment[] @relation("CommentReplies")

  authorId  String
  author    User      @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  editedAt  DateTime?
  deletedAt DateTime?

  reactions         CommentReaction[]
  reports           ContentReport[]
  moderationActions ModerationAction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([threadId, parentId, createdAt])
  @@index([authorId])
  @@index([parentId])
  @@index([status])
}

/// A user's report of a thread or comment for moderation. Exactly one of
/// threadId / commentId is set (CHECK constraint). One report per user per item.
model ContentReport {
  id              String            @id @default(uuid())
  reporterId      String
  reporter        User              @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  threadId        String?
  thread          DiscussionThread? @relation(fields: [threadId], references: [id], onDelete: Cascade)
  commentId       String?
  comment         Comment?          @relation(fields: [commentId], references: [id], onDelete: Cascade)
  reason          ReportReason
  details         String?
  /// The reported text as it was when reported (title for threads), so later
  /// edits cannot hide what was reported.
  contentSnapshot String?
  status          ReportStatus      @default(OPEN)
  resolvedAt      DateTime?
  resolvedById    String?
  resolvedBy      User?             @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolutionNote  String?
  createdAt       DateTime          @default(now())

  moderationActions ModerationAction[]

  @@unique([reporterId, threadId])
  @@unique([reporterId, commentId])
  @@index([status, createdAt])
  @@index([commentId])
  @@index([threadId])
  @@index([resolvedById])
}

/// Append-only log of every moderation decision (who, what, why).
model ModerationAction {
  id          String               @id @default(uuid())
  moderatorId String
  moderator   User                 @relation(fields: [moderatorId], references: [id], onDelete: Restrict)
  action      ModerationActionType
  threadId    String?
  thread      DiscussionThread?    @relation(fields: [threadId], references: [id], onDelete: SetNull)
  commentId   String?
  comment     Comment?             @relation(fields: [commentId], references: [id], onDelete: SetNull)
  reportId    String?
  report      ContentReport?       @relation(fields: [reportId], references: [id], onDelete: SetNull)
  reason      String?
  createdAt   DateTime             @default(now())

  @@index([commentId])
  @@index([threadId])
  @@index([moderatorId, createdAt])
  @@index([reportId])
}

model CommentReaction {
  id        String       @id @default(uuid())
  commentId String
  comment   Comment      @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation("CommentReactions", fields: [userId], references: [id], onDelete: Cascade)
  type      ReactionType
  createdAt DateTime     @default(now())

  @@unique([commentId, userId, type])
  @@index([userId])
}

// ═══════════════════════════════════════════════════════════════════════════════
// Study groups (admin-managed cohorts)
// ═══════════════════════════════════════════════════════════════════════════════

model StudyGroup {
  id          String  @id @default(uuid())
  name        String
  description String
  tags        String?
  isActive    Boolean @default(true)

  createdById String
  createdBy   User   @relation("StudyGroupCreator", fields: [createdById], references: [id])

  members StudyGroupMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([createdById])
}

model StudyGroupMember {
  id          String     @id @default(uuid())
  groupId     String
  group       StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId      String
  user        User       @relation("StudyGroupMemberships", fields: [userId], references: [id], onDelete: Cascade)
  /// Role within this group only — does not affect global authorization.
  groupRole   GroupRole  @default(STUDENT)
  joinedAt    DateTime   @default(now())
  removedAt   DateTime?
  removedById String?

  @@unique([groupId, userId])
  @@index([userId])
}

// ═══════════════════════════════════════════════════════════════════════════════
// Notifications & e-mail
// ═══════════════════════════════════════════════════════════════════════════════

model Notification {
  id        String               @id @default(uuid())
  userId    String
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  NotificationCategory
  /// Machine-readable event type, e.g. "assignment.published".
  type      String
  title     String
  body      String
  /// Ids the frontend needs to deep-link (assignmentId, submissionId, …).
  data      Json?
  /// Frontend path to open, e.g. "/assignments/123".
  link      String?
  readAt    DateTime?
  createdAt DateTime             @default(now())

  @@index([userId, readAt])
  /// The inbox: a user's notifications, newest first.
  @@index([userId, createdAt])
  @@index([createdAt])
}

model NotificationPreference {
  id           String               @id @default(uuid())
  userId       String
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  category     NotificationCategory
  emailEnabled Boolean              @default(true)
  updatedAt    DateTime             @updatedAt

  @@unique([userId, category])
}

/// Per-notification-type switches that admins and mentors set in their
/// profile settings (in-app and e-mail separately). No row means the default:
/// both on. The configurable types are listed in notification-types.ts.
model NotificationSetting {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Notification type, e.g. "submissions.assigned".
  type         String
  inAppEnabled Boolean  @default(true)
  emailEnabled Boolean  @default(true)
  updatedAt    DateTime @updatedAt

  @@unique([userId, type])
  /// Sending looks up the recipients who turned a type off.
  @@index([type, userId])
}

/// One per admin bulk-send request.
model EmailJob {
  id              String         @id @default(uuid())
  /// Caller-supplied key; re-submitting the same key is a safe no-op.
  idempotencyKey  String         @unique
  subject         String
  /// Stored to allow retry. Never written to audit logs.
  body            String
  status          EmailJobStatus @default(PENDING)
  totalRecipients Int
  sentCount       Int            @default(0)
  failedCount     Int            @default(0)
  createdById     String
  createdBy       User           @relation("EmailJobCreator", fields: [createdById], references: [id])
  completedAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  deliveries EmailDelivery[]

  @@index([createdById])
  @@index([status])
}

/// Outbox for every outgoing e-mail (bulk-job recipients and transactional
/// notifications). A background worker claims PENDING rows with
/// FOR UPDATE SKIP LOCKED, so it is safe with several API instances.
model EmailDelivery {
  id             String              @id @default(uuid())
  /// Set for bulk-job deliveries; null for transactional e-mails.
  jobId          String?
  job            EmailJob?           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  recipientEmail String
  recipientId    String?
  /// Transactional e-mails carry their own subject/body; bulk deliveries use the job's.
  subject        String?
  /// Plain-text version. Cleared once a transactional e-mail is delivered (it may carry a one-time link).
  body           String?
  /// Branded HTML version (transactional e-mails); cleared together with body.
  html           String?
  status         EmailDeliveryStatus @default(PENDING)
  attempts       Int                 @default(0)
  nextAttemptAt  DateTime            @default(now())
  lockedAt       DateTime?
  messageId      String?
  errorMessage   String?
  attemptedAt    DateTime?
  createdAt      DateTime            @default(now())

  @@index([status, nextAttemptAt])
  @@index([jobId, status])
  @@index([recipientEmail])
}

// ═══════════════════════════════════════════════════════════════════════════════
// Administration
// ═══════════════════════════════════════════════════════════════════════════════

/// Key/value system settings. Keys are restricted to an allow-list in code.
model SystemSetting {
  key         String   @id
  value       Json
  updatedById String?
  updatedBy   User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt   DateTime @updatedAt

  @@index([updatedById])
}

/// How a programme membership was created.
enum MembershipSource {
  /// Phase 1 backfill of existing students and coaches (migration M3).
  BACKFILL
  /// Added afterwards (account creation while one programme exists, or by an administrator).
  MANUAL
}

/// A user's membership of a programme (programme = Discipline; plan §7.1).
/// Read only by Head Coach and Teacher scope (P1-10/P1-11): student access
/// stays division-based and coach access MentorAssignment-based. One row per
/// user × programme, ended and re-activated by update (like MentorAssignment).
model ProgrammeMembership {
  id           String           @id @default(uuid())
  userId       String
  user         User             @relation("ProgrammeMember", fields: [userId], references: [id], onDelete: Cascade)
  disciplineId String
  discipline   Discipline       @relation(fields: [disciplineId], references: [id], onDelete: Restrict)
  source       MembershipSource
  isActive     Boolean          @default(true)
  addedById    String?
  addedBy      User?            @relation("ProgrammeMemberAddedBy", fields: [addedById], references: [id], onDelete: SetNull)
  createdAt    DateTime         @default(now())
  endedAt      DateTime?
  endedById    String?
  endedBy      User?            @relation("ProgrammeMemberEndedBy", fields: [endedById], references: [id], onDelete: SetNull)

  @@unique([userId, disciplineId])
  @@index([disciplineId, isActive])
  @@index([addedById])
  @@index([endedById])
}

/// Whether an individual override adds or removes a permission.
enum OverrideEffect {
  GRANT
  DENY
}

/// An individual permission override (P1-09, plan §6.3/§6.4): set by a Super
/// Admin only, validated against the approved list in code, applied on every
/// authorization decision while `revokedAt` is null and `expiresAt` is in the
/// future (or null). A GRANT applies only inside the target's existing scope
/// (courseId × divisionId for a teacher's assignments.prepare). Never deleted:
/// revocation is soft and the history is kept.
model UserPermissionOverride {
  id               String         @id @default(uuid())
  userId           String
  user             User           @relation("OverrideTarget", fields: [userId], references: [id], onDelete: Cascade)
  permission       String
  effect           OverrideEffect
  /// GRANT scope (course × division); null for DENY.
  courseId         String?
  course           Course?        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  divisionId       String?
  division         Division?      @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  reason           String
  expiresAt        DateTime?
  createdById      String?
  createdBy        User?          @relation("OverrideCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt        DateTime       @default(now())
  revokedAt        DateTime?
  revokedById      String?
  revokedBy        User?          @relation("OverrideRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)
  revokeReason     String?
  /// When the expiry was recorded in the audit log (record only; the override stopped applying at expiresAt).
  expiryRecordedAt DateTime?

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@index([createdById])
  @@index([revokedById])
  @@index([courseId])
  @@index([divisionId])
}

/// Append-only: a database trigger rejects UPDATE and DELETE (the only
/// permitted change is the foreign key clearing actorId when an account is
/// deleted). There are no API routes that modify audit records.
model AuditLog {
  id            String   @id @default(uuid())
  actorId       String?
  actorRole     String?
  actor         User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  /// The actor's username at the time, filled in by the database on insert, so
  /// the record still says who acted if the account is later deleted.
  actorUsername String?
  action        String
  entity        String
  entityId      String?
  metadata      Json?
  createdAt     DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([entity, entityId])
  @@index([createdAt])
}

/// Learning activity (what students and mentors do), used for analytics and
/// engagement reports. Security-relevant changes go to AuditLog instead.
/// Retention: rows older than 400 days are purged nightly.
model ActivityLog {
  id         String       @id @default(uuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       ActivityType
  courseId   String?
  course     Course?      @relation(fields: [courseId], references: [id], onDelete: SetNull)
  entityType String?
  entityId   String?
  metadata   Json?
  createdAt  DateTime     @default(now())

  @@index([userId, createdAt])
  @@index([courseId, type, createdAt])
  @@index([type, createdAt])
}

// ─── Public contact form ─────────────────────────────────────────────────────

enum ContactMessageStatus {
  NEW
  HANDLED
}

/// A message sent from the public homepage's contact form (POST /public/contact).
/// Only administrators can read it (GET /admin/contact-messages).
model ContactMessage {
  id           String               @id @default(uuid())
  fullName     String
  email        String
  subject      String
  message      String
  status       ContactMessageStatus @default(NEW)
  /// "QUEUED" when an e-mail notice was queued to platform.supportEmail, "NOT_CONFIGURED" when no support e-mail is set.
  notification String
  /// Keyed SHA-256 of the sender's IP address: only used for abuse limits, never shown.
  ipHash       String?
  handledAt    DateTime?
  /// The administrator who marked it handled (no foreign key: kept if that account is deleted).
  handledById  String?
  createdAt    DateTime             @default(now())

  @@index([status, createdAt])
  @@index([email, createdAt])
  @@index([ipHash, createdAt])
}

/// A Teacher's school (P1-11): the teacher sees only students whose school is one of
/// their ACTIVE assignments. Set by Administrators (users.manageTeachers); one row per
/// (teacher, school), ended / re-activated by update (same pattern as ProgrammeMembership).
model TeacherSchoolAssignment {
  id           String    @id @default(uuid())
  teacherId    String
  teacher      User      @relation("TeacherSchool", fields: [teacherId], references: [id], onDelete: Cascade)
  schoolId     String
  school       School    @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  isActive     Boolean   @default(true)
  assignedById String?
  assignedBy   User?     @relation("TeacherSchoolAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  endedAt      DateTime?
  endedById    String?
  endedBy      User?     @relation("TeacherSchoolEndedBy", fields: [endedById], references: [id], onDelete: SetNull)

  @@unique([teacherId, schoolId])
  @@index([schoolId, isActive])
  @@index([assignedById])
  @@index([endedById])
}

/// Student–school affiliation (P1-11 follow-up, PR A): whether an Administrator has
/// verified that a student genuinely belongs to a school. Choosing a school at sign-up,
/// account approval or e-mail verification are NOT proof of membership.
enum SchoolAffiliationStatus {
  PENDING
  VERIFIED
  REJECTED
  REVOKED
}

/// How a claim was created.
enum SchoolAffiliationSource {
  REGISTRATION
  ADMIN
  MIGRATION
  STUDENT_REQUEST
}

/// One row per claim (history and current state). The CURRENT claim of a student is the one
/// with supersededAt NULL — at most one, written only by SchoolAffiliationService under a
/// per-student lock. Teacher access requires a current VERIFIED claim for the student's school.
model StudentSchoolAffiliation {
  id              String                  @id @default(uuid())
  studentId       String
  student         User                    @relation("AffiliationStudent", fields: [studentId], references: [id], onDelete: Cascade)
  /// The canonical school; NULL while the school is not yet resolved (international, unmatched or not listed).
  schoolId        String?
  school          School?                 @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  claimedName     String?
  claimedCountry  String?
  claimedProvince String?
  claimedDistrict String?
  claimedSector   String?
  status          SchoolAffiliationStatus @default(PENDING)
  source          SchoolAffiliationSource
  createdById     String?
  createdBy       User?                   @relation("AffiliationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime                @default(now())
  decidedById     String?
  decidedBy       User?                   @relation("AffiliationDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt       DateTime?
  /// Verification note or rejection reason (a rejection reason is shown to the student).
  decisionReason  String?
  revokedById     String?
  revokedBy       User?                   @relation("AffiliationRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)
  revokedAt       DateTime?
  revokeReason    String?
  supersededAt    DateTime?
  supersededById  String?
  supersededBy    User?                   @relation("AffiliationSupersededBy", fields: [supersededById], references: [id], onDelete: SetNull)
  /// SCHOOL_CHANGE, ROLE_CHANGE or NEW_CLAIM.
  supersedeReason String?

  @@index([studentId, supersededAt])
  @@index([schoolId, status])
  @@index([status])
  @@index([createdById])
  @@index([decidedById])
  @@index([revokedById])
  @@index([supersededById])
}
