# ─────────────────────────────────────────────────────────────────────────────
# ROF LMS API — environment variables
# Copy to .env and fill in. Never commit .env.
# The app refuses to start if a required value is missing or unsafe.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development            # development | test | production
PORT=3000

# ── Database (PostgreSQL 14+) ────────────────────────────────────────────────
DATABASE_URL="postgresql://rof:rof@localhost:5432/rof?schema=public"
# Connection pool size. Use 1 only with the local `npx prisma dev` server.
DATABASE_POOL_MAX=10

# ── Auth ─────────────────────────────────────────────────────────────────────
# At least 32 random characters, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_ACCESS_TTL_SECONDS=900      # access token lifetime (15 min)
REFRESH_TOKEN_TTL_DAYS=30

# ── HTTP ─────────────────────────────────────────────────────────────────────
# Comma-separated frontend origins allowed by CORS (required in production).
# When empty, no cross-origin access is allowed.
CORS_ORIGINS=http://localhost:5173
# Public frontend URL, used for links in e-mails (password reset, notifications).
APP_URL=http://localhost:5173
# Time zone that plain dates in report and audit-log filters refer to (IANA name).
APP_TIMEZONE=Africa/Kigali
# Swagger UI is on in development; set true to expose /api/docs in production.
SWAGGER_ENABLED=false
THROTTLE_LIMIT=120              # requests per window per IP
THROTTLE_TTL_SECONDS=60
# Proxy hops in front of the API, so the real client IP is used for rate limits.
# 1 behind Caddy/Nginx (default); false when clients connect to the API directly
# (otherwise a forged X-Forwarded-For header could bypass the per-IP limits).
TRUST_PROXY=1
# Largest accepted request body (uploads), in MB. Also set the same limit in the
# reverse proxy (e.g. Nginx client_max_body_size, Caddy request_body max_size).
MAX_UPLOAD_REQUEST_MB=100

# ── File storage ─────────────────────────────────────────────────────────────
STORAGE_DRIVER=local            # local | s3  (use s3 with more than one instance)
UPLOAD_DIR=./storage            # local driver only
# S3-compatible storage (AWS S3, Cloudflare R2, MinIO …)
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=                    # leave empty for AWS; set for R2/MinIO
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false       # true for MinIO

# ── E-mail (SMTP) ────────────────────────────────────────────────────────────
# Without SMTP_HOST, e-mails are logged instead of sent (development only —
# required in production).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false               # true for port 465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="ROF Learning <noreply@example.org>"
EMAIL_BATCH_SIZE=50

# ── Background workers ───────────────────────────────────────────────────────
# E-mail outbox, deadline closing and cleanup jobs run in-process. They are safe to
# run on several instances; set false to disable them on a given instance.
WORKERS_ENABLED=true

# ── Seed (first run only) ────────────────────────────────────────────────────
# If unset, a random admin password is generated and printed once.
SEED_ADMIN_PASSWORD=
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@example.org
SEED_DEMO=false                 # demo mentors/students (refused in production)

# ── Tests ────────────────────────────────────────────────────────────────────
# A DISPOSABLE database for `npm run test:e2e` — every table is truncated.
TEST_DATABASE_URL=
