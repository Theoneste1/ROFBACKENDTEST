# ─────────────────────────────────────────────────────────────────────────────
# ROF LMS API — PRODUCTION environment template
#
# Copy to your secret store / orchestrator (never commit real values).
# Every <…> must be replaced. The API refuses to start when something
# required is missing or invalid (e.g. JWT_SECRET under 32 characters, no
# SMTP_HOST or CORS_ORIGINS in production, a malformed URL or number).
# See docs/DEPLOYMENT.md for what each part does.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=3000

# ── Database: managed PostgreSQL 14+ (TLS) ───────────────────────────────────
DATABASE_URL="postgresql://<user>:<password>@<host>:5432/<db>?schema=public&sslmode=require"
# Connections per API instance. instances × DATABASE_POOL_MAX must stay below
# the server's max_connections (leave room for migrations and admin tools).
DATABASE_POOL_MAX=10

# ── Authentication ───────────────────────────────────────────────────────────
# 48+ random characters. Changing it signs everyone out.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=<generate>
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# ── HTTP ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=https://<frontend-domain>
APP_URL=https://<frontend-domain>
APP_TIMEZONE=Africa/Kigali
# Number of reverse-proxy hops in front of the API (Caddy/Nginx/LB = 1).
TRUST_PROXY=1
# Keep equal to the proxy's request-body limit.
MAX_UPLOAD_REQUEST_MB=100
THROTTLE_LIMIT=120
THROTTLE_TTL_SECONDS=60
# Swagger UI stays off in production unless you need it (it lists every route).
SWAGGER_ENABLED=false

# ── File storage: private S3-compatible bucket ───────────────────────────────
STORAGE_DRIVER=s3
S3_BUCKET=<bucket>
S3_REGION=<region>
S3_ENDPOINT=                    # empty for AWS; https://<account>.r2.cloudflarestorage.com for R2
S3_ACCESS_KEY_ID=<key-id>
S3_SECRET_ACCESS_KEY=<secret>
S3_FORCE_PATH_STYLE=false       # true for MinIO

# ── E-mail (required in production) ──────────────────────────────────────────
SMTP_HOST=<smtp-host>
SMTP_PORT=587
SMTP_SECURE=false               # true for port 465
SMTP_USER=<user>
SMTP_PASS=<password>
EMAIL_FROM="ROF Learning <noreply@<your-domain>>"
EMAIL_BATCH_SIZE=50

# ── Background jobs ──────────────────────────────────────────────────────────
# Safe to run on every instance (they coordinate through the database).
WORKERS_ENABLED=true

# ── First deployment only (the migrate step) ─────────────────────────────────
# Initial administrator; change the password after the first login.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=<admin-email>
SEED_ADMIN_PASSWORD=<strong-initial-password>
SEED_DEMO=false                 # refused in production anyway
